<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 69.</fw>
<head type="title">ITT AZ TEREMTÉSÉRT ISTENNEK HÁLÁT ÁD</head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1">Császárok Császára,</l>
<l xml:id="l.2">S’ menynek s’ földnek Ura,</l>
<l xml:id="l.3">Nagy hatalmu Ur Isten!</l>
<l rend="level_2" xml:id="l.4">Ki dicsérhet méltán,</l>
<l xml:id="l.5">Sok javaid látván</l>
<l xml:id="l.6">Mindgyárást, a’ kezdetben,</l>
<l rend="level_2" xml:id="l.7">Mert bölcs rendelésed,</l>
<l xml:id="l.8">S’ nagy gondviselésed</l>
<l xml:id="l.9">Ismérszik teremtésben.</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10">Mint abroncs hajlása,</l>
<l xml:id="l.11">Kék égnek állása</l>
<l xml:id="l.12">Környül vött javaival,</l>
<l rend="level_2" xml:id="l.13"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Hóld és Nap jár<corr>á</corr>si,</lem><rdg wit="#W1" xml:id="rdg.1">járati</rdg><rdg wit="#W3 #W4" xml:id="rdg.2">járási</rdg><rdg wit="#W2" xml:id="rdg.3">iarasiw</rdg></app></l>
<l xml:id="l.14">Planéták forgási</l>
<l xml:id="l.15">Kerülnek<note type="critic" xml:id="note.1">körüljárnak</note> áldásival,</l>
<l rend="level_2" xml:id="l.16">Tengernek vizei,</l>
<l xml:id="l.17">Az földnek füvei,</l>
<l xml:id="l.18">Táplálnak hasznaival.</l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19">Embert szép termettel,</l>
<l xml:id="l.20">Okos értelemmel</l>
<l xml:id="l.21">Aldád Uram, s’ töd Urrá:</l>
<l rend="level_2" xml:id="l.22">Világ szép javait,</l>
<l xml:id="l.23">Es minden vadait</l>
<l xml:id="l.24"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Osztád kivánságira,</lem><rdg wit="#W1" xml:id="rdg.4">kivánságra</rdg><rdg wit="#W2" xml:id="rdg.5">kiuanszagira</rdg><rdg wit="#W3" xml:id="rdg.6">kivánságárá</rdg><rdg wit="#W4" xml:id="rdg.7">kivánságira</rdg></app></l>
<l rend="level_2" xml:id="l.25">De vakmerö volta,</l>
<l xml:id="l.26">S’ háládatlansága</l>
<l xml:id="l.27">Sok bünt ellened tura.</l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.28">Nem csak személlyeddel,</l>
<l xml:id="l.29">Földi Istenséggel</l>
<l xml:id="l.30"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">Sokat fel-magasztaltál,</lem><rdg wit="#W2" xml:id="rdg.8">Sokat magastaltal</rdg></app></l>
<l rend="level_2" xml:id="l.31">De kit nagy értekkel,</l>
<l xml:id="l.32">Eszszel, s’ bölcseséggel</l>
<l xml:id="l.33">Erdem kivül ruháztál:</l>
<l rend="level_2" xml:id="l.34">Minden kévánta jót,</l>
<l xml:id="l.35">Ahoz kenyeret, sót</l>
<l xml:id="l.36">Szükség kivül-is adtál.</l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.37">Föld temerdekségét,<note type="critic" xml:id="note.2">roppant nagyságát</note></l>
<l xml:id="l.38">Hoszszát, szélességét</l>
<l xml:id="l.39"><app xml:id="app.4"><lem wit="#KK" xml:id="lem.4">Adtad Uram emberért,</lem><rdg wit="#W2" xml:id="rdg.9">attal</rdg></app></l>
<l rend="level_2" xml:id="l.40">Rajta valo vadak,</l>
<l xml:id="l.41">S’ repülö madarak</l>
<l xml:id="l.42"><app xml:id="app.5"><lem wit="#KK" xml:id="lem.5">Vannak táplálásáért:</lem><rdg wit="#W2" xml:id="rdg.10">taplalasért</rdg></app></l>
<l rend="level_2" xml:id="l.43">Semmi ékességet,</l>
<l xml:id="l.44">S’ drága fényességet</l>
<l xml:id="l.45">Nem fundáltál hasznodért.</l>
</lg>
<lg xml:id="lg.6">
<l rend="level_2" xml:id="l.46">Nézz ember szemeddel,</l>
<l xml:id="l.47">Napfény mit fogot-el,</l>
<l xml:id="l.48"><app xml:id="app.6"><lem wit="#KK" xml:id="lem.6">Aztat mind néked adta,</lem><rdg wit="#Wβ" xml:id="rdg.11">Azt ö</rdg></app></l>
<l rend="level_2" xml:id="l.49">Csak ötet tisztellyed,</l>
<l xml:id="l.50">Szeressed és féllyed,</l>
<l xml:id="l.51">Miképpen parancsolta,</l>
<l rend="level_2" xml:id="l.52">Hogy ezer iziglen</l>
<l xml:id="l.53">Meg-áld mindenekben,</l>
<l xml:id="l.54">Azt-is hiven fogadta.</l>
</lg>
<lg xml:id="lg.7">
<l rend="level_2" xml:id="l.55">Szived keménysége,</l>
<l xml:id="l.56">S’ elméd sötétsége</l>
<l xml:id="l.57"><app xml:id="app.7"><lem wit="#KK" xml:id="lem.7">Eztet meg nem ismérte,</lem><rdg wit="#Wβ" xml:id="rdg.12">Ezt még meg</rdg></app></l>
<l rend="level_2" xml:id="l.58">Hogy már történetbül,</l>
<l xml:id="l.59">Es csak természetböl</l>
<l xml:id="l.60">Ez jokat szedte s’ vette,</l>
<l rend="level_2" xml:id="l.61">Kiért boszszusággal</l>
<l xml:id="l.62">S’ gyakran káromlással</l>
<l xml:id="l.63">Rut vétkeit nevelte.</l>
</lg>
<lg xml:id="lg.8">
<l rend="level_2" xml:id="l.64">Mennyi mulatságot,</l>
<l xml:id="l.65">Meg-annyi fájdalmot</l>
<l xml:id="l.66">Azért reád bocsátott,</l>
<l rend="level_2" xml:id="l.67">Hogy el ne hidd magad,</l>
<l xml:id="l.68">S’ gyarlóságod tudgyad,</l>
<l xml:id="l.69">Es ismérjed Uradot,</l>
<l rend="level_2" xml:id="l.70">Ki láttya szivedet,</l>
<l xml:id="l.71">Es tudgya elmédet,</l>
<l xml:id="l.72"><app xml:id="app.8"><lem wit="#KK" xml:id="lem.8">Bánnya ocsmányságidat.</lem><rdg wit="#W2" xml:id="rdg.13">ocsmansagodat</rdg></app></l>
</lg>
<lg xml:id="lg.9">
<l rend="level_2" xml:id="l.73">Dicsérd azért lelkem,</l>
<l xml:id="l.74">S’ magasztallyad nyelvem</l>
<l xml:id="l.75"><app xml:id="app.9"><lem wit="#KK" xml:id="lem.9"><corr>Illy jól tött</corr> teremtödet,</lem><rdg wit="#Wα" xml:id="rdg.14">Illyen jo</rdg><rdg wit="#W2" xml:id="rdg.15">Illy iol töt</rdg></app></l>
<l rend="level_2" xml:id="l.76">Aldgyad te-is szivem,</l>
<l xml:id="l.77">Testem, tagom, s’ izem,</l>
<l xml:id="l.78">Mindenben Istenedet,</l>
<l rend="level_2" xml:id="l.79">Mert nem felejthetem,</l>
<l xml:id="l.80">Sok jót tülle vettem,</l>
<l xml:id="l.81">Táplállya életemet.</l>
</lg>
<lg xml:id="lg.10">
<l rend="level_2" xml:id="l.82">Dicsérjétek egek,</l>
<l xml:id="l.83">S’ boldogult seregek,</l>
<l xml:id="l.84">Mindnyájan Szent Angyalok,</l>
<l rend="level_2" xml:id="l.85">Tengernek habjai,</l>
<l xml:id="l.86"><app xml:id="app.10"><lem wit="#KK" xml:id="lem.10">S’ föld külömb vadai,</lem><rdg wit="#Wβ" xml:id="rdg.16">Kis, s-nagy föld vadai</rdg></app></l>
<l xml:id="l.87"><app xml:id="app.11"><lem wit="#KK" xml:id="lem.11"><corr>És</corr> mennyei szent karok,</lem><rdg wit="#W1" xml:id="rdg.17">S’</rdg><rdg wit="#W2 #W3 #W4" xml:id="rdg.18">És</rdg></app></l>
<l rend="level_2" xml:id="l.88">Mert Istent dicsérni,</l>
<l xml:id="l.89">S’ nevét magasztalni</l>
<l xml:id="l.90">Elégséges nem vagyok.</l>
</lg>
</div>
</body>
