<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 82.</fw>
<head type="title">HOGY AZ SZABAD ZABOLA NÉLKÜL VALO NYELV MINDENEKET VISZSZA
                    MAGYARÁZ</head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1">Crokodilus mint kis gyermek</l>
<l xml:id="l.2">Sir, s’ jaj szava merö ének:</l>
<l xml:id="l.3">De notája a’ végének</l>
<l xml:id="l.4">Lészen vesztére fejednek.</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.5">Igy csácsogo nyelvnek inye,</l>
<l xml:id="l.6">Csalárd, s’ hamis szo gégéje,</l>
<l xml:id="l.7">Meg-hat álnok lehellete,</l>
<l xml:id="l.8">Mert égö tüz foga fénye.</l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.9"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">Mint az gyöngyöt erös eczet,</lem>
<rdg wit="#W2" xml:id="rdg.1">erö</rdg>
</app></l>
<l xml:id="l.10">S’ el-olvasztya tüz az érczet,</l>
<l xml:id="l.11">Igy gonosz nyelv égö tüzet</l>
<l xml:id="l.12">Okád alád s’ forró vizet.</l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.13">Olly ártalom nincs fegyverben,</l>
<l xml:id="l.14">Sem lángozo sebes tüzben,</l>
<l xml:id="l.15">Nincs olly méreg szelenczében,</l>
<l xml:id="l.16">Mint az fondor gonosz nyelvben.</l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.17">Hol nem véled, ott kissebbit,</l>
<l xml:id="l.18">A’ hol nem félsz, ott sebessit,</l>
<l xml:id="l.19">Jo hiredben homályosit,</l>
<l xml:id="l.20">S’ gyalázattal sirban taszit.</l>
</lg>
<lg xml:id="lg.6">
<l rend="level_2" xml:id="l.21">Légy termetes<note type="critic" xml:id="note.1">szép; Absolom vagy Ábsálom
                            Dávid fia volt</note> mint Absolon,</l>
<l xml:id="l.22">Serény vitéz, mint a’ Sámson,</l>
<l xml:id="l.23">Okos és bölcs, mint Salamon,</l>
<l xml:id="l.24">Szó fér hozzád még-is nagyon.</l>
</lg>
<lg xml:id="lg.7">
<l rend="level_2" xml:id="l.25">Mert ha szollasz csácsogonak,</l>
<l xml:id="l.26">S’ halgatásrul tart bolondnak,</l>
<l xml:id="l.27">Eteledröl tobzodonak,</l>
<l xml:id="l.28">Es böjtödröl mond ravasznak.</l>
</lg>
<lg xml:id="lg.8">
<l rend="level_2" xml:id="l.29">Ahitatos hogy ha lészesz,</l>
<l xml:id="l.30">Képmutato nevet szerzesz:</l>
<l xml:id="l.31">Ha pediglen elmés lészesz,</l>
<l xml:id="l.32">Bolond nevet ottan vészesz.</l>
</lg>
<lg xml:id="lg.9">
<l rend="level_2" xml:id="l.33">Szép köntösrül mond kevélynek,</l>
<l xml:id="l.34">Es rongyosrul tart fösvénynek;</l>
<l xml:id="l.35"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Honn ülésrül itil restnek,</lem>
<rdg wit="#W2" xml:id="rdg.2">Othon</rdg>
</app></l>
<l xml:id="l.36">Kin járásrul néz fesletnek.</l>
</lg>
<lg xml:id="lg.10">
<l rend="level_2" xml:id="l.37">Hogy ha mit adcz szegényeknek,</l>
<l xml:id="l.38">Nem tart azért bö kezünek:</l>
<l xml:id="l.39">Mond dicsiret keresönek;</l>
<l xml:id="l.40">S’ kép mutato esztelennek.</l>
</lg>
<lg xml:id="lg.11">
<l rend="level_2" xml:id="l.41">Ha marhádot ki nem osztod,</l>
<l xml:id="l.42">S’ haszontalan nem tékozlod,</l>
<l xml:id="l.43">Azt kiáltya fösvény markod,</l>
<l xml:id="l.44">S’ telhetetlen szoros sákod.<note type="critic" xml:id="note.2">olv. zsákod</note></l>
</lg>
<lg xml:id="lg.12">
<l rend="level_2" xml:id="l.45">Oh átkozott kicsiny falat,</l>
<l xml:id="l.46">Látom nem pöksz te csak nyálat:</l>
<l xml:id="l.47">Mert madárbul formálsz halat,</l>
<l xml:id="l.48">Es gyékényböl róka málat.<note type="critic" xml:id="note.3">rókabőrt</note></l>
</lg>
<lg xml:id="lg.13">
<l rend="level_2" xml:id="l.49">Nincs semmi csont te tagodban,</l>
<l xml:id="l.50">Rakonczád<note type="critic" xml:id="note.4">gátad, korlátod</note> sincs fogaidban,</l>
<l xml:id="l.51">Sik golyobis forog szádban,</l>
<l xml:id="l.52">Mérged mézzel jár egy nyomban.</l>
</lg>
<lg xml:id="lg.14">
<l rend="level_2" xml:id="l.53">Noha gyakran maga magát</l>
<l xml:id="l.54">A’ nyelv veszti szegi nyakát,</l>
<l xml:id="l.55">Mint az haris fészkét, s’ házát</l>
<l xml:id="l.56">El-árullya fiát, s’ magát.</l>
</lg>
<lg xml:id="lg.15">
<l rend="level_2" xml:id="l.57">Hol lehetne ö békével?</l>
<l xml:id="l.58"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">Addig csácsog <corr>részeg ésszel</corr>,</lem>
<rdg wit="#Wα" xml:id="rdg.3">rezegéssel</rdg>
<rdg wit="#W2" xml:id="rdg.4">rézeg éssel</rdg>
</app></l>
<l xml:id="l.59">Olykor fogják meg csak kézzel,</l>
<l xml:id="l.60">S’ meg-mellyesztik<note type="critic" xml:id="note.5">megkoppasztják</note> forro vizzel.</l>
</lg>
<lg xml:id="lg.16">
<l rend="level_2" xml:id="l.61">Azért nyelved zabolában</l>
<l xml:id="l.62"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4">Tarcsad aczél <corr>kapocsánban</corr><note type="critic" xml:id="note.6">= féken</note>,</lem>
<rdg wit="#W1" xml:id="rdg.5">varacskában</rdg>
<rdg wit="#W2" xml:id="rdg.6">kapoczanban</rdg>
<rdg wit="#W3" xml:id="rdg.7">kaponczában</rdg>
<rdg wit="#W4" xml:id="rdg.8">kapoczában</rdg>
</app></l>
<l xml:id="l.63">Ne nyargallyon szabadgyában,</l>
<l xml:id="l.64">Hogy ne hozzon gyalázatban.</l>
</lg>
</div>
</body>
</text>
