<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 103.</fw>
<head type="title">HARMADIK</head>
<lg xml:id="lg.1">
<l xml:id="l.1">Tudom, nem eörülleöd, seött oyod .s. kerülleöd,</l>
<l rend="level_5" xml:id="l.2">Uram, veszedelmemett,</l>
<l rend="level_2" xml:id="l.3">Nemis ugy teremted, hogy pokolra vetned</l>
<l rend="level_5" xml:id="l.4">Karhozattra lelkemett,</l>
<l rend="level_2" xml:id="l.5">Az eletem targya,<note type="critic" xml:id="note.1">életem célja</note> hogy
                        nevedett algya,</l>
<l rend="level_5" xml:id="l.6">.S. adgyad üdveössegemett.</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.7">Hogy megh szabaditnal, .s. azzal utatt nytnal</l>
<l rend="level_5" xml:id="l.8">Lelkem boldoghsagara,</l>
<l rend="level_2" xml:id="l.9">Fiadatt külded el, hogy eö valalna fel</l>
<l rend="level_5" xml:id="l.10"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">Büneöm terhett magara,</lem>
<rdg wit="#W1" xml:id="rdg.1">b<del>eö</del><add type="corr">ü</add>neöm</rdg>
</app></l>
<l rend="level_2" xml:id="l.11">Hogy en lelkem elne, .s. tegedett diczirne,</l>
<l rend="level_5" xml:id="l.12">Eötett adad halalra.</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.13">Áll minden kezedben, kegyelmessegedben</l>
<l rend="level_5" xml:id="l.14">Ninczen hatarozott czéll,</l>
<l rend="level_2" xml:id="l.15">Bün fergetegeben, mintt hajos szelveszben</l>
<l rend="level_5" xml:id="l.16">Habzo lelkem noha féll,</l>
<l rend="level_2" xml:id="l.17">Bizik mind az altal, hogy jrgalmad altal</l>
<l rend="level_5" xml:id="l.18">Nyugodalmas parttra kéll.</l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.19">En erdemem pusztta, az bünnek megh foszta</l>
<l rend="level_5" xml:id="l.20">Pokolra vono keörme,</l>
<l rend="level_2" xml:id="l.21">Múltt artatlansagom, sovany jffiusagom</l>
<l rend="level_5" xml:id="l.22">Lelkem fojtto gasztt terme,</l>
<l rend="level_2" xml:id="l.23"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Kinek hinari keöztt majd hal<corr>al</corr>ra rekeösztt</lem><rdg wit="#W1" xml:id="rdg.2">Halra</rdg></app></l>
<l rend="level_5" xml:id="l.24">Az eördeögh titkos verme.</l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.25">Vagyok hatalmodban, .s. tartatik markodban</l>
<l rend="level_5" xml:id="l.26">Eletemnek sinora,</l>
<l rend="level_2" xml:id="l.27">Ha el teveljettem .s. roszra vetemedttem,</l>
<l rend="level_5" xml:id="l.28">Teritcz, Jstenem, jora,</l>
<l rend="level_2" xml:id="l.29">Mutasd kegyelmedett, ne gerjesd tüzedett</l>
<l rend="level_5" xml:id="l.30">Ream, hitvan korora.</l>
</lg>
<lg xml:id="lg.6">
<l xml:id="l.31">Megh czelekedheted, ream eresztheted</l>
<l rend="level_5" xml:id="l.32">Büntetesed palczajatt,</l>
<l rend="level_2" xml:id="l.33">Az mintt teremptetted, ugy elis vesztheted</l>
<l rend="level_5" xml:id="l.34">Kezeidnek munkajatt,</l>
<l rend="level_2" xml:id="l.35">Erdemesis arra, hogy vessed pokolra</l>
<l rend="level_5" xml:id="l.36">Eletem ferges fajatt.</l>
</lg>
<lg xml:id="lg.7">
<l xml:id="l.37">De az en vetkemett .s. gyarlo esetemett</l>
<l rend="level_5" xml:id="l.38">Jrgalmad felül mullja,</l>
<l rend="level_2" xml:id="l.39"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">Attyai kedvedbül ne band ha keönnjebbül</lem><rdg wit="#W1" xml:id="rdg.3">ha <del>kedvedbül</del> keönnjebbül</rdg></app></l>
<l rend="level_5" xml:id="l.40">Büneös fiadnak sullja,</l>
<l rend="level_2" xml:id="l.41">Legj jnkab oltalma, az eördeögh hatalma</l>
<l rend="level_5" xml:id="l.42">Lelkemett fel ne dullja.</l>
</lg>
<lg xml:id="lg.8">
<l xml:id="l.43">Jrgalmaz, jrgalmaz, migh el nem hatalmaz</l>
<l rend="level_5" xml:id="l.44">Raittam az halal merge,</l>
<l rend="level_2" xml:id="l.45">Mongy jo hirtt fülemnek, had szünnyeön lelkemnek</l>
<l rend="level_5" xml:id="l.46">Szüntelen kenzo ferge,</l>
<l rend="level_2" xml:id="l.47">Adgy bünbeöl ki terestt, vegyen üdveözüllest</l>
<l rend="level_5" xml:id="l.48">Altalad eltem veghe.</l>
</lg>
</div>
