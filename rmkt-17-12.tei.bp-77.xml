<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 77.</fw>
<head type="title">MÁS UGYAN AZON SZERENCSÉNEK ÁLHATATLANSÁGÁRÚL</head>
<lg xml:id="lg.1">
<l xml:id="l.1">Mikor a’ Szerencse fel-emel valakit,</l>
<l xml:id="l.2">Tornyok vitorlyáján helyhezteti székit,</l>
<l xml:id="l.3">Ideig kedvére meg-ereszti fékit,</l>
<l xml:id="l.4">Sokáig egy heljben ülni nem hágy senkit.</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.5"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">Gyakran kevélységgel, vakit a’ Szerencse,</lem>
<rdg wit="#W2" xml:id="rdg.1">valakit</rdg>
</app></l>
<l xml:id="l.6"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Hogy a’ maga hittet hamaráb meg-ejtse,</lem>
<rdg wit="#W2" xml:id="rdg.2">maga <sic>hétsét</sic></rdg>
</app></l>
<l xml:id="l.7"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">Nem tudgyák rabsággal orczázott hogy kincse,</lem>
<rdg wit="#W2" xml:id="rdg.3">hogy rabsaggal orcsazot kincse</rdg>
</app></l>
<l xml:id="l.8">Be-buritva fekszik, alatta bilincse.</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.9">Irigy, csalárd, s’ hamis adományát bánnya,</l>
<l xml:id="l.10">Ha mit adott viszont azt visza kivánnya,</l>
<l xml:id="l.11"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4">Kelepczés hálóját mind addiglan hánnya,</lem>
<rdg wit="#W2" xml:id="rdg.4">kelepcsét</rdg>
</app></l>
<l xml:id="l.12">A’ gyéként alóllad miglen el nem vonnya.</l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.13">Ha magassan ültet, onnét ö le forgat,</l>
<l xml:id="l.14">Nagy kissebségedre pad-alat nyomorgat,</l>
<l xml:id="l.15"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5">Mint Belisáriust immár nem apolgat,<note type="critic" xml:id="note.1">Belisarius jeles hadvezér volt a VI. században; vak koldusként
                                    fejezte be életét, miután Iustinianus császár
                                    megvakíttatta.</note></lem>
<rdg wit="#W3" xml:id="rdg.5">tapogat</rdg>
<rdg wit="#W4" xml:id="rdg.6">ápolgat</rdg>
</app></l>
<l xml:id="l.16">De mostoha kézzel sujtol, és szorongat.</l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.17">Nyomorúságidon nem szokot jajgatni,</l>
<l xml:id="l.18">De gyalázatodon igen túd kaczagni,</l>
<l xml:id="l.19">Üres tarsolyodon nem fog irigykedni,</l>
<l xml:id="l.20">Csak rakott szekrényed ohajtya praedálni.</l>
</lg>
<lg xml:id="lg.6">
<l xml:id="l.21">Szerencse kerekin azért okossan üly,</l>
<l xml:id="l.22">Tündér változásán hogy meg ne szégyenüly,</l>
<l xml:id="l.23">Mikor rád mosolyog, mások kárán tanuly,</l>
<l xml:id="l.24">Biztatása után vak merön ne indúlj.</l>
</lg>
<lg xml:id="lg.7">
<l xml:id="l.25">A’ kristály üveg-is mikor szeb s’ tündöklik,</l>
<l xml:id="l.26">Akkor ö leg gyengéb s’ hamaráb el-romlik,</l>
<l xml:id="l.27">Súgárival a’ Nap ha igen süt s’ fénlik,</l>
<l xml:id="l.28">Kö essö,<note type="critic" xml:id="note.2">jégesés</note> vagy Zápor olykor ritkán
                        mulik.</l>
</lg>
<lg xml:id="lg.8">
<l xml:id="l.29">A’ kinek a’ kása meg égeti száját,</l>
<l xml:id="l.30">Mászszor nem felejti fujni a’ tarloját,<note type="critic" xml:id="note.3">aludt
                        tejét</note></l>
<l xml:id="l.31">Igy a’ ki próbálta szerencse háloját,</l>
<l xml:id="l.32">Az után süvölti bé buritot horgát.</l>
</lg>
</div>
