<text>
<body>
<head type="volumeTitle">MAGYAR RITHMUSOK AVAGY VERSEK, MELLYEKET IRT NEMZETES BENYECZKI PETER
            SZENTELT VITÉZ. ELSÖ RÉSZE SZÉP ISTENI DICSÉRETEKET, ÉS POENITENTIA TARTÁSRA
            INDITO ÉNEKEKET FOGLAL MAGÁBAN. MÁSODIK KÖZÖNSÉGES MAGYAR PÉLDA
            BESZÉDEKET SZÉP OKTATÁSSAL</head>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 62.</fw>
<head type="title">REGGELI ÉNEK</head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1">Minden nap vig kedvel</l>
<l xml:id="l.2">Ep s’ jó egésséggel,</l>
<l xml:id="l.3">Hogy álmombol serkentesz,</l>
<l rend="level_2" xml:id="l.4">(Légy áldott Istenem)</l>
<l xml:id="l.5"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">(Nem néz<corr>e</corr>d érdemem,)</lem><rdg wit="#W1" xml:id="rdg.1">nézéd</rdg><rdg wit="#W2 #W4" xml:id="rdg.2">nézed</rdg></app></l>
<l xml:id="l.6">S’ ennyi jokkal éllesztesz,</l>
<l rend="level_2" xml:id="l.7">Nem hivalkodásra,</l>
<l xml:id="l.8">De hálá-adásra</l>
<l xml:id="l.9">Oránként-is segitesz.</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10">Továbra-is segits,</l>
<l xml:id="l.11">S’ kegyelmeddel épits,</l>
<l xml:id="l.12">Hogy az én hivatalom,</l>
<l rend="level_2" xml:id="l.13"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Szent kezedböl jüjjön,</lem><rdg wit="#W3 #W4" xml:id="rdg.3">Hozzád figyelmezzen</rdg></app></l>
<l xml:id="l.14">S’ üdvességes légyen,</l>
<l xml:id="l.15">Es csak néked szolgállyon,</l>
<l rend="level_2" xml:id="l.16">Minden gondolatom</l>
<l xml:id="l.17">Gazdag, szegény voltom,</l>
<l xml:id="l.18">Tégedet magasztallyon.</l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19">Gerjezd-fel szivemet,</l>
<l xml:id="l.20">Sirassam bünömet,</l>
<l xml:id="l.21">Adgy vizet szemeimnek,</l>
<l rend="level_2" xml:id="l.22">Ne örvendgyek máson,</l>
<l xml:id="l.23">Hanem szivel azon,</l>
<l xml:id="l.24">Az mi tetszik kedvednek,</l>
<l rend="level_2" xml:id="l.25">Eletem jobbullyon,</l>
<l xml:id="l.26">S’ téged szivböl áldgyon,</l>
<l xml:id="l.27">Hadd éllyek felségednek.</l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.28">Adgy vigyázo szivet,</l>
<l xml:id="l.29">Aitatos lelket,</l>
<l xml:id="l.30">Ne legyek hivalkodó,</l>
<l rend="level_2" xml:id="l.31">Nevedért szenvedést</l>
<l xml:id="l.32"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">El-türjek, s-üldözést,</lem><rdg wit="#W2" xml:id="rdg.4">el teried üldözést</rdg></app></l>
<l xml:id="l.33">Ne légyek káromkodo,</l>
<l rend="level_2" xml:id="l.34"><app xml:id="app.4"><lem wit="#KK" xml:id="lem.4">Légyek engedelmes,</lem><rdg wit="#W2" xml:id="rdg.5">Szelid s bikessiges</rdg></app></l>
<l xml:id="l.35"><app xml:id="app.5"><lem wit="#KK" xml:id="lem.5">Szeléd s’ békeséges,</lem><rdg wit="#W2" xml:id="rdg.6">Legyek engedelmes</rdg></app></l>
<l xml:id="l.36">Ne legyek zugolodo.</l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.37">Tégy alázatossá,</l>
<l xml:id="l.38">S’ minden jora gyorsá,</l>
<l xml:id="l.39">Minden fáradság nélkül,</l>
<l rend="level_2" xml:id="l.40">Reménlyek te benned,</l>
<l xml:id="l.41">S’ rettegjek elötted</l>
<l xml:id="l.42">Kétségben esés kivül,</l>
<l rend="level_2" xml:id="l.43">Légyek hálá-adó,</l>
<l xml:id="l.44">Es abban állando,</l>
<l xml:id="l.45">S’ nem változo ok-nélkül.</l>
</lg>
<lg xml:id="lg.6">
<l rend="level_2" xml:id="l.46">Legyek szorgalmatos,</l>
<l xml:id="l.47">Ahoz ollyan okos,</l>
<l xml:id="l.48">Csak téged keresselek,</l>
<l rend="level_2" xml:id="l.49">Elötted igazult,</l>
<l xml:id="l.50">Es olly jol meg-tanult</l>
<l xml:id="l.51">Hogy téged szeresselek,</l>
<l rend="level_2" xml:id="l.52">Ne legyek tobzodó,</l>
<l xml:id="l.53">Másén ragadozó,</l>
<l xml:id="l.54">Hanem téged féllyelek.</l>
</lg>
<lg xml:id="lg.7">
<l rend="level_2" xml:id="l.55">Senki te kivülled,</l>
<l xml:id="l.56">Avagy te ellened</l>
<l xml:id="l.57">Ne legyen bizodalmom,</l>
<l rend="level_2" xml:id="l.58">Kevélység ne birjon,</l>
<l xml:id="l.59">Ösvényeden járjon</l>
<l xml:id="l.60">Lépésem s’ minden nyomom,</l>
<l rend="level_2" xml:id="l.61">Adgy ollyan értelmet,</l>
<l xml:id="l.62">Ismérjen tégedet,</l>
<l xml:id="l.63">Es add meg boldogságom.</l>
</lg>
<lg xml:id="lg.8">
<l rend="level_2" xml:id="l.64">Aldgy-meg egésséggel,</l>
<l xml:id="l.65">Es annyi értekkel,</l>
<l xml:id="l.66">Melly lelkem ne veszesse,</l>
<l rend="level_2" xml:id="l.67">De te szegényidnek,</l>
<l xml:id="l.68">S’ a’ szükölködöknek</l>
<l xml:id="l.69"><app xml:id="app.6"><lem wit="#KK" xml:id="lem.6">Elé<corr>ge</corr>ndö élése,</lem><rdg wit="#W1" xml:id="rdg.7">Elégedendö</rdg><rdg wit="#W2" xml:id="rdg.8">ellegendeö</rdg><rdg wit="#W3" xml:id="rdg.9">Elegendö</rdg><rdg wit="#W4" xml:id="rdg.10">Elégendö</rdg></app></l>
<l rend="level_2" xml:id="l.70">Az én hajlékombol,</l>
<l xml:id="l.71">Es ajándékidbol</l>
<l xml:id="l.72">Ne légyen éhezése;</l>
</lg>
<lg xml:id="lg.9">
<l rend="level_2" xml:id="l.73">Fösvénység el-hadgyon,</l>
<l xml:id="l.74">De szivem buzdullyon</l>
<l xml:id="l.75">S’ tegye akaratodat,</l>
<l rend="level_2" xml:id="l.76">Barátomnak kárán,</l>
<l xml:id="l.77">Sebén s’ jajgatásán</l>
<l xml:id="l.78">Kövessem hagyásodat,</l>
<l rend="level_2" xml:id="l.79">Samaritánussal</l>
<l xml:id="l.80">S’ nem a’ Lévitával<note type="critic" xml:id="note.1">Az irgalmas szamaritánusról és a
                            levitáról szóló példabeszédet lásd <bibl>Luk. 10,
                        30–37.</bibl></note></l>
<l xml:id="l.81">Kössem rá olajodat.</l>
</lg>
<lg xml:id="lg.10">
<l rend="level_2" xml:id="l.82">Ez egynéhány versel,</l>
<l xml:id="l.83">Sovány könyörgéssel</l>
<l xml:id="l.84">Szent nevedet tisztelném,</l>
<l rend="level_2" xml:id="l.85">Illy gyarlo férgecske,</l>
<l xml:id="l.86"><app xml:id="app.7"><lem wit="#KK" xml:id="lem.7">S’ hideg vette <corr>légyke</corr>,</lem><rdg wit="#Wα" xml:id="rdg.11">vett legyecske</rdg><rdg wit="#W2" xml:id="rdg.12">vette legyke</rdg></app></l>
<l xml:id="l.87"><app xml:id="app.8"><lem wit="#KK" xml:id="lem.8">Felségedet keresném,</lem><rdg wit="#W2" xml:id="rdg.13">keressen</rdg></app></l>
<l rend="level_2" xml:id="l.88">De nincs eröm arra,</l>
<l xml:id="l.89">Juthassak illy jokra</l>
<l xml:id="l.90">S’ magamtul el-érhetném.</l>
</lg>
</div>
</body>
</text>
