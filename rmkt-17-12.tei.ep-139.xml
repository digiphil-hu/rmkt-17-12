<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 139.</fw>
<head type="title">PALAS s-ESTER KEDVES TÁNCZA</head>
<fw corresp="Esterházy Pál" type="lg">179.</fw>
<lg xml:id="lg.1">
<l xml:id="l.1">Fényes Palotákban ékes köfalokban</l>
<l rend="level_2" xml:id="l.2">Vigagyunk</l>
<l rend="level_2" xml:id="l.3">Vetet asztalhoz iárullyunk</l>
<l rend="level_2" xml:id="l.4">Malosa borokat igyunk.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">180.</fw>
<lg xml:id="lg.2">
<l xml:id="l.5">Az Soprony bortis ha elöl hozzákis</l>
<l rend="level_2" xml:id="l.6">Nem bánom</l>
<l rend="level_2" xml:id="l.7">Io keduel asztis megh iszom</l>
<l rend="level_2" xml:id="l.8">Barátimatis iol tartom.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">181.</fw>
<lg xml:id="lg.3">
<l xml:id="l.9">Hozzanak io étket, de nem turos étket</l>
<l rend="level_2" xml:id="l.10">Házunkban</l>
<l rend="level_2" xml:id="l.11">Légyen részünk az sült ludban,</l>
<l xml:id="l.12">Auagy kouér Poka Husban.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">182.</fw>
<lg xml:id="lg.4">
<l xml:id="l.13">Bosporos<note type="critic" xml:id="note.1">= borsporos. (<persName>Jankovics J.<idno corresp="Jankovics József"/></persName>)</note> kappanis, sütt Malacz nyársbanis,</l>
<l rend="level_2" xml:id="l.14">Io lészen</l>
<l rend="level_2" xml:id="l.15">Maid szakaczom lepént uészen</l>
<l rend="level_2" xml:id="l.16">Vaias béles légyen készen.</l>
</lg>
<p xml:id="p.1">AZ VGROIA:</p>
<fw corresp="Esterházy Pál" type="lg">183.</fw>
<lg xml:id="lg.5">
<l xml:id="l.17">Kellyünk föl asztaltol, ha iol laktunk bortol,</l>
<l rend="level_2" xml:id="l.18">S-tánczollyunk</l>
<l rend="level_2" xml:id="l.19">Szollyon Hegedü, setállyunk,</l>
<l rend="level_2" xml:id="l.20">Dudásis bögiön mulassunk.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">184.</fw>
<lg xml:id="lg.6">
<l xml:id="l.21">Gyer iáriunk egy tánczot, ki ne lásson ganczot</l>
<l rend="level_2" xml:id="l.22">Lassaczkán,</l>
<l rend="level_2" xml:id="l.23">Vgorgiunk bizuást uigaczkán</l>
<l rend="level_2" xml:id="l.24">Labunkat rakiuk czifráczkán.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">185.</fw>
<lg xml:id="lg.7">
<l xml:id="l.25">Az polepsit<note type="critic" xml:id="note.2">polepsi – <persName>Esterházy</persName> nótalistáján is szerepel.
                                <persName>Rákóczi Erzsébet<idno type="ITIdata">Q48194</idno></persName> írja <persName>Esterházynak</persName>:
                            „…ha az polepsin ot nem lehetnék, kérem értemis járjon egy táncot,
                            magamis ugyan örömest eljárnám…” (<bibl>OLP 125, 39.3631.</bibl>)</note> uonnyák mert
                        az Vrak hagyák</l>
<l rend="level_2" xml:id="l.26">Rendessen</l>
<l rend="level_2" xml:id="l.27">Hogy aszt iárhassák keduessen</l>
<l rend="level_2" xml:id="l.28">Nézzékis egymást édessen.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">186.</fw>
<lg xml:id="lg.8">
<l xml:id="l.29">Fordiczd már az tánczot, s-uony szép oláh tánczot</l>
<l rend="level_2" xml:id="l.30">Ekessen</l>
<l rend="level_2" xml:id="l.31">Had iáriuk esztis elméssen</l>
<l rend="level_2" xml:id="l.32">Sött igen köllemetessen.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">187.</fw>
<lg xml:id="lg.9">
<l xml:id="l.33">Magyar tánczot uonhacz te Dudásis fuihacz</l>
<l rend="level_2" xml:id="l.34">Immáron</l>
<l rend="level_2" xml:id="l.35">Az közrendis had tánczollyon,</l>
<l rend="level_2" xml:id="l.36">Innét senki ne oszollyon.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">188.</fw>
<lg xml:id="lg.10">
<l xml:id="l.37">Kobzos ide iáruly engem el ne áruly</l>
<l rend="level_2" xml:id="l.38">s-Musikály,</l>
<l rend="level_2" xml:id="l.39">Pöngesd huriaidat, s-itt álly</l>
<l rend="level_2" xml:id="l.40">Lássad senkit megh ne trefály.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">189.</fw>
<lg xml:id="lg.11">
<l xml:id="l.41">Trombita Dob szollyon uigasság had follyon</l>
<l rend="level_2" xml:id="l.42">Ez házban</l>
<l rend="level_2" xml:id="l.43">Légyen minden uigasságban</l>
<l rend="level_2" xml:id="l.44">Senki nem lesz szomiuságban.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">190.</fw>
<lg xml:id="lg.12">
<l xml:id="l.45">Hagyák el az notát uerie Lantos lantyát</l>
<l rend="level_2" xml:id="l.46">Had hallyuk,</l>
<l rend="level_2" xml:id="l.47">Füleinket uigasztallyuk</l>
<l rend="level_2" xml:id="l.48">Mesterségét magasztallyuk.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">191.</fw>
<lg xml:id="lg.13">
<l xml:id="l.49">Énekes ier elöl, ne meny székem mellöl,</l>
<l rend="level_2" xml:id="l.50">S-mongy notát</l>
<l rend="level_2" xml:id="l.51">Hozd elöl Nymphák miuoltát</l>
<l rend="level_2" xml:id="l.52">Szép Diana Vadászattyát.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">192.</fw>
<lg xml:id="lg.14">
<l xml:id="l.53">Megh köll immár szünni (mert le köll fekünni)</l>
<l rend="level_2" xml:id="l.54">Musikának</l>
<l rend="level_2" xml:id="l.55">Vegye ki ki szállásának</l>
<l rend="level_2" xml:id="l.56">Uttyát elöl, s-io ágyának.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">193.</fw>
<lg xml:id="lg.15">
<l xml:id="l.57">Oczák el az gyertyát, Cupido ö lantyát</l>
<l rend="level_2" xml:id="l.58">Had uerie</l>
<l rend="level_2" xml:id="l.59">Ember sziuét hogy neuellye</l>
<l rend="level_2" xml:id="l.60">Örömétis föl emellye.</l>
</lg>
</div>
</body>
