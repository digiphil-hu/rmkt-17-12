<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 68.</fw>
<head type="title">BÜNEIT ISMÉRVÉN ISTENNEK KEGYELMÉÉRT KÖNYÖRÖG</head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1">Rettegtet sok vétkem,</l>
<l xml:id="l.2">Kit ellened tettem,</l>
<l xml:id="l.3">Egek fölséges Ura!</l>
<l rend="level_2" xml:id="l.4">Nincs épség testemben,</l>
<l xml:id="l.5">S’ bodultam elmémben;</l>
<l xml:id="l.6">Jutottam szorgos búra,</l>
<l rend="level_2" xml:id="l.7">Ha nem segit Karod,</l>
<l xml:id="l.8">S’ nagy irgalmasságod,</l>
<l xml:id="l.9">Félö esem poklokra.</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10">Mária Magdolnát,</l>
<l xml:id="l.11"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">Csak nem bünnek annyát</lem>
<rdg wit="#Wβ" xml:id="rdg.1">bün posvánnyát</rdg>
</app></l>
<l xml:id="l.12">Meg-halattam vétkekkel,</l>
<l rend="level_2" xml:id="l.13">Az kegyetlen Saulust,<note type="critic" xml:id="note.1">Sault, aki megtérése
                            előtt üldözte Krisztus tanítványait. Vö. Ap. csel. 8, 3. és 9,
                            1–8.</note></l>
<l xml:id="l.14">S’ álnok Phariseust<note type="critic" xml:id="note.2">A Farizeusról vö. Luk. 18, 10–14. és
                            Máté 3, 7.</note></l>
<l xml:id="l.15">Mert el-értem bünökkel,</l>
<l rend="level_2" xml:id="l.16">Az Dágon papjait,</l>
<l xml:id="l.17">Cajafás<note type="critic" xml:id="note.3">Kaifás a zsidók főpapja volt; de nem az ő, hanem
                            Annás szolgája ütötte arcul Jézust. Vö. Ján. 18, 22.</note> szolgait</l>
<l xml:id="l.18">Káromlo beszédekkel.</l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19">Illy undok vétkekkel</l>
<l xml:id="l.20">Az eget szememmel</l>
<l xml:id="l.21">Miként merjem már nézni,</l>
<l rend="level_2" xml:id="l.22">Mert hold és nap fénye,</l>
<l xml:id="l.23">Csillagok szép szine</l>
<l xml:id="l.24">Engem fognak vádolni,</l>
<l rend="level_2" xml:id="l.25">Hajlékom falai,</l>
<l xml:id="l.26">S’ föld testem ruhái</l>
<l xml:id="l.27">Kezdenek kárhoztatni.</l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.28">Az négy Elementom,</l>
<l xml:id="l.29">Kiböl épült tagom,</l>
<l xml:id="l.30">Ellenem kiált nagyon,</l>
<l rend="level_2" xml:id="l.31">Mert érzékenségem,</l>
<l xml:id="l.32">Zabla nélkül nyelvem</l>
<l xml:id="l.33">Járt gyakrabban szabadon,</l>
<l rend="level_2" xml:id="l.34">Kiért félek igen,</l>
<l xml:id="l.35">Meg-esem a’ jégen,</l>
<l xml:id="l.36">S’ el ne veszszek a’ vámon.</l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.37">Kérlek azért segéts,</l>
<l xml:id="l.38">S’ büneimböl térits,</l>
<l xml:id="l.39">Egek felséges Ura,</l>
<l rend="level_2" xml:id="l.40">Lelkem soványságát</l>
<l xml:id="l.41">Elleszd szomjuságát,</l>
<l xml:id="l.42">Vezesd éllesztö kútra,</l>
<l rend="level_2" xml:id="l.43">Hogy semmi késértet,</l>
<l xml:id="l.44">Melly ellenem jühet,</l>
<l xml:id="l.45">Ne juttasson töb búra.</l>
</lg>
<lg xml:id="lg.6">
<l rend="level_2" xml:id="l.46">Irgalmad ne mullyon,</l>
<l xml:id="l.47">Veszély ne talállyon</l>
<l xml:id="l.48">Engem rusnya nyüvedet,<note type="critic" xml:id="note.4">undok férgedet</note></l>
<l rend="level_2" xml:id="l.49">Ki fogja meg-karod,</l>
<l xml:id="l.50">Ha az akaratod,</l>
<l xml:id="l.51">Hogy fel-vedd szegénedet,</l>
<l rend="level_2" xml:id="l.52">El-veszett juhodra,</l>
<l xml:id="l.53">Szarándok szolgádra</l>
<l xml:id="l.54">Mostan nyujts-ki kezedet.</l>
</lg>
<lg xml:id="lg.7">
<l rend="level_2" xml:id="l.55">Ne veszesd férgedet,</l>
<l xml:id="l.56">S’ romlott cserepedet,</l>
<l xml:id="l.57">Melly esedez te néked,</l>
<l rend="level_2" xml:id="l.58">Ha nem vétett volna,</l>
<l xml:id="l.59"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Most miért ohajtna</lem>
<rdg wit="#W2" xml:id="rdg.2">ohaytana</rdg>
</app></l>
<l xml:id="l.60">Kesergéssel elötted,</l>
<l rend="level_2" xml:id="l.61">Te-is mit engednél,</l>
<l xml:id="l.62"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">Ha bünben nem lelnél,</lem>
<rdg wit="#W2" xml:id="rdg.3">lennil</rdg>
</app></l>
<l xml:id="l.63">S’ nem vétenék ellened.</l>
</lg>
<lg xml:id="lg.8">
<l rend="level_2" xml:id="l.64">Ha kegyelmedben vész,</l>
<l xml:id="l.65">Örökké áldott lész,</l>
<l xml:id="l.66">Térnek hozzád Pogányok,</l>
<l rend="level_2" xml:id="l.67">Látván hatalmad nagy,</l>
<l xml:id="l.68">Ahoz irgalmas vagy,</l>
<l xml:id="l.69">Dicsér mindenek szájok;</l>
<l rend="level_2" xml:id="l.70"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4">Eltem s’ holtom végét,</lem>
<rdg wit="#Wβ" xml:id="rdg.4">Minden perczentését</rdg>
</app></l>
<l xml:id="l.71"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5">S’ bünös lelkem rögjét</lem>
<rdg wit="#Wβ" xml:id="rdg.5">Eletemnek, s-végét</rdg>
</app></l>
<l xml:id="l.72">Vezessék szent Angyalok.</l>
</lg>
<lg xml:id="lg.9">
<l rend="level_2" xml:id="l.73">Büneimröl vallást</l>
<l xml:id="l.74">Tévén, s’ vigasztalást</l>
<l xml:id="l.75">Várván csak Istenemtöl,</l>
<l rend="level_2" xml:id="l.76">Kérvén meg halgasson,</l>
<l xml:id="l.77"><app xml:id="app.6">
<lem wit="#KK" xml:id="lem.6">Sebemböl gyogyitson,</lem>
<rdg wit="#W2" xml:id="rdg.6">meg giogiczon</rdg>
</app></l>
<l xml:id="l.78">Mert sebhettem bünömtöl,</l>
<l rend="level_2" xml:id="l.79">Az Dudvág<note type="critic" xml:id="note.5">A Duna bal oldali mellékfolyója,
                            a Vággal párhuzamosan vonul, az <placeName>érsekújvári<idno type="ITIdata">Q16602</idno></placeName> Kisdunába ömlik. Ezen a
                            tájon feküdt <placeName>Lóc<idno type="ITIdata">Q12444</idno></placeName>, <persName>Beniczky<idno corresp="Beniczky Péter" type="ITIdata">Q41111</idno></persName> jószága.</note>
                        berkében,</l>
<l xml:id="l.80">Egy rétem széliben</l>
<l xml:id="l.81">Sirván bünömön szivböl.</l>
</lg>
</div>
</body>
