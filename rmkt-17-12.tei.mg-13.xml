<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 13.</fw>
<head type="title">FIDES</head>
<lg xml:id="lg.1">
<l xml:id="l.1">Az hitnek olaya égdeggel vilaggal,</l>
<l xml:id="l.2"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Jesus Christusra veti szemeit hit által,<note type="critic" xml:id="note.1">Vö. <persName>Rimay<idno type="ITIdata">Q155364</idno></persName> 34. sorával: Keresztit szemlélvén.</note></lem><rdg wit="#W1" xml:id="rdg.1">[Előbb:] Szent keresztre vety erdemet hit által</rdg></app></l>
<l xml:id="l.3"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Hitnek szeretteti sziveben fwl langal,</lem><rdg wit="#W1" xml:id="rdg.2"><del><gap extent="1" reason="illegible" unit="word"/></del><add type="corr">sziveben</add></rdg></app></l>
<l xml:id="l.4">Mikoron el szentul sacramentomokkal.</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.5">Hitbeol remenli lelky wduȯszegyt,</l>
<l xml:id="l.6"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">Mikor Jezusra vetti eo szemeit,</lem><rdg wit="#W1" xml:id="rdg.3">[Előbb:] Mikor Jezustol
                        varwan eo erdemet</rdg></app></l>
<l xml:id="l.7">Es chiak eö benne helihezteti hitit,</l>
<l xml:id="l.8">Szemmi teremteszre nem veti erdemit.</l>
</lg>
</div>
</body>
