<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 22/I.</fw>
<head type="title"><supplied>AZ GONOZ ASZONI ALATROL</supplied></head>
<head type="motto"><l xml:id="l.1">Nil temere Vxori de servo crede querenti</l>
<l xml:id="l.2"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Saepe etenim mulier quem coniunx diligit odit</lem><rdg wit="#W1" xml:id="rdg.1">coniun<del>gs</del><add type="insert">x</add></rdg></app></l></head>
<lg xml:id="lg.1"><l xml:id="l.3">Ne hid minden kor az Aszonialatnak.</l>
<l xml:id="l.4">Jambor szolgakra ha panaszolkodnak.</l>
<l xml:id="l.5">Nemis kel helt adni kẏwanszagoknak,</l>
<l xml:id="l.6"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Hogy igaz szolgȧiát erte meg vnnak,</lem><rdg wit="#W1" xml:id="rdg.2">Hogy <del>mindgiart</del> <add type="insert">igaz</add></rdg></app></l></lg>
<lg xml:id="lg.2"><l xml:id="l.7">Az Aszonialat, azt nem kedwelÿ</l>
<l xml:id="l.8">Meliet az Ferie legh inkab szerettÿ</l>
<l xml:id="l.9">Mindenkor az elen haragiát newelÿ</l>
<l xml:id="l.10">S. wegre Ferietis erte megh giüleőlẏ</l></lg>
<lg xml:id="lg.3"><l xml:id="l.11"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">E wilagȯn Wad S gonoszab Alatoknal.</lem>
<rdg wit="#W1" xml:id="rdg.3"><add type="overwritten">E</add>z</rdg>
</app></l>
<l xml:id="l.12"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4">Aszoni alatoknak kegietlėn haragnal</lem>
<rdg wit="#W1" xml:id="rdg.4">Aszoni <del>embereknek</del><add place="above" type="insert">alatoknak</add></rdg>
</app></l>
<l xml:id="l.13">Nem is mondhatnal mergeszebet annal</l>
<l xml:id="l.14">Mikor meg buszul haragal előtted áál</l></lg>
<lg xml:id="lg.4"><l xml:id="l.15">Aszonialatoknak czudas eö elmeiek.</l>
<l xml:id="l.16"><app xml:id="app.5"><lem wit="#KK" xml:id="lem.5">Mint Laszu viznek tekergeös eőrweniek.</lem><rdg wit="#W1" xml:id="rdg.5">Mint <del>az</del></rdg></app></l>
<l xml:id="l.17">Magokban el oszlo haragh hozó mergek.</l>
<l xml:id="l.18">Ne czudald hogi hálwáni miatok az Feriek.</l></lg>
<lg xml:id="lg.5"><l xml:id="l.19">Fėrienek nem nezik az eö beczw̋ letit</l>
<l xml:id="l.20">Ha latia Jőnie kedwes io wendegit</l>
<l xml:id="l.21">Mindenben mutatia beőcztelėnszegit</l>
<l xml:id="l.22">Moroghwȧ kesziti minden feőzelekit<note type="critic" xml:id="note.1">= főztjét</note></l></lg>
<lg xml:id="lg.6"><l xml:id="l.23"><app xml:id="app.6">
<lem wit="#KK" xml:id="lem.6">Aszoni ha haragsik mergében reszket,</lem>
<rdg wit="#W1" xml:id="rdg.6"><del>Mert</del><add place="above" type="insert">Aszoni</add> ha haragsik mergében <del>Vgian</del> reszket
                            </rdg>
</app></l>
<l xml:id="l.24">Akoron gonoszág sziwiben weer feeszket,</l>
<l xml:id="l.25">Atkoza es Sidgia az Niawalias Feriet</l>
<l xml:id="l.26">Kywania szeghinek egi orában wesztét</l></lg>
<lg xml:id="lg.7"><l xml:id="l.27"><app xml:id="app.7">
<lem wit="#KK" xml:id="lem.7">Hogẏ ha neky Tisteszeghez féérne</lem>
<rdg wit="#W1" xml:id="rdg.7">neky <del><add place="above" type="insert">az</add></del>
</rdg>
</app></l>
<l xml:id="l.28"><app xml:id="app.8"><lem wit="#KK" xml:id="lem.8">Buszult alapatban tudgia mit czelekedne,</lem><rdg wit="#W1" xml:id="rdg.8">alapatban <del>kẏ</del></rdg></app></l>
<l xml:id="l.29">Ha ferienek élte szynoron<note type="critic" xml:id="note.2">olv. zsinóron</note> lehetne,</l>
<l xml:id="l.30"><app xml:id="app.9"><lem wit="#KK" xml:id="lem.9">Haragiaban eö mindgiart el meczene,</lem><rdg wit="#W1" xml:id="rdg.9">Haragiaban <del>azt</del></rdg></app></l>
</lg> <lg xml:id="lg.8"><l xml:id="l.31">Nem oknelkul mondgia Salamon koniveben.</l>
<l xml:id="l.32">Ferfiat ezer kozw̋ l talalt az Sereghben.</l>
<l xml:id="l.33">De Teökeletes Aszonialatot egiett Szem,</l>
<l xml:id="l.34">Kẏ Termeszetibėn Volna, mint az Nap féni,<note type="critic" xml:id="note.3">29–32 Vö. <bibl>Préd. 7,
                                29.</bibl></note></l></lg>
<lg xml:id="lg.9"><l xml:id="l.35">Nemeli aszonialatok Tisteszéég kiwanok,</l>
<l xml:id="l.36">Czifrazaszokban mood nélkw̋ l walok</l>
<l xml:id="l.37">Szerelmeskedesbėn ighen be merw̋ leők</l>
<l xml:id="l.38">Ne czudald hogi bomlik farokon az hamiok</l></lg>
<lg xml:id="lg.10"><l xml:id="l.39"><app xml:id="app.10">
<lem wit="#KK" xml:id="lem.10">Jambor S Tokėletes Aszoni emberek.</lem>
<rdg wit="#W1" xml:id="rdg.10">Tokėletes <del>Tsendes</del></rdg>
</app></l>
<l xml:id="l.40">Magokra ez wérszekėtt ne Terieszek.</l>
<l xml:id="l.41">De Szeőt ez werszeket nagira beczw̋ liék</l>
<l xml:id="l.42"><app xml:id="app.11">
<lem wit="#KK" xml:id="lem.11">Tsak gonoz Aszonialatok erkolczere éérczek</lem>
<rdg wit="#W1" xml:id="rdg.11"><del>Hanem</del>
<add place="above" type="insert">Tsak</add></rdg>
</app></l></lg></div>
<div type="poem" xml:id="d.2" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 22/II.</fw>
<head type="title">AZ GONOZ ASZONI ALATROL.</head>
<lg xml:id="lg.11"><l xml:id="l.43"><app xml:id="app.12">
    <lem wit="#KK" xml:id="lem.12">Aszonj alat ha haraghsik vgian resket,<note type="critic" xml:id="note.4"> ≈ <ref target="rmkt-17-12.tei.mg-22#lg.6">22/I. 6.</ref></note></lem>
<rdg wit="#W2" xml:id="rdg.12"><del>Gonoz</del> Aszon<del>i</del>j</rdg>
</app></l>
<l xml:id="l.44">A koron gonosag Siuibén weér fésket</l>
<l xml:id="l.45">Atkozȧ Sidgia niawalias fériet,</l>
<l xml:id="l.46">Kiwania Segennek egi oraban vestet.</l></lg>
    <lg xml:id="lg.12"><l xml:id="l.47">Asoni alat azt nem kedwelẏ<note type="critic" xml:id="note.5"> ≈ <ref target="rmkt-17-12.tei.mg-22#lg.2">22/I. 2.</ref></note></l>
<l xml:id="l.48">Melliet ferie leg inkab seretti</l>
<l xml:id="l.49">Minden kor az ellén haragiat neweli</l>
<l xml:id="l.50">Vegre ferietis érte meg giűleőlẏ</l></lg>
    <lg xml:id="lg.13"><l xml:id="l.51">Vilagȯn Vad gonozab Alatoknal<note type="critic" xml:id="note.6"> ≈ <ref target="rmkt-17-12.tei.mg-22#lg.3">22/I. 3.</ref></note></l>
<l xml:id="l.52">Aszoni alatoknak kegietlen haragnal</l>
<l xml:id="l.53">Nemis mondhacz mergesebet annal.</l>
<l xml:id="l.54"><app xml:id="app.13"><lem wit="#KK" xml:id="lem.13">Mikor meg busul haragal meleted al</lem><rdg wit="#W2" xml:id="rdg.13"><del>v̋</del><add type="corr">a</add>l</rdg></app></l></lg>
    <lg xml:id="lg.14"><l xml:id="l.55">Aszoni alatoknak chudȧs elmeiek.<note type="critic" xml:id="note.7"> ≈ <ref target="rmkt-17-12.tei.mg-22#lg.4">22/I. 4.</ref></note></l>
<l xml:id="l.56">Mint lasu viznek Tekergös őrweniek</l>
<l xml:id="l.57">Magokbȧn el oslo haragos mergek</l>
<l xml:id="l.58">Ne chudald hogi halwani miatok feriek</l></lg>
    <lg xml:id="lg.15"><l xml:id="l.59">Ferienek nem nezik ő bechw̋ letit<note type="critic" xml:id="note.8"> ≈ <ref target="rmkt-17-12.tei.mg-22#lg.5">22/I. 5.</ref></note></l>
<l xml:id="l.60">Ha latia Ionie kedwés vendegit</l>
<l xml:id="l.61">Mindėnben mutatia bocztelensegit</l>
<l xml:id="l.62">Morogwa kesiti eö Feözelekit</l></lg>
    <lg xml:id="lg.16"><l xml:id="l.63">Hógi ha nekik Tisteseghez férne<note type="critic" xml:id="note.9"> ≈ <ref target="rmkt-17-12.tei.mg-22#lg.7">22/I. 7.</ref></note></l>
<l xml:id="l.64">Busult alapatbȧn tudgia mit chelekedne</l>
<l xml:id="l.65">Ha ferienek elte Sinóron lehetne</l>
<l xml:id="l.66"><app xml:id="app.14"><lem wit="#KK" xml:id="lem.14">Hȧragiaban azt mindgiárt el meczene.</lem><rdg wit="#W2" xml:id="rdg.14"><del rend="overwritten"><gap extent="1" reason="illegible" unit="word"/></del><add type="overwrite">Hȧ</add>ragiaban</rdg></app></l></lg>
    <lg xml:id="lg.17"><l xml:id="l.67">Nem ok nelkẅl mondgia Salamon koniveben,<note type="critic" xml:id="note.10"> ≈ <ref target="rmkt-17-12.tei.mg-22#lg.8">22/I. 8.</ref></note></l>
<l xml:id="l.68"><app xml:id="app.15"><lem wit="#KK" xml:id="lem.15">Ferfiat ezer kozẅl talalt az Sereghben</lem><rdg wit="#W2" xml:id="rdg.15">talalt <del rend="overwritten">egi</del> <add type="overwrite">az</add></rdg></app></l>
<l xml:id="l.69">De Tőkeletes Aszoni alatot egiet sem</l>
<l xml:id="l.70">Ki Termesetiben lenne mind az Nap féni</l>
</lg> <lg xml:id="lg.18"><l xml:id="l.71">Nem gondol vrawal selel<note type="critic" xml:id="note.11">olv. széjjel</note> futos.</l>
<l xml:id="l.72">Nohȧ kis Subaia prėmes es Nustos.<note type="critic" xml:id="note.12">Nustos – nyusztbőrrel
                            díszített</note></l>
<l xml:id="l.73">Eseö vizteöl pegivet Swuege Lustos<note type="critic" xml:id="note.13">pegivet Swuege Lustos = mókusbőrből való süvege nedves</note></l>
<l xml:id="l.74">Feketeöie le esset haia chuportos.<note type="critic" xml:id="note.14">olv. csuportos = kócos,
                            borzas. Vö. <ref target="rmkt-17-12.tei.mg-jegyzetek">a paráznaságról írt értekezés</ref> 163. lapja versbetétének
                                utolsó sorával.</note></l></lg>
<lg xml:id="lg.19"><l xml:id="l.75">Ragalmaza Aszoni alat Somsedit</l>
<l xml:id="l.76">Dicziri magahoz hasonlo kowetőit</l>
<l xml:id="l.77">Vrara morog, hogi nem kėsiti étkit</l>
<l xml:id="l.78">Melire hihassȧ koslato baratit</l></lg>
    <lg xml:id="lg.20"><l xml:id="l.79"> Felete walo Tistesegh kiwano<note type="critic" xml:id="note.15"> ≈ <ref target="rmkt-17-12.tei.mg-22#lg.9">22/I. 9.</ref></note></l>
<l xml:id="l.80">Morgolodo moodnelkẇl walo</l>
<l xml:id="l.81">Keniesegeben igėn be merw̋ leö</l>
<l xml:id="l.82">Az farȧn hamia igėn le chwggeö</l></lg>
</div>
