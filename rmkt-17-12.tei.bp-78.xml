<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 78.</fw>
<head type="title">A’ KIVANATOS KIKELETNEK GYÖNYÖRÜSÉGÉRÜL</head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1"><corr>A Hera barlangját</corr><note type="critic" xml:id="note.1">Hera –
                                    a családi áldás, a szerelem istennője, a rómaiaknál Juno;
                                    barlangját – szentélyét.</note></lem>
<rdg wit="#Wα" xml:id="rdg.1">Vig Tavasz fel derült,</rdg>
<rdg wit="#W2" xml:id="rdg.2">A hera barlangiat</rdg>
</app></l>
<l xml:id="l.2"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2"><corr>Hogy borostyán folyja,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.3">Virágokkal frissült,</rdg>
<rdg wit="#W2" xml:id="rdg.4">Hogy borostyan follya</rdg>
</app></l>
<l xml:id="l.3"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3"><corr>Azzal ékes mostan zöld;</corr></lem>
<rdg wit="#Wα" xml:id="rdg.5">S’ uj pompával zöldellik</rdg>
<rdg wit="#W2" xml:id="rdg.6">Azzal ékes mostan zöld</rdg>
</app></l>
<l rend="level_2" xml:id="l.4">Örül immár Flora,<note type="critic" xml:id="note.2">A tavasznak, a virágoknak
                            az istennője.</note></l>
<l xml:id="l.5">Jutott kivánt jora,</l>
<l xml:id="l.6"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4"><corr>Éled kikelettel föld,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.7">Láttya fü s’ fa bimbozik</rdg>
<rdg wit="#W2" xml:id="rdg.8">Élled kikelettel föld</rdg>
</app></l>
<l rend="level_2" xml:id="l.7">Kedvet a’ Musáknál</l>
<l xml:id="l.8">Talált, s’ Apollonál,</l>
<l xml:id="l.9"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5"><corr>Nékik koszorúkat küld.</corr></lem>
<rdg wit="#Wα" xml:id="rdg.9">Koszorukat küld nékik</rdg>
<rdg wit="#W2" xml:id="rdg.10">Nékék koszorukat küld</rdg>
</app></l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10">Ujjul a’ forrás kut,</l>
<l xml:id="l.11">S’ föld gyomrábul ki-fut,</l>
<l xml:id="l.12">Szép Völgyekre siet, s’ tér,</l>
<l rend="level_2" xml:id="l.13">Minden féle állat,</l>
<l xml:id="l.14">Nagy és kicsin falat,</l>
<l xml:id="l.15">Örül hogy már Tavaszt ér,</l>
<l rend="level_2" xml:id="l.16">Nem szenved rothadást,</l>
<l xml:id="l.17">Mert reménl újjúlást</l>
<l xml:id="l.18">Minden éltetö gyükér.</l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19">Az szép hajnal ragyog,</l>
<l xml:id="l.20"><app xml:id="app.6">
<lem wit="#KK" xml:id="lem.6"><corr>Ékes</corr> harmat villog,</lem>
<rdg wit="#Wα" xml:id="rdg.11">Gyöngyös</rdg>
<rdg wit="#W2" xml:id="rdg.12">Ékes</rdg>
</app></l>
<l xml:id="l.21"><app xml:id="app.7">
<lem wit="#KK" xml:id="lem.7"><corr>Hoz kedvet minden felül,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.13">Bús sziveknek hoz kedvet,</rdg>
<rdg wit="#W2" xml:id="rdg.14">Hoz kedvet minden felül,</rdg>
</app></l>
<l rend="level_2" xml:id="l.22"><app xml:id="app.8">
<lem wit="#KK" xml:id="lem.8"><corr>Jó hírrel jött fecske,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.15">Minden féle madár,</rdg>
<rdg wit="#W2" xml:id="rdg.16">Io hérrél giut föcske,</rdg>
</app></l>
<l xml:id="l.23"><app xml:id="app.9">
<lem wit="#KK" xml:id="lem.9"><corr>Ujul agyag fészke,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.17">Kit dér hideg el-zár,</rdg>
<rdg wit="#W2" xml:id="rdg.18">Ujjul agyag féske,</rdg>
</app></l>
<l xml:id="l.24"><app xml:id="app.10">
<lem wit="#KK" xml:id="lem.10"><corr>Csacsog már házon kívül,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.19">Vigan kezd uj éneket,</rdg>
<rdg wit="#W2" xml:id="rdg.20">Csacsok mar hazon kiuül,</rdg>
</app></l>
<l rend="level_2" xml:id="l.25"><app xml:id="app.11">
<lem wit="#KK" xml:id="lem.11"><corr>Nap keletkor varjú</corr></lem>
<rdg wit="#Wα" xml:id="rdg.21">Jó hérrel jön fecske,</rdg>
<rdg wit="#W2" xml:id="rdg.22">Nap keletkor varyu,</rdg>
</app></l>
<l xml:id="l.26"><app xml:id="app.12">
<lem wit="#KK" xml:id="lem.12"><corr>Kákogva jön elő,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.23">Ujjúl agyag fészke,</rdg>
<rdg wit="#W2" xml:id="rdg.24">Kakogva giun elö,</rdg>
</app></l>
<l xml:id="l.27"><app xml:id="app.13">
<lem wit="#KK" xml:id="lem.13"><corr>Ily szép időnek örül.</corr></lem>
<rdg wit="#Wα" xml:id="rdg.25">Csácsog az házok felett.</rdg>
<rdg wit="#W2" xml:id="rdg.26">Ily sép edönek öröl.</rdg>
</app></l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.28">Eg felé pacsirta</l>
<l xml:id="l.29">Repül, hogy szozattya</l>
<l xml:id="l.30">Meszszére el-terjedgyen,</l>
<l rend="level_2" xml:id="l.31">Fülemile ágon</l>
<l xml:id="l.32">Függ, csak kicsiny szálon,</l>
<l xml:id="l.33">Alom reá ne érjen,</l>
<l rend="level_2" xml:id="l.34">Addig szóll, s’ énekel,</l>
<l xml:id="l.35">Még az tajték vérrel</l>
<l xml:id="l.36">Kicsiny száján eredgyen.</l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.37">Czinege madárka,</l>
<l xml:id="l.38"><app xml:id="app.14">
<lem wit="#KK" xml:id="lem.14">Kit rekeszt, s’ kalitka</lem>
<rdg wit="#W2 #W3 #W4" xml:id="rdg.27">rekez</rdg>
</app></l>
<l xml:id="l.39">Dió béllel meg-csalhat,</l>
<l rend="level_2" xml:id="l.40">Tavaszi vad kecske,</l>
<l xml:id="l.41">Együgyü özecske,</l>
<l xml:id="l.42">Kit tör, s’ háló meg-foghat,</l>
<l rend="level_2" xml:id="l.43">Jutott kikeletre,</l>
<l xml:id="l.44">Nem kerül most kézre,</l>
<l xml:id="l.45">Bátran nyomot mutathat.</l>
</lg>
<lg xml:id="lg.6">
<l rend="level_2" xml:id="l.46">Rigot-is az törre,</l>
<l xml:id="l.47">Nem csalhatz most lépre,</l>
<l xml:id="l.48">Fogoly bokrot nem lakja,</l>
<l rend="level_2" xml:id="l.49">Az für csattog nagyon,</l>
<l xml:id="l.50">Nem fél semmit azon,</l>
<l xml:id="l.51">Hogy az karuly el-fogja,</l>
<l rend="level_2" xml:id="l.52">Héjja-is süvölti,</l>
<l xml:id="l.53">Vetett tört kerüli,</l>
<l xml:id="l.54">Tyuk fiakat csapkodgya.</l>
</lg>
<lg xml:id="lg.7">
<l rend="level_2" xml:id="l.55">Golya-is gázollya,</l>
<l xml:id="l.56"><app xml:id="app.15">
<lem wit="#KK" xml:id="lem.15">Mocsárokat járja,</lem>
<rdg wit="#W2" xml:id="rdg.28">Mocsarakon</rdg>
</app></l>
<l xml:id="l.57">Kigyót, s’ békát foghasson,</l>
<l rend="level_2" xml:id="l.58">Fészket rak kéményen,</l>
<l xml:id="l.59"><app xml:id="app.16">
<lem wit="#KK" xml:id="lem.16">Nem fél füst r<corr>á</corr> mennyen,</lem>
<rdg wit="#W1" xml:id="rdg.29">reá</rdg>
<rdg wit="#W2 #W3 #W4" xml:id="rdg.30">rá</rdg>
</app></l>
<l xml:id="l.60">Korog, s kotyog hangasson,</l>
<l rend="level_2" xml:id="l.61">Roka lappang, s’ forog,</l>
<l xml:id="l.62">S’ kertek alatt kullog,</l>
<l xml:id="l.63"><app xml:id="app.17">
<lem wit="#KK" xml:id="lem.17">Lud fiak<corr>ban kaphasson</corr>.</lem>
<rdg wit="#Wα" xml:id="rdg.31">fiakra üthessen</rdg>
<rdg wit="#W2" xml:id="rdg.32">fiakban kaphasson</rdg>
</app></l>
</lg>
<lg xml:id="lg.8">
<l rend="level_2" xml:id="l.64">Szomju szarvas kútra,</l>
<l xml:id="l.65">S’ bádgyatt madár ágra</l>
<l xml:id="l.66">Száll, s’ nyugosznak csendessen,</l>
<l rend="level_2" xml:id="l.67">Minden bokor szállást,</l>
<l xml:id="l.68">A’ zöld árnyék nyugvást</l>
<l xml:id="l.69">Enged nékik kedvessen,</l>
<l rend="level_2" xml:id="l.70">Csak nékem szegénnek,</l>
<l xml:id="l.71">Arva bús fejemnek</l>
<l xml:id="l.72">Foly dolgom keservessen.</l>
</lg>
<lg xml:id="lg.9">
<l rend="level_2" xml:id="l.73">Mit ohajcson lelkem,</l>
<l xml:id="l.74">S’ mit példáz értelmem,</l>
<l xml:id="l.75">Figyelmezz verseimre,</l>
<l rend="level_2" xml:id="l.76"><app xml:id="app.18">
<lem wit="#KK" xml:id="lem.18">Nem testi fájdalom,</lem>
<rdg wit="#Wβ" xml:id="rdg.33">Sok testi</rdg>
</app></l>
<l xml:id="l.77"><app xml:id="app.19">
<lem wit="#KK" xml:id="lem.19">De bús aggodalom</lem>
<rdg wit="#Wβ" xml:id="rdg.34">Es bús</rdg>
</app></l>
<l xml:id="l.78">Szállott mostan szivemre,</l>
<l rend="level_2" xml:id="l.79"><app xml:id="app.20">
<lem wit="#KK" xml:id="lem.20">Tégy válasz<corr>tot</corr><note type="critic" xml:id="note.3">választ
                                    (fn.)</note> Echó,</lem>
<rdg wit="#W1" xml:id="rdg.35">választ ott</rdg>
<rdg wit="#W2" xml:id="rdg.36">valastot</rdg>
<rdg wit="#W3" xml:id="rdg.37">válaszlást</rdg>
<rdg wit="#W4" xml:id="rdg.38">választot</rdg>
</app></l>
<l xml:id="l.80"><app xml:id="app.21">
<lem wit="#KK" xml:id="lem.21"><corr>Ki vagy égben</corr> lako,</lem>
<rdg wit="#Wα" xml:id="rdg.39">Kösziklák közt</rdg>
<rdg wit="#W2" xml:id="rdg.40">Ki vagy eghben</rdg>
</app></l>
<l xml:id="l.81">Felely mostan mesémre.</l>
</lg>
</div>
</body>
