<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 73.</fw>
<head type="title">BU ÉS BÁNAT HENYÉLÖ SZIVBEN VÉR FÉSZKET</head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1">Valahol el-megyek,</l>
<l xml:id="l.2">S’ valamit szemlélek,</l>
<l xml:id="l.3">Minden vigad kedvére;</l>
<l rend="level_2" xml:id="l.4">Szarvasok forrásra,</l>
<l xml:id="l.5">S’ bádgyat madár ágra</l>
<l xml:id="l.6">Le-szál nyugodni délre,</l>
<l rend="level_2" xml:id="l.7">De én bus szivemet,</l>
<l xml:id="l.8">Kis reménségemet,</l>
<l xml:id="l.9">Mikor hozom örömre?</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10">Nem nagyob az bánat,</l>
<l xml:id="l.11"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Mint a’ bús gondolat,</lem><rdg wit="#W1" xml:id="rdg.1">bú</rdg><rdg wit="#W2 #W3 #W4" xml:id="rdg.2">bús</rdg></app></l>
<l xml:id="l.12">Noha szünik kevessé,</l>
<l rend="level_2" xml:id="l.13">Bánat vidámulást,</l>
<l xml:id="l.14"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">S’ társaságtul szollást</lem><rdg wit="#Wβ" xml:id="rdg.3">S-társaságrúl</rdg></app></l>
<l xml:id="l.15"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">Veszen, s’ tehet nyertessé,</lem><rdg wit="#W2" xml:id="rdg.4">nyertessen</rdg></app></l>
<l rend="level_2" xml:id="l.16">De a’ szivben száradt</l>
<l xml:id="l.17"><app xml:id="app.4"><lem wit="#KK" xml:id="lem.4"><corr>Bús gondolat fáraszt</corr>,</lem><rdg wit="#Wα" xml:id="rdg.5">Bús gond reám áradt</rdg><rdg wit="#W2" xml:id="rdg.6">But <sic>s</sic> gondolat faraszt</rdg></app></l>
<l xml:id="l.18">Es tészen kétségessé.</l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19"><app xml:id="app.5"><lem wit="#KK" xml:id="lem.5">Igy elmém zavarja</lem><rdg wit="#W2" xml:id="rdg.7">Im</rdg></app></l>
<l xml:id="l.20">S’ bú szivem faggattya,</l>
<l xml:id="l.21">Esetemre figyelmez;</l>
<l rend="level_2" xml:id="l.22">Tettetö képzéssel,</l>
<l xml:id="l.23">S’ csalfa mesterséggel</l>
<l xml:id="l.24">Engem üldöz s’ környékez,</l>
<l rend="level_2" xml:id="l.25">Ha késem sokára</l>
<l xml:id="l.26">S’ nem indulok utra,</l>
<l xml:id="l.27">Félö galibát szerez.</l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.28">Azért im készülök</l>
<l xml:id="l.29">S’ útamra eredek,</l>
<l xml:id="l.30">Oldalamon függ kardom,</l>
<l rend="level_2" xml:id="l.31"><app xml:id="app.6"><lem wit="#KK" xml:id="lem.6">Talám <corr>jutok ahhoz</corr>,</lem><rdg wit="#Wα" xml:id="rdg.8">barátomhoz</rdg><rdg wit="#W2" xml:id="rdg.9">iutok ahos</rdg></app></l>
<l xml:id="l.32"><app xml:id="app.7"><lem wit="#KK" xml:id="lem.7"><corr>Ki fogad magához</corr>,</lem><rdg wit="#W1" xml:id="rdg.10">Jutok s’hiv társomhoz</rdg><rdg wit="#W2" xml:id="rdg.11">Ki fogad magahos</rdg><rdg wit="#Wβ" xml:id="rdg.12">Jutok, s’ pajtársomhoz</rdg></app></l>
<l xml:id="l.33">Kihez régen vágyodom,</l>
<l rend="level_2" xml:id="l.34">A’ hol vigasztalást,</l>
<l xml:id="l.35">S’ kedves nyugvo szállást</l>
<l xml:id="l.36">Találok nyilván tudom.</l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.37">Induly azért lovam,</l>
<l xml:id="l.38">Látod el-szánt utam</l>
<l xml:id="l.39">Vagyon jelen elöttem:</l>
<l rend="level_2" xml:id="l.40">Nem lehet panaszod,</l>
<l xml:id="l.41">Meg-jár te abrakod,</l>
<l xml:id="l.42">Hordozd bátran bús szivem,</l>
<l rend="level_2" xml:id="l.43">Nincs semmi mentséged,</l>
<l xml:id="l.44">Jó vas patko szeged,</l>
<l xml:id="l.45"><app xml:id="app.8"><lem wit="#KK" xml:id="lem.8">Keresd-fel régi kedvem.</lem><rdg wit="#W2" xml:id="rdg.13">kedved</rdg></app></l>
</lg>
<lg xml:id="lg.6">
<l rend="level_2" xml:id="l.46">A’ sötét étszaka,</l>
<l xml:id="l.47"><app xml:id="app.9"><lem wit="#KK" xml:id="lem.9">Sok zápor harmattya,</lem><rdg wit="#W2" xml:id="rdg.14">harmattra</rdg></app></l>
<l xml:id="l.48">Már nem ujság elötted,</l>
<l rend="level_2" xml:id="l.49">Az csoportos<note type="critic" xml:id="note.1">nagy tömegű, tömeges</note> jegek,</l>
<l xml:id="l.50">Es köves esvények</l>
<l xml:id="l.51">Ne ijeszszenek téged,</l>
<l rend="level_2" xml:id="l.52">Sürü tövis bokor,</l>
<l xml:id="l.53">Kit fogsz nyomni sokszor,</l>
<l xml:id="l.54">Lesz örömödre néked.</l>
</lg>
<lg xml:id="lg.7">
<l rend="level_2" xml:id="l.55">Kö essö,<note type="critic" xml:id="note.2">jégesés</note> csattogás,</l>
<l xml:id="l.56">Menydörgés, s’ villámás,</l>
<l xml:id="l.57">Ne gátollya útadat.</l>
<l rend="level_2" xml:id="l.58">Zuzmaráz,<note type="critic" xml:id="note.3">zúzmara</note> és hideg,</l>
<l xml:id="l.59">Jeges út, s’ fergeteg</l>
<l xml:id="l.60">Ne rettencse lábodat.</l>
<l rend="level_2" xml:id="l.61"><app xml:id="app.10"><lem wit="#KK" xml:id="lem.10"><corr>Erdös hegyen s völgyön</corr>,</lem><rdg wit="#Wα" xml:id="rdg.15">Köves erdös hegyen</rdg><rdg wit="#W2" xml:id="rdg.16">Eördös hegyen s völgien</rdg></app></l>
<l xml:id="l.62">Sombokos mezöben</l>
<l xml:id="l.63">Jelül hadgyad nyomodat.</l>
</lg>
<lg xml:id="lg.8">
<l rend="level_2" xml:id="l.64">Nagy sáros berkekben,</l>
<l xml:id="l.65">S’ homok tér völgyekben<note type="critic" xml:id="note.4">nagy, kiterjedt völgyekben</note></l>
<l xml:id="l.66">Ha szintén lesz-is útad,</l>
<l rend="level_2" xml:id="l.67">Irtoványos<note type="critic" xml:id="note.5">kiszaggatott, feltépett</note> rétre,</l>
<l xml:id="l.68">S’ Posványos helyekre</l>
<l xml:id="l.69">Ha a’ szükség rá juttat,</l>
<l rend="level_2" xml:id="l.70">Semminek itillyed,</l>
<l xml:id="l.71">Kedvemet ne szegjed,</l>
<l xml:id="l.72">Lészen hasznos jutalmad.</l>
</lg>
<lg xml:id="lg.9">
<l rend="level_2" xml:id="l.73">Ha oda érkezel,</l>
<l xml:id="l.74">Kit szivem gondol-el,</l>
<l xml:id="l.75">Lészen kedves szállásod,</l>
<l rend="level_2" xml:id="l.76">Engemet sok bútúl,</l>
<l xml:id="l.77">Emésztö gondoktul</l>
<l xml:id="l.78">Meg-mentesz, és lakásod</l>
<l rend="level_2" xml:id="l.79"><app xml:id="app.11"><lem wit="#KK" xml:id="lem.11">Lészen<corr> az uradnál,</corr></lem><rdg wit="#Wα" xml:id="rdg.17">barátomnál</rdg><rdg wit="#W2" xml:id="rdg.18">az Uradnal</rdg></app></l>
<l xml:id="l.80"><app xml:id="app.12"><lem wit="#KK" xml:id="lem.12">S’ kévánt édes jómnál</lem><rdg wit="#W2" xml:id="rdg.19">iodnal</rdg><rdg wit="#Wβ" xml:id="rdg.20">Jó hiv pajtársomnál</rdg></app></l>
<l xml:id="l.81">Uraddal nyugovásod.</l>
</lg>
<lg xml:id="lg.10">
<l rend="level_2" xml:id="l.82">Hideg ösz kezdetin,</l>
<l xml:id="l.83">Dudvág berke szélin</l>
<l xml:id="l.84">Sok buval, s’ gondal valék,</l>
<l rend="level_2" xml:id="l.85">Ollyan szándék ére,</l>
<l xml:id="l.86">Elmém-is rá tére,</l>
<l xml:id="l.87">Hogy utamra készülnék:</l>
<l rend="level_2" xml:id="l.88">Az hol vigasztalást</l>
<l xml:id="l.89">S’ kedves nyugvó szállást</l>
<l xml:id="l.90">Fejemnek találhatnék.</l>
</lg>
</div>
</body>
