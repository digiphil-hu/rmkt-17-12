<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 49.</fw>
<lg xml:id="lg.1">
<l xml:id="l.1">Egi Szep roza szalat kwltem aiandekon,</l>
<l xml:id="l.2"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Wed tolem. szerelmem, el <corr>te</corr> azt oli okon,</lem><rdg wit="#W1" xml:id="rdg.1">elte</rdg></app></l>
<l xml:id="l.3">Hogi Sziuünk Niugodgiek koztunk egi Szandekon,</l>
<l xml:id="l.4">Mint ez Neȯt, nilt, niugot szep harmatos bokron.</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.5">Mi szerelmunknekis wastagodgiek Aága,</l>
<l xml:id="l.6">Viullion kőzőtünk Naponkinth wirȧgha,</l>
<l xml:id="l.7">Szemeliunknek koztu̇ nk kedues legien Saga,</l>
<l xml:id="l.8">Ra soha ne hullion szemmi gonos ragia.</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.9">Ez kultem rozaert nem kiwanok nagyot,</l>
<l xml:id="l.10">Chiak hogi haicz en hozam szerelmes orchadot,</l>
<l xml:id="l.11">Kire ragaztotad szep piros rozadat,</l>
<l xml:id="l.12"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Hogi annath<note type="critic" xml:id="note.1">= onnat</note> Siwhassa<note type="critic" xml:id="note.2">Valószínűleg szórontás <hi rend="italic">szívhassam</hi>
                                    helyett (vö. <bibl><hi rend="smallcaps">Bóta</hi>: i. m.
                                        7</bibl>), de mivel a kódexek verseiben elég gyakori az
                                    ehhez hasonló személycsere, nem javítottuk.</note> illetteȯ
                                Zagodoth.</lem><rdg wit="#W1" xml:id="rdg.2">anna<del rend="overwritten">k</del><add type="corr">th</add><note type="critic" xml:id="note.3">A <hi rend="italic">th</hi> ráírva <hi rend="italic">k</hi>-ra, de fordítva is
                                    lehet.</note></rdg></app></l>
</lg>
</div>
</body>
</text>
