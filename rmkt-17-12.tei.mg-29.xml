<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 29.</fw>
<head type="motto"><l xml:id="l.1">Ereptis opibus noli moerere querendo</l><l xml:id="l.2"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Sed gaud<corr>e</corr> potius sibi si contingat habere.</lem><rdg wit="#W1" xml:id="rdg.1">gaudeo</rdg></app></l></head>
<lg xml:id="lg.1">
<l xml:id="l.3">Weszet Marha Vtan te ne Sirankozál</l>
<l xml:id="l.4"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Weszélt magadnak neis hozad azal</lem>
<rdg wit="#W1" xml:id="rdg.2">[Előbb:] magatoknak ne<add type="insert">is</add> hozat<del>ok</del><note type="critic" xml:id="note.1">A javítás
                                áthúzással, ráírással, az <hi rend="italic">is</hi> beszúrásával
                                történt.</note></rdg>
</app></l>
<l xml:id="l.5"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">Buss Szẇwnek voltawal hogi el ne karhozal</lem><rdg wit="#W1" xml:id="rdg.3">[Előbb:] Szẅwnek buss</rdg></app></l>
<l xml:id="l.6">S lelkednek orőke ne agi helt kinzaszal</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.7">Mi haszon te nekėd az vtan bankodni</l>
<l xml:id="l.8">Az kit Jsten el wet azon szanakozny</l>
<l xml:id="l.9"><app xml:id="app.4"><lem wit="#KK" xml:id="lem.4">Elme teőrődeszel az feiedet hannẏ</lem><rdg wit="#W1" xml:id="rdg.4">fei<del>űnket</del> <add place="above" type="insert">edet</add></rdg></app></l>
<l xml:id="l.10"><app xml:id="app.5"><lem wit="#KK" xml:id="lem.5">Iob Jstennednek azón halat adnÿ</lem><rdg wit="#W1" xml:id="rdg.5"><del>Hogi</del> iob <del>Jstennek</del><add type="corr">Jstennednek</add></rdg></app></l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.11">Gazdagsagha nagi Volt tudhat az Szent Jóbnak</l>
<l xml:id="l.12"><app xml:id="app.6">
<lem wit="#KK" xml:id="lem.6">Egi nap el weszesze mind az szok
                                <corr>baromnak</corr></lem>
<rdg wit="#W1" xml:id="rdg.6">szok <del>baromnak</del>
<note type="critic" xml:id="note.2">Más tintával:</note><add place="above" type="insert">Marhanak</add></rdg>
</app></l>
<l xml:id="l.13"><app xml:id="app.7"><lem wit="#KK" xml:id="lem.7">Jo pelda adoia eö volt mind azoknak</lem><rdg wit="#W1" xml:id="rdg.7">[Előbb:] volt eö</rdg></app></l>
<l xml:id="l.14">Kik tw̋ reszel senuedik weszet<note type="critic" xml:id="note.3">olv. veszét a. m. vesztét</note> marhaioknak</l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.15">Jstenes eletel ha Marhat<note type="critic" xml:id="note.4">marhád</note> kereszed</l>
<l xml:id="l.16">Beö aldaszawal rakwa leszen chw̋ rőd</l>
<l xml:id="l.17"><app xml:id="app.8"><lem wit="#KK" xml:id="lem.8">Hazadban es kiwül aldamaszal<note type="critic" xml:id="note.5">= áldással</note> méred</lem><rdg wit="#W1" xml:id="rdg.8">alda<del>sz</del><add type="corr">m</add>aszal<note type="critic" xml:id="note.6">Előtte más tintával: <add type="insert">nagi</add></note></rdg></app></l>
<l xml:id="l.18">Jrgalmaszagatis vegre meg erézed.</l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.19">Az vẏ keresetnek te inkab eőrwengiel</l>
<l xml:id="l.20">Ȧz kit semeddel lats annak hizelkedgiel</l>
<l xml:id="l.21">Ȧz kit Jsten adot ahoz legi eorzeszell</l>
<l xml:id="l.22">Alamiznalkodo segenihez beo kezel</l>
</lg>
<lg xml:id="lg.6">
<l xml:id="l.23"><app xml:id="app.9">
<lem wit="#KK" xml:id="lem.9">Aldgi<corr>on</corr> megh az Isten az vi
                                kereszetben</lem>
<rdg wit="#W1" xml:id="rdg.9">Aldgi<del rend="overwritten">on</del><add type="corr">a</add><note type="critic" xml:id="note.7">Más tintával ráírva.</note></rdg>
</app></l>
<l xml:id="l.24"><app xml:id="app.10">
<lem wit="#KK" xml:id="lem.10">Hadgia el kolten<corr>ünk</corr> boldogul eletben</lem>
<rdg wit="#W1" xml:id="rdg.10">költen<del>ünk</del><add type="insert">ẏ</add><note type="critic" xml:id="note.8">Más
                            tintával ráírva.</note></rdg>
</app></l>
<l xml:id="l.25">Miatta ne hadgion eszni kyszirtetben</l>
<l xml:id="l.26">Holtunk vtan lölkúnk Jusson Diczőszegben,</l>
</lg>
</div>
</body>
