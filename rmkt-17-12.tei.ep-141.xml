<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 141.</fw>
<head type="title">EGY KIS KARVOLY MADARROL VALO TANCZ ÉNEK</head>
<fw corresp="Esterházy Pál" type="lg">201.</fw>
<lg xml:id="lg.1">
<l xml:id="l.1">Isten hozzád karuolykám</l>
<l xml:id="l.2">Gyönyörü kis Madárkám</l>
<l rend="level_2" xml:id="l.3">Noha talám többé nem lát Orczám,</l>
<l rend="level_2" xml:id="l.4">Nem feleit el mégis, higyed pennám.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">202.</fw>
<lg xml:id="lg.2">
<l xml:id="l.5">Légyen tehát irgalma</l>
<l xml:id="l.6">Véghetetlen hatalma,</l>
<l rend="level_2" xml:id="l.7">Raitad az Nagy Istennek oltalma,</l>
<l rend="level_2" xml:id="l.8">Fényeskegyél mint szép Arany Alma.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">203.</fw>
<lg xml:id="lg.3">
<l xml:id="l.9">Aldassál Váraidban</l>
<l xml:id="l.10">Magas kö Falaidban</l>
<l rend="level_2" xml:id="l.11">Semmit ne szenduegy szép házaidban</l>
<l rend="level_2" xml:id="l.12">Nyugogyál kedues nyoszolaidban.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">204.</fw>
<lg xml:id="lg.4">
<l xml:id="l.13">Böuelkegyél Aranyal</l>
<l xml:id="l.14">Pásit szinö Smaragdal</l>
<l rend="level_2" xml:id="l.15">Piros Vérhez hasonlo Rubintal</l>
<l rend="level_2" xml:id="l.16">Tüzzel uetekedö szép Gyemantal.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">205.</fw>
<lg xml:id="lg.5">
<l xml:id="l.17">Elötted szép Virágok</l>
<l xml:id="l.18">Tarka kis Tulipánok</l>
<l rend="level_2" xml:id="l.19">Térdet haiczanak Zöld Rozmaringok</l>
<l rend="level_2" xml:id="l.20">Vduarollyanak Amarintusok.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">206.</fw>
<lg xml:id="lg.6">
<l xml:id="l.21">Légyen Szolgálod Rosa,</l>
<l xml:id="l.22">Bor töltöd szép Viola,</l>
<l rend="level_2" xml:id="l.23">Etek fogod io illatu Ménta,</l>
<l rend="level_2" xml:id="l.24">Legh keduesb Inasod Maioranna.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">207.</fw>
<lg xml:id="lg.7">
<l xml:id="l.25">Szekfü légyen Szakáczod,</l>
<l xml:id="l.26">Isop kedues Barátod</l>
<l rend="level_2" xml:id="l.27">Magas Spanyor Bocza Asztalnakod</l>
<l rend="level_2" xml:id="l.28"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Ekes Narcissusis Pohárnokod.</lem><rdg wit="#W1" xml:id="rdg.1"> <note type="critic" xml:id="note.1">21–28 E két szakasz eredetileg fordított sorrendben.</note></rdg></app></l>
</lg>
<fw corresp="Esterházy Pál" type="lg">208.</fw>
<lg xml:id="lg.8">
<l xml:id="l.29">Spikinárd Zállyáual,</l>
<l xml:id="l.30">Hiacintus Ruttáual,</l>
<l rend="level_2" xml:id="l.31"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Io Balzamum kedues illattyáual</lem><rdg wit="#W1" xml:id="rdg.2"><add place="above" type="insert">kedues</add></rdg></app></l>
<l rend="level_2" xml:id="l.32">Pézma tarczon téged szép szagáual.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">209.</fw>
<lg xml:id="lg.9">
<l xml:id="l.33">Gyöngy Virág Musikásod</l>
<l xml:id="l.34">Szarka láb Virginásod</l>
<l rend="level_2" xml:id="l.35">Veröfény Virág légyen Dobosod,</l>
<l rend="level_2" xml:id="l.36">Harang uirág hangas Trombitásod.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">210.</fw>
<lg xml:id="lg.10">
<l xml:id="l.37">Kerted tellyék Cyprussal</l>
<l xml:id="l.38">Zöldellyék szép Laurussal,</l>
<l rend="level_2" xml:id="l.39">Gyümölczözzék illatos Cedrussal,</l>
<l rend="level_2" xml:id="l.40">Vetekegyék hires Parnassussal.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">211.</fw>
<lg xml:id="lg.11">
<l xml:id="l.41">Mulatságod Zephyrus</l>
<l xml:id="l.42">Légyen uagy Fauonius</l>
<l rend="level_2" xml:id="l.43">Semmi kárt ne tégyen nagy Æolus</l>
<l rend="level_2" xml:id="l.44">Fergeteget hozo gonosz Eurus.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">212.</fw>
<lg xml:id="lg.12">
<l xml:id="l.45">Pásiton mulatozzál</l>
<l xml:id="l.46">Arnyékban iaczodozzál</l>
<l rend="level_2" xml:id="l.47">Fényes Palotákban ugrandozzál,</l>
<l rend="level_2" xml:id="l.48">Énekesedrölis álmodozzál.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">213.</fw>
<lg xml:id="lg.13">
<l xml:id="l.49"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">Légy kedues Egésségben</lem><rdg wit="#W1" xml:id="rdg.3">Egésségben [Előbb:] békességben</rdg></app></l>
<l xml:id="l.50">Ki uagy minden szépségben</l>
<l rend="level_2" xml:id="l.51">Termeted penigh uan Deliségben</l>
<l rend="level_2" xml:id="l.52">Baratodhoz ualo kegyességben.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">214.</fw>
<lg xml:id="lg.14">
<l xml:id="l.53">Igy uégzém énekemet</l>
<l xml:id="l.54">Enyhituén én sziuemet,</l>
<l rend="level_2" xml:id="l.55">Ha már töllem el uontad keduemet</l>
<l rend="level_2" xml:id="l.56">Ottan ued io néuen kis Versemet.</l>
</lg>
</div>
</body>
