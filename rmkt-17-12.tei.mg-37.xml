<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 37.</fw>
<lg xml:id="lg.1">
<l xml:id="l.1">O tsalard wilagh mit tselekessel.</l>
<l xml:id="l.2">Raitad lakó santalan nemzettel.</l>
<l xml:id="l.3">Mulando iokkal giőniőrkȯdtettel.</l>
<l xml:id="l.4"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Alakoztatod<note type="critic" xml:id="note.1">= szemfényvesztést űzöl</note> hw̋<note type="critic" xml:id="note.2">= hiú</note> dichőszeggel.</lem><rdg wit="#W2" xml:id="rdg.1">heü</rdg></app></l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.5"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Jgirs embernek minden seepséget</lem>
<rdg wit="#W2" xml:id="rdg.2">Igirs nekiek</rdg>
</app></l>
<l xml:id="l.6">Aianls nekie nagi ditsöseget</l>
<l xml:id="l.7">Niakaban rantod tsifras Tiszteket,</l>
<l xml:id="l.8"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">Hizla<corr>lod</corr> iokkal az eö szemeket,</lem><rdg wit="#W1" xml:id="rdg.3">Hizladot</rdg><rdg wit="#W2" xml:id="rdg.4">Hizlalod <del>eöket</del>iokkal</rdg></app></l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.9">Seghenisegbẅl vrá emeled</l>
<l xml:id="l.10"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4">Arani lanczokkal, niakát terhe<corr>le</corr>d</lem>
<rdg wit="#W1" xml:id="rdg.5">terhelied</rdg>
<rdg wit="#W2" xml:id="rdg.6">niakad Terheled</rdg>
</app></l>
<l xml:id="l.11"><app xml:id="app.5"><lem wit="#KK" xml:id="lem.5">Mutogacz neki arani hegieket.</lem><rdg wit="#W2" xml:id="rdg.7">nekiek; hegieked</rdg></app></l>
<l xml:id="l.12"><app xml:id="app.6"><lem wit="#KK" xml:id="lem.6">Tsak homlokȧra vethezd belyeget.<note type="critic" xml:id="note.3">olv. bélyeged</note></lem><rdg wit="#W2" xml:id="rdg.8">bellieged</rdg></app></l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.13">Eminentissimusnak<note type="critic" xml:id="note.4">= a legkiválóbbnak, méltóságosnak</note>
                        te hiwatatod</l>
<l xml:id="l.14"><app xml:id="app.7"><lem wit="#KK" xml:id="lem.7">Glori<corr>osi</corr>ssimusnak<note type="critic" xml:id="note.5">= a legdicsőbbnek</note> te mondatatod</lem><rdg wit="#W1" xml:id="rdg.9">Glorissimusnak</rdg><rdg wit="#W2" xml:id="rdg.10">Gloriosissimusnak</rdg></app></l>
<l xml:id="l.15"><app xml:id="app.8">
<lem wit="#KK" xml:id="lem.8">Nagi meltȯszagrȧ fel mȧgoztalod</lem>
<rdg wit="#W2" xml:id="rdg.11">meltosagrȧ magoztalod</rdg>
</app></l>
<l xml:id="l.16">Perswasiorȧ<note type="critic" xml:id="note.6">= önhittségre</note> fualkodtatod.</l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.17">Hitit S. wallassát meg tagádtatȯd</l>
<l xml:id="l.18">Ezẅst Araniert. meg hȧzudtatod.</l>
<l xml:id="l.19">Vdwőszegeteȯl messe Tassitod</l>
<l xml:id="l.20"><app xml:id="app.9"><lem wit="#KK" xml:id="lem.9">Tsak legien neked wegre paitarszod.<note type="critic" xml:id="note.7">pajtásod</note></lem><rdg wit="#W2" xml:id="rdg.12">neked wallásban Tarsod</rdg></app></l>
</lg>
<lg xml:id="lg.6">
<l xml:id="l.21"><app xml:id="app.10">
<lem wit="#KK" xml:id="lem.10">Jgaznak V ̋ git te el forditod</lem>
<rdg wit="#W2" xml:id="rdg.13">fel forditod</rdg>
</app></l>
<l xml:id="l.22">Arwát Eőzwegiet meg niomoritod</l>
<l xml:id="l.23">Ha telik neked Arannial markod.</l>
<l xml:id="l.24"><app xml:id="app.11"><lem wit="#KK" xml:id="lem.11">Ne fellien semmit azȯn biztatod.</lem><rdg wit="#W2" xml:id="rdg.14">azzál</rdg></app></l>
</lg>
<lg xml:id="lg.7">
<l xml:id="l.25"><app xml:id="app.12"><lem wit="#KK" xml:id="lem.12">Azok <corr>m</corr>ind<note type="critic" xml:id="note.8">mint</note> Jarnak kik ragazkodnak</lem><rdg wit="#W1" xml:id="rdg.15"><del rend="overwritten">kik</del><add type="overwrite">nind</add></rdg><rdg wit="#W2" xml:id="rdg.16">[Hiányzik.]</rdg></app></l>
<l xml:id="l.26"><app xml:id="app.13"><lem wit="#KK" xml:id="lem.13">Alnoksagodhoz kik futamodnak</lem><rdg wit="#W2" xml:id="rdg.17">[Hiányzik.]</rdg></app></l>
<l xml:id="l.27"><app xml:id="app.14"><lem wit="#KK" xml:id="lem.14">Bocztelenszegre mind azok iutnȧk</lem><rdg wit="#W2" xml:id="rdg.18">[Hiányzik.]</rdg></app></l>
<l xml:id="l.28"><app xml:id="app.15"><lem wit="#KK" xml:id="lem.15">Szemtelenszeggel fȯldre burúlnak</lem><rdg wit="#W2" xml:id="rdg.19">[Hiányzik.]</rdg></app></l>
</lg>
<lg xml:id="lg.8">
<l xml:id="l.29"><app xml:id="app.16">
<lem wit="#KK" xml:id="lem.16">El wes az ki teged szeret.</lem>
<rdg wit="#W2" xml:id="rdg.20">[Hiányzik.]</rdg>
</app></l>
<l xml:id="l.30"><app xml:id="app.17"><lem wit="#KK" xml:id="lem.17">Pokol Tẇziben nem alsik senvet<note type="critic" xml:id="note.9">senyved</note></lem><rdg wit="#W2" xml:id="rdg.21">[Hiányzik.]</rdg></app></l>
<l xml:id="l.31"><app xml:id="app.18"><lem wit="#KK" xml:id="lem.18">Giöniőrẅszégert ördóg less bered.</lem><rdg wit="#W2" xml:id="rdg.22">[Hiányzik.]</rdg></app></l>
<l xml:id="l.32"><app xml:id="app.19"><lem wit="#KK" xml:id="lem.19">Vig eoromedert pokol less helied</lem><rdg wit="#W2" xml:id="rdg.23">[Hiányzik.]</rdg></app></l>
</lg>
</div>
</body>
