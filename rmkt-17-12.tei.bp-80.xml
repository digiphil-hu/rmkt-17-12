<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 80.</fw>
<head type="title">AZ EMBERNEK MAGA AJÁNLÁSÁRUL ÉS BIZTATÁSÁRUL</head>
<head type="subtitle">Jó szolga kevésen hiv voltál, ez után nagyobbat bizok
                    reád.</head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1">Pallyán vár ajándék,</l>
<l xml:id="l.2">Szép drága martalék,</l>
<l xml:id="l.3">Nyerd el édes Lovacskám,</l>
<l rend="level_2" xml:id="l.4"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1"><corr>Nyersz magadnak jó bért,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.1">Jó bért nyersz magadnak,</rdg>
<rdg wit="#W2" xml:id="rdg.2">Nyersz magadnak io bért,</rdg>
</app></l>
<l xml:id="l.5"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2"><corr>Nékem hasznot és hírt,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.3">Hirt s’ hasznot Uradnak</rdg>
<rdg wit="#W2" xml:id="rdg.4">Nékem hasznot és hirt</rdg>
</app></l>
<l xml:id="l.6">Föl nevelt kaczolácskám,<note type="critic" xml:id="note.1">kanca lovacskám</note></l>
<l rend="level_2" xml:id="l.7">Bizony meg hizlallak,</l>
<l xml:id="l.8">Es meg nyugasztallak,</l>
<l xml:id="l.9">Van ahoz abrakocskám.</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">Hajsz-elötted<note type="critic" xml:id="note.2">Hajsz – a bal oldali
                                    (helyenként: jobb oldali) irány; itt tehát azt jelenti baloldalt
                                    (jobboldalt). Míg itt főnév szerepe van a 28. sor hajsz szava a.
                                    m. balra (jobbra).</note> az nyúl,</lem>
<rdg wit="#W4" xml:id="rdg.5">Hajcsd-ki a’ bokorbúl</rdg>
</app></l>
<l xml:id="l.11"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4"><corr>Ki igen hosszan nyúl</corr>,</lem>
<rdg wit="#W1" xml:id="rdg.6">[Hiányzik.]</rdg>
<rdg wit="#W2" xml:id="rdg.7">Ki igen hosszan nyul</rdg>
<rdg wit="#W3" xml:id="rdg.8">Sebesseben indúlly</rdg>
<rdg wit="#W4" xml:id="rdg.9">S-elötted fút a’ nyúl</rdg>
</app></l>
<l xml:id="l.12">Verd-el édes kutyácskám,</l>
<l rend="level_2" xml:id="l.13">Most leled kedvemet,</l>
<l xml:id="l.14"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5">S’ bövithed étkemet,</lem>
<rdg wit="#W2" xml:id="rdg.10">s hevéthet</rdg>
</app></l>
<l xml:id="l.15">Kis kölyök agaracskám,</l>
<l rend="level_2" xml:id="l.16">Haza érvén nyugszol,</l>
<l xml:id="l.17">Jól tartva aluszol,</l>
<l xml:id="l.18">Te ó kedves vislácskám!</l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19">Szelek szárnyán járó</l>
<l xml:id="l.20"><app xml:id="app.6">
<lem wit="#KK" xml:id="lem.6">Kedves Soly<corr>mom</corr>, s’ Ráró<corr>m</corr>,</lem>
<rdg wit="#Wα" xml:id="rdg.11">Solyom, s’ Ráró,</rdg>
<rdg wit="#W2" xml:id="rdg.12">Solymom s Rarom</rdg>
</app></l>
<l xml:id="l.21">Most találod kedvemet,</l>
<l rend="level_2" xml:id="l.22">Fürj, s’ fogoly fogással,</l>
<l xml:id="l.23">S’ Récze vadászással</l>
<l xml:id="l.24">Jól tarthatod testemet,</l>
<l rend="level_2" xml:id="l.25">Kiért ez ösz fottán,</l>
<l xml:id="l.26">Télre kelve osztán</l>
<l xml:id="l.27">Meg-hizlallak tégedet.</l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.28">Csá szöke, hajsz tarcsa,<note type="critic" xml:id="note.3">Csá – a. m. jobbra
                            (helyenként: balra), ezzel a hajtószóval irányítják az ökröket szántás,
                            iga vonás közben; szöke – állatnév, nagybetűvel; tarcsa – ez is
                            állatnév, bizonyára elírás Tarcha = Tarka helyett; azonban mindenütt így
                            szerepel.</note></l>
<l xml:id="l.29">Iga nyakad tarcsa,</l>
<l xml:id="l.30">Szántogassad földemet,</l>
<l rend="level_2" xml:id="l.31">Meg-rakom csürömet,</l>
<l xml:id="l.32">S’ meg-töltöm vermimet,</l>
<l xml:id="l.33">Csak ircsad örökemet,</l>
<l rend="level_2" xml:id="l.34">Meg hid hogy meg-simulsz,</l>
<l xml:id="l.35">Meg-hizol s’ meg-javulsz,</l>
<l xml:id="l.36">Csak gyüjthessem pénzemet.</l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.37">Te hozzád-is Szolgám</l>
<l xml:id="l.38">Készen áll grátiám</l>
<l xml:id="l.39">Jámbor szolgálatodért,</l>
<l rend="level_2" xml:id="l.40">Ejjel, s’ nappal valo,</l>
<l xml:id="l.41">Soha meg nem állo</l>
<l xml:id="l.42">Nyughatatlanságidért,</l>
<l rend="level_2" xml:id="l.43">Csak szolgály serényen,</l>
<l xml:id="l.44">El-vészed te könnyen</l>
<l xml:id="l.45"><app xml:id="app.7">
<lem wit="#KK" xml:id="lem.7">Hasznod fáratságidért.</lem>
<rdg wit="#Wβ" xml:id="rdg.13">Hasznát</rdg>
</app></l>
</lg>
</div>
</body>
