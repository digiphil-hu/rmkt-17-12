<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 1.</fw>
<head type="title">DICZIRET</head>
<lg xml:id="lg.1">
<l xml:id="l.1">O Jehowá Szént Jstenem</l>
<l xml:id="l.2">Eletemben legi Vezerem</l>
<l xml:id="l.3">Dolgaimban segedelmem,</l>
<l xml:id="l.4">Tiszteszeges elő mentem.</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.5">Ohaitozwȧn teged hiwlak.</l>
<l xml:id="l.6">Alazatoszan Jmadlak.</l>
<l xml:id="l.7">Job kezed felól had aliak,</l>
<l xml:id="l.8"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">Mert vduosítomnek tartlak</lem>
<rdg wit="#W1" xml:id="rdg.1">Mert <del>teged Vramnak</del><add type="insert">vduosítomnek</add></rdg>
</app></l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.9">Segeli engem Sw̋ksegemben,</l>
<l xml:id="l.10">Ez mosztani nagi Jnszégben</l>
<l xml:id="l.11">Vegi fel engem én igiemben,</l>
<l xml:id="l.12">Soricz be te Szent kezedben.</l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.13">Minden időben welėm légi</l>
<l xml:id="l.14">Engėm Sarniáid ala Vegi</l>
<l xml:id="l.15">Vduőzw̋lt neped keőze tegẏ</l>
<l xml:id="l.16">Minden iókal aldgi s neueli Jgẏ.</l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.17">Eoriz nagi kegieszen engem.</l>
<l xml:id="l.18">Tarts lelkem nagi chėndeszeghben,</l>
<l xml:id="l.19"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Buneím tauoztazd teőlem</lem>
<rdg wit="#W1" xml:id="rdg.2"><del>Banatot</del><add type="insert">Buneím</add></rdg>
</app></l>
<l xml:id="l.20">Ne hagi meg fulni bűneőkben</l>
</lg>
<lg xml:id="lg.6">
<l xml:id="l.21">Jgi Tarthacz engem boldogull,</l>
<l xml:id="l.22">Hȧ te less nekem oltalmul</l>
<l xml:id="l.23">Meg ȧldwȧn kegieszegedbw̋l</l>
<l xml:id="l.24">Szentszégés aldomaszodbull.</l>
</lg>
<lg xml:id="lg.7">
<l xml:id="l.25">Szent Haromszag egi Jstenszég</l>
<l xml:id="l.26">Legien te neked dichoszegh</l>
<l xml:id="l.27"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">Tolem fiadtol Tiszteszegh</lem>
<rdg wit="#W1" xml:id="rdg.3"><del>Segeni</del><add type="insert">Tole<del rend="overwritten">d</del><add rend="overwrite">m</add></add></rdg>
</app></l>
<l xml:id="l.28">Teged díczíriem mind vegik.</l>
</lg>
</div>
</body>
</text>
