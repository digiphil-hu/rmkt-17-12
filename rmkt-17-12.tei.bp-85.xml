<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 85.</fw>
<head type="title"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">AZ KÜLÖMBÖZÖ SZIN FESTÉK<corr>EK</corr>NEK ÉRTELME ÉS
                            MAGYARÁZATTYA</lem>
<rdg wit="#W1" xml:id="rdg.1">festéknek</rdg>
<rdg wit="#W2 #W3 #W4" xml:id="rdg.2">festékeknek</rdg>
</app></head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1">Király szin<note type="critic" xml:id="note.1">Király szin – bíborszín</note>
                        méltoság,</l>
<l xml:id="l.2">Ezüst szin Uraság,</l>
<l xml:id="l.3">Piros jelent szerelmet,</l>
<l rend="level_2" xml:id="l.4">Fejér szin szüzesség,</l>
<l xml:id="l.5">Pásit szin<note type="critic" xml:id="note.2">Pásit szin – fűzöld</note> reménség,</l>
<l xml:id="l.6">Test szin jelent gyötrelmet,</l>
<l rend="level_2" xml:id="l.7">Tenger szin habozó,</l>
<l xml:id="l.8">Láng szin tétovázo,</l>
<l xml:id="l.9">A’ zöld jelent kegyelmet.</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10">Galamb szén értelmet,</l>
<l xml:id="l.11">Rosa engedelmet,</l>
<l xml:id="l.12">Veres jelent haragot,</l>
<l rend="level_2" xml:id="l.13">Eg szin jozan elmét,</l>
<l xml:id="l.14">Medgy szin sziv félelmét,</l>
<l xml:id="l.15">Haj szin<note type="critic" xml:id="note.3">Haj szin – gesztenyebarna, sötétes</note> jelent
                        haragot,</l>
<l rend="level_2" xml:id="l.16">A’ szürke gorombát,</l>
<l xml:id="l.17">Hamu szin ostobát,</l>
<l xml:id="l.18">Sárga jelent bolondot.</l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19">Baraczk szin együgyüt,</l>
<l xml:id="l.20"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Viola <corr>szomorút</corr>,</lem>
<rdg wit="#Wα" xml:id="rdg.3">mord kedvüt</rdg>
<rdg wit="#W2" xml:id="rdg.4">szomorut</rdg>
</app></l>
<l xml:id="l.21">Az kék jelent kétséget,</l>
<l rend="level_2" xml:id="l.22"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3"><corr>Fekete éppen gyász,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.5">A’ gyász fekete szin</rdg>
<rdg wit="#W2" xml:id="rdg.6">Fekete éppen gyasz</rdg>
</app></l>
<l xml:id="l.23"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4"><corr>Tudod, mivel ruház,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.7">Eletünknek estin</rdg>
<rdg wit="#W2" xml:id="rdg.8">Tudod mivel ruhaz,</rdg>
</app></l>
<l xml:id="l.24"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5"><corr>Jelent gyakran özvegyet,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.9">Halálra emlekeztet</rdg>
<rdg wit="#W2" xml:id="rdg.10">Ielent gyakran özvegyet</rdg>
</app></l>
<l rend="level_2" xml:id="l.25">Szederjes siralom</l>
<l xml:id="l.26">Szivbéli fájdalom;</l>
<l xml:id="l.27">Ad mindenik értelmet.</l>
</lg>
<p xml:id="p.1">VEGE A’ MAGYAR Sententiáknak</p>
</div>
</body>
