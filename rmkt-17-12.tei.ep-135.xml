<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 135.</fw>
<head type="title">EGY ÁRTATLAN IFIVNAK PANASZA CVPIDORA</head>
<fw corresp="Esterházy Pál" type="lg">96.</fw>
<lg xml:id="lg.1">
<l xml:id="l.1">Nisd megh én torkomat keserues sirásra</l>
<l rend="level_2" xml:id="l.2">Apollo mert imé iutok áruaságra,</l>
<l xml:id="l.3"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Kiért mint Gilicze nem szál az zöld ágra,</lem><rdg wit="#W2" xml:id="rdg.1">Gelicze</rdg></app></l>
<l rend="level_2" xml:id="l.4">Vgy sziuem nem kéuán iutni uigasságra.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">97.</fw>
<lg xml:id="lg.2">
<l xml:id="l.5">Nissátok megh Musák szemeim forrását</l>
<l rend="level_2" xml:id="l.6">Keserü sziuemnek neuellyem sirását,</l>
<l xml:id="l.7">Echo kiálczad megh lölköm sohaitását,</l>
<l rend="level_2" xml:id="l.8">Ifiuságomnak gyászollyam fogyását.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">98.</fw>
<lg xml:id="lg.3">
<l xml:id="l.9">Mert sebet czináltál Cupido sziuemben</l>
<l rend="level_2" xml:id="l.10">Kinek oruossága ninczen semmi füben,</l>
<l xml:id="l.11">Mint az Nap forgodik mesze környületben</l>
<l rend="level_2" xml:id="l.12">Vgy bum, s-ugy bánatom forog én sziuemben.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">99.</fw>
<lg xml:id="lg.4">
<l xml:id="l.13">Oceanus Tenger fön forgo habiai,</l>
<l rend="level_2" xml:id="l.14"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Vallyon oly nagyoké mint szemem áriai,</lem>
<rdg wit="#W2" xml:id="rdg.2">s-olly</rdg>
</app></l>
<l xml:id="l.15">Vagy oly melegeké Æthnának lángiai</l>
<l rend="level_2" xml:id="l.16">Mint égö sziuemnek lángozo habiai.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">100.</fw>
<lg xml:id="lg.5">
<l xml:id="l.17">Ô te irgalmatlan örülsz én kinomnak</l>
<l rend="level_2" xml:id="l.18">Örülsz, s-nem kéuánod hogy egyszer megh hallyak</l>
<l xml:id="l.19">Hanem uéghetetlen nehéz bánatomnak</l>
<l rend="level_2" xml:id="l.20">Böuitted örökké forrását kinomnak.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">101.</fw>
<lg xml:id="lg.6">
<l xml:id="l.21"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">Ha Oroszlány Anyád lett uolnais neked,</lem><rdg wit="#W2" xml:id="rdg.3">néked</rdg></app></l>
<l rend="level_2" xml:id="l.22">Auagy ha szoptatot uolna Medue téged</l>
<l xml:id="l.23"><app xml:id="app.4"><lem wit="#KK" xml:id="lem.4">Mégis nem köllenék igy kegyetlenkedned</lem><rdg wit="#W2" xml:id="rdg.4">köllene</rdg></app></l>
<l rend="level_2" xml:id="l.24">Ily kinban örülnöd, s-uér szopouá lenned.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">102.</fw>
<lg xml:id="lg.7">
<l xml:id="l.25">Acél megh lágyulhat tüzzel, mesterséggel</l>
<l rend="level_2" xml:id="l.26"><app xml:id="app.5"><lem wit="#KK" xml:id="lem.5">Hangya nyom ösmérszik kösziklán üdöuel,</lem><rdg wit="#W2" xml:id="rdg.5">ösmerszik</rdg></app></l>
<l xml:id="l.27"><app xml:id="app.6"><lem wit="#KK" xml:id="lem.6">De heában téged apolgatni uersel</lem><rdg wit="#W2" xml:id="rdg.6">ápolgatni</rdg></app></l>
<l rend="level_2" xml:id="l.28">Tüzzel mesterséggel nem haiolsz üdöuel.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">103.</fw>
<lg xml:id="lg.8">
<l xml:id="l.29">De nyomorult lélek, mostan mit czinálok,</l>
<l rend="level_2" xml:id="l.30">Sisiphus köuéuel nagy hegyet haigálok</l>
<l xml:id="l.31">Aszt tudom kigyonál kegyelmet találok,</l>
<l rend="level_2" xml:id="l.32">Aszt tudom örömre bánatombol szállok.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">104.</fw>
<lg xml:id="lg.9">
<l xml:id="l.33">Edességet elöb találok epében</l>
<l rend="level_2" xml:id="l.34">Hogy nem szeligyülést az te uad sziuedben,</l>
<l xml:id="l.35">Elöbbis árnyékot melegh ueröfényben</l>
<l rend="level_2" xml:id="l.36">Lágyulást gyémántban irgalmat Tengerben.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">105.</fw>
<lg xml:id="lg.10">
<l xml:id="l.37">Bizzony már el hittem Caucasus uolt Anyád</l>
<l rend="level_2" xml:id="l.38">Kegyetlen Oroszlány uolt szoptato Daikád</l>
<l xml:id="l.39">Mert nem gondolsz uélle hogy én sziuem lankad,</l>
<l rend="level_2" xml:id="l.40"><app xml:id="app.7"><lem wit="#KK" xml:id="lem.7">Ki miatt testemtöl lelkem maid el szakad.</lem><rdg wit="#W2" xml:id="rdg.7">miátt</rdg></app></l>
</lg>
<fw corresp="Esterházy Pál" type="lg">106.</fw>
<lg xml:id="lg.11">
<l xml:id="l.41">De te kegyetleneb uagy sokkal ezeknél</l>
<l rend="level_2" xml:id="l.42">Mérges Maedaeánál álnok Dalilenél</l>
<l xml:id="l.43">Haragos Parcaknál iszonyu Circénél</l>
<l rend="level_2" xml:id="l.44"><app xml:id="app.8"><lem wit="#KK" xml:id="lem.8">Medusa, Scillánál, s-habos Charibdisnél.</lem><rdg wit="#W2" xml:id="rdg.8">Charybdesnél.</rdg></app></l>
</lg>
<fw corresp="Esterházy Pál" type="lg">107.</fw>
<lg xml:id="lg.12">
<l xml:id="l.45">Ne gondollyad immár hogy megh gyogyulhassak</l>
<l rend="level_2" xml:id="l.46"><app xml:id="app.9"><lem wit="#KK" xml:id="lem.9">Mert könyhullatásim el nyomoritottak</lem><rdg wit="#W2" xml:id="rdg.9">könyuhullatásim</rdg></app></l>
<l xml:id="l.47">Mint régen holt testet engem bé hanuaztak</l>
<l rend="level_2" xml:id="l.48">Vagy szalmát és kénkött éppen el fogyattak.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">108.</fw>
<lg xml:id="lg.13">
<l xml:id="l.49">Tengelicz éneke, Pintyöke sirása,</l>
<l rend="level_2" xml:id="l.50">Sziuem nélköl ollyan mint Baglyok Zugása,</l>
<l xml:id="l.51">Lengedezö szellök, czurgoknak folyása,</l>
<l rend="level_2" xml:id="l.52">Mint széluész haboru, és Pokol forrása.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">109.</fw>
<lg xml:id="lg.14">
<l xml:id="l.53"><app xml:id="app.10"><lem wit="#KK" xml:id="lem.10">Ô Fatum! nem használ én könyhullatásom</lem><rdg wit="#W2" xml:id="rdg.10"><del>az</del> én</rdg></app></l>
<l rend="level_2" xml:id="l.54">Nem használ tenállad utánnad iárásom</l>
<l xml:id="l.55">Kegyetlen iai mikent emészt én sirásom</l>
<l rend="level_2" xml:id="l.56"><app xml:id="app.11">
<lem wit="#KK" xml:id="lem.11">Nem könyörülsz nem szánsz ihon ki mulásom.</lem>
<rdg wit="#W2" xml:id="rdg.11"> <note type="critic" xml:id="note.1">49–56 E két szakasz fordított sorrendben.</note></rdg>
</app></l>
</lg>
<fw corresp="Esterházy Pál" type="lg">110.</fw>
<lg xml:id="lg.15">
<l xml:id="l.57">Igy uégezé uersét busult szerelemben</l>
<l rend="level_2" xml:id="l.58">Egy Ifiu, és czak nem esék kétségben</l>
<l xml:id="l.59">Az neuét nem irom ezen énekemben</l>
<l rend="level_2" xml:id="l.60"><app xml:id="app.12">
<lem wit="#KK" xml:id="lem.12">Mert Szép Diánátol tilalom uan ebben.</lem>
<rdg wit="#W2" xml:id="rdg.12"> <note type="critic" xml:id="note.2">57–60 A 140. szakasz változataként.</note></rdg>
</app></l>
</lg>
</div>
</body>
