<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 138.</fw>
<head type="title"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">ARIANA SIRÁSA ÉS KESERVES HALÁLA</lem><rdg wit="#W2" xml:id="rdg.1">Arianna historiáia.</rdg></app></head>
<fw corresp="Esterházy Pál" type="lg">156.</fw>
<lg xml:id="lg.1">
<l xml:id="l.1">Isten az embernek uezérli ö dolgát,</l>
<l xml:id="l.2">Megh iegyezte Isten mindennek hátárát,</l>
<l xml:id="l.3">Senki nem gondollya ö által hágását,</l>
<l xml:id="l.4">Nem fél, mégh nem láttya utolso romlását.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">157.</fw>
<lg xml:id="lg.2">
<l xml:id="l.5"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Egykor nylat uett uolt Cupido kezében</lem>
<rdg wit="#W2" xml:id="rdg.2">[Hiányzik.]</rdg>
</app></l>
<l xml:id="l.6"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">Theseus királynak kitt löne sziuében,</lem><rdg wit="#W2" xml:id="rdg.3">[Hiányzik.]</rdg></app></l>
<l xml:id="l.7"><app xml:id="app.4"><lem wit="#KK" xml:id="lem.4">Hogy Ariannának esnék szerelmében</lem><rdg wit="#W2" xml:id="rdg.4">[Hiányzik.]</rdg></app></l>
<l xml:id="l.8"><app xml:id="app.5"><lem wit="#KK" xml:id="lem.5">El feleithetlenöl uenné elméiében.</lem><rdg wit="#W2" xml:id="rdg.5">[Hiányzik.]</rdg></app></l>
</lg>
<fw corresp="Esterházy Pál" type="lg">158.</fw>
<lg xml:id="lg.3">
<l xml:id="l.9"><app xml:id="app.6"><lem wit="#KK" xml:id="lem.6">Mind kétt részröl éget már haragos nyla,</lem><rdg wit="#W2" xml:id="rdg.6">[Hiányzik.]</rdg></app></l>
<l xml:id="l.10"><app xml:id="app.7">
<lem wit="#KK" xml:id="lem.7">Sütötte sziueket megh emésztö lángia,</lem>
<rdg wit="#W2" xml:id="rdg.7">[Hiányzik.]</rdg>
</app></l>
<l xml:id="l.11"><app xml:id="app.8"><lem wit="#KK" xml:id="lem.8">Nyughatatlanná lön ékes Arianna</lem><rdg wit="#W2" xml:id="rdg.8">[Hiányzik.]</rdg></app></l>
<l xml:id="l.12"><app xml:id="app.9"><lem wit="#KK" xml:id="lem.9">Czak szép Theseussát mindenkor ohaitya.</lem><rdg wit="#W2" xml:id="rdg.9">[Hiányzik.]</rdg></app></l>
</lg>
<fw corresp="Esterházy Pál" type="lg">159.</fw>
<lg xml:id="lg.4">
<l xml:id="l.13"><app xml:id="app.10"><lem wit="#KK" xml:id="lem.10">Alnok kis Cupido megh ueté háloiát,</lem><rdg wit="#W2" xml:id="rdg.10">[Hiányzik.]</rdg></app></l>
<l xml:id="l.14"><app xml:id="app.11"><lem wit="#KK" xml:id="lem.11">Gyorsasággal uéuén elöl ö keziját,</lem><rdg wit="#W1" xml:id="rdg.11">[Előbb:] szép keziját,</rdg><rdg wit="#W2" xml:id="rdg.12">[Hiányzik.]</rdg></app></l>
<l xml:id="l.15"><app xml:id="app.12">
<lem wit="#KK" xml:id="lem.12">Szép Ariánában löui sebes nylát,</lem>
<rdg wit="#W2" xml:id="rdg.13">[Hiányzik.]</rdg>
</app></l>
<l xml:id="l.16"><app xml:id="app.13"><lem wit="#KK" xml:id="lem.13">Ily modon czalá megh édes királynéiát.</lem><rdg wit="#W2" xml:id="rdg.14">[Hiányzik.]</rdg></app></l>
</lg>
<fw corresp="Esterházy Pál" type="lg">160.</fw>
<lg xml:id="lg.5">
<l xml:id="l.17">Tebrusnak uizénél az Szép Ariana</l>
<l xml:id="l.18"><app xml:id="app.14"><lem wit="#KK" xml:id="lem.14">Nyugszik uala egykor gyonge nyoszolába</lem><rdg wit="#W2" xml:id="rdg.15">nyoszolába<del>n</del></rdg></app></l>
<l xml:id="l.19">Mert Cupido mutat örömöt álmába,</l>
<l xml:id="l.20">Aszt tugya hogy fegszik Theseus ágyába.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">161.</fw>
<lg xml:id="lg.6">
<l xml:id="l.21">De Fülemilének ékes szollásáual</l>
<l xml:id="l.22">Föl zöndült elméie igen gyorsasággal,</l>
<l xml:id="l.23"><app xml:id="app.15"><lem wit="#KK" xml:id="lem.15">Föl nitá szép szemét látá hogy szép Hainal</lem><rdg wit="#W2" xml:id="rdg.16">Fel nitá (...) láttya</rdg></app></l>
<l xml:id="l.24"><app xml:id="app.16"><lem wit="#KK" xml:id="lem.16">Elöl iün röbdözue harmatos szárnyáual.</lem><rdg wit="#W2" xml:id="rdg.17">röbdösue</rdg></app></l>
</lg>
<fw corresp="Esterházy Pál" type="lg">162.</fw>
<lg xml:id="lg.7">
<l xml:id="l.25">Ölelni keuánuan Theseus szerelmét</l>
<l xml:id="l.26">Gyöngén tapogatua uiszi ágyba kezét</l>
<l xml:id="l.27"><app xml:id="app.17"><lem wit="#KK" xml:id="lem.17">De mást ott nem talál, czak ö üres helyét,</lem><rdg wit="#W2" xml:id="rdg.18">De semmit nem talál,</rdg></app></l>
<l xml:id="l.28">Megh hidegült ágyát, és keserues ielét.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">163.</fw>
<lg xml:id="lg.8">
<l xml:id="l.29"><app xml:id="app.18"><lem wit="#KK" xml:id="lem.18">Ott mingyárt el áiul, de sokára megh tér,</lem><rdg wit="#W2" xml:id="rdg.19">de elmeie megh tér,</rdg></app></l>
<l xml:id="l.30"><app xml:id="app.19">
<lem wit="#KK" xml:id="lem.19">Szomoru sziuéröl hogy el oszlék az uér,</lem>
<rdg wit="#W2" xml:id="rdg.20">Mihelyen el oszlék sziuéröl az szép uér,</rdg>
</app></l>
<l xml:id="l.31">Agyábul ki futni mert meztelenis mér</l>
<l xml:id="l.32"><app xml:id="app.20"><lem wit="#KK" xml:id="lem.20">Társát nem találuán ágyához uiszá tér.</lem><rdg wit="#W2" xml:id="rdg.21">Keres, de nem talál, és ismét ö bé tér.</rdg></app></l>
</lg>
<fw corresp="Esterházy Pál" type="lg">164.</fw>
<lg xml:id="lg.9">
<l xml:id="l.33">Üti feiér mellyét, szaggattya szép haiát</l>
<l xml:id="l.34">Theseus szerelmem nagy eröuel kiátt,</l>
<l xml:id="l.35">Ki fut Tebrus partra, ki maga folyását</l>
<l xml:id="l.36">Tengerben adoul önti hamarságát.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">165.</fw>
<lg xml:id="lg.10">
<l xml:id="l.37">Az Tengeren szemét széllyel el forgattya</l>
<l xml:id="l.38">Az partot üressen emberektöl láttya</l>
<l xml:id="l.39">És semminek másnak szauát nem halhattya</l>
<l xml:id="l.40">Czak Echonak, kinek kösziklán lakása.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">166.</fw>
<lg xml:id="lg.11">
<l xml:id="l.41">De ezis bánattal szol Arianának</l>
<l xml:id="l.42">Czinál öregbülést uálaszal buiának</l>
<l xml:id="l.43">Mert ha ö panaszol, szol az kösziklának,</l>
<l xml:id="l.44"><app xml:id="app.21"><lem wit="#KK" xml:id="lem.21">Echo bus uálaszal neuet bánattyának.</lem><rdg wit="#W2" xml:id="rdg.22">uálasztal</rdg></app></l>
</lg>
<fw corresp="Esterházy Pál" type="lg">167.</fw>
<lg xml:id="lg.12">
<l xml:id="l.45">De im az sötétben egy szép haiot láta,</l>
<l xml:id="l.46"><app xml:id="app.22"><lem wit="#KK" xml:id="lem.22">Dagat uitorláiát hogy könyü szél haitya,</lem><rdg wit="#W2" xml:id="rdg.23">könnyü</rdg></app></l>
<l xml:id="l.47">Theseus ismétlen Theseus kiáltya</l>
<l xml:id="l.48">De amaz nem hallya mert nemis halhattya.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">168.</fw>
<lg xml:id="lg.13">
<l xml:id="l.49">Int, és uiszá hija gyönge kezeiuel,</l>
<l xml:id="l.50">De az haiot uiszi nagy szél sebességgel,</l>
<l xml:id="l.51"><app xml:id="app.23"><lem wit="#KK" xml:id="lem.23">El késéri uégig könyues szemeiuel,</lem><rdg wit="#W2" xml:id="rdg.24">Arianna késér uégig szemeiuel,</rdg></app></l>
<l xml:id="l.52">Haio szeme elött mégh Tengeren tün el.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">169.</fw>
<lg xml:id="lg.14">
<l xml:id="l.53"><app xml:id="app.24"><lem wit="#KK" xml:id="lem.24">Akkor le szaggattya szép aranyas haiát,</lem><rdg wit="#W2" xml:id="rdg.25">aranyos</rdg></app></l>
<l xml:id="l.54">Körömzéli kézzel gyönyörü orczáiát</l>
<l xml:id="l.55"><app xml:id="app.25">
<lem wit="#KK" xml:id="lem.25">Ott nem mesze szemlélt egy magas kösziklát</lem>
<rdg wit="#W2" xml:id="rdg.26">kü sziklát,</rdg>
</app></l>
<l xml:id="l.56">Föl hág rá, s-Tengernek igy kezdi panaszát.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">170.</fw>
<lg xml:id="lg.15">
<l xml:id="l.57">Oh! én szerenczétlen már el töröt kobzom,</l>
<l xml:id="l.58">Bizonittya igyemet el pöndült hurom</l>
<l xml:id="l.59"><app xml:id="app.26"><lem wit="#KK" xml:id="lem.26">Roszul éltet engem keserues Világom</lem><rdg wit="#W2" xml:id="rdg.27">Eltet ugyan engem keserü uilágom,</rdg></app></l>
<l xml:id="l.60"><app xml:id="app.27">
<lem wit="#KK" xml:id="lem.27">Mert el mult én töllem gyönyörü Virágom.</lem>
<rdg wit="#W2" xml:id="rdg.28">De uilágtalanságh ez elö uilágom.</rdg>
</app></l>
</lg>
<fw corresp="Esterházy Pál" type="lg">171.</fw>
<lg xml:id="lg.16">
<l xml:id="l.61">De nem ragatt senki más Theseus téged,</l>
<l xml:id="l.62">Czak Cupido az te nagy hitetlenséged</l>
<l xml:id="l.63">Hon uan kit mutattál az te ékes képed,</l>
<l xml:id="l.64"><app xml:id="app.28"><lem wit="#KK" xml:id="lem.28">Talám uitorláddal szélnek eresztetted.</lem><rdg wit="#W2" xml:id="rdg.29">Talán (...) éresztetted.</rdg></app></l>
</lg>
<fw corresp="Esterházy Pál" type="lg">172.</fw>
<lg xml:id="lg.17">
<l xml:id="l.65">Kin szerzö Cupido keményeb uagy ércznél,</l>
<l xml:id="l.66">El mentél kegyetlen, el mentél mint gyors szél,</l>
<l xml:id="l.67">Engemet bus sziuben, és gyázban keuertél</l>
<l xml:id="l.68">Sött örök halálban éppen el temettél.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">173.</fw>
<lg xml:id="lg.18">
<l xml:id="l.69">De ha haiod ottan lelkemet hordozza</l>
<l xml:id="l.70">Mért hogy testemetis magáual nem huzza</l>
<l xml:id="l.71">Nem oly nehéz el hidd ez az Ariana</l>
<l xml:id="l.72">Hogy te fényes haiod ily terhet ne birna.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">174.</fw>
<lg xml:id="lg.19">
<l xml:id="l.73">Mért nékem nem attál sziuet és tanáczot,</l>
<l xml:id="l.74">Ki után láthattam uolna ez Világot,</l>
<l xml:id="l.75">Ah! miért nem czaptad nyakamban az kardot,</l>
<l xml:id="l.76"><app xml:id="app.29"><lem wit="#KK" xml:id="lem.29">Ám czináltad uolna elöb koporsomot.</lem><rdg wit="#W2" xml:id="rdg.30">Czináltad uolna
                        megh elöb</rdg></app></l>
</lg>
<fw corresp="Esterházy Pál" type="lg">175.</fw>
<lg xml:id="lg.20">
<l xml:id="l.77">Bizol Országodban hogy mensz triumphussal,</l>
<l xml:id="l.78"><app xml:id="app.30"><lem wit="#KK" xml:id="lem.30">Gondolod hogy uagy már böuelkedö iokkal,</lem><rdg wit="#W2" xml:id="rdg.31">ioual,</rdg></app></l>
<l xml:id="l.79">De iai! tudom bizony Theseusis megh hal,</l>
<l xml:id="l.80">Ha megh tugya Társa el ueszet mi moddal.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">176.</fw>
<lg xml:id="lg.21">
<l xml:id="l.81">Az én könyuem áruiz, és Tenger bánatom</l>
<l xml:id="l.82">Magamat immáron czak aligh állatom,</l>
<l xml:id="l.83">Mert töb bu uér engem, aszt igazán látom,</l>
<l xml:id="l.84">Hogy sem hab kösziklát. Im szörnyü halálom.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">177.</fw>
<lg xml:id="lg.22">
<l xml:id="l.85">Ez szok után bátran az szép Arianá</l>
<l xml:id="l.86">Magas kösziklárol magát le boczátá,</l>
<l xml:id="l.87">Egy szempillantásban az hab el buritá</l>
<l xml:id="l.88">Ez szép drága Rosát szerelem igy rontá.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">178.</fw>
<lg xml:id="lg.23">
<l xml:id="l.89">Ô mely gyakran uelem kis Cupido mulat,</l>
<l xml:id="l.90">Keserüt édesset mind egyaránt mutat,</l>
<l xml:id="l.91">Mulasson bár uelem, anyt nem tréfálhat,</l>
<l xml:id="l.92">Hogy iol ne ismériem magáual mit hozhat.</l>
</lg>
</div>
</body>
</text>
</TEI>