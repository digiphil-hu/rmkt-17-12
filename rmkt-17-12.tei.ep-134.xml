<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 134.</fw>
<head type="title"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">BARÁTYÁNAK BETEGSÉGÉRÖL VALO ÉNEK</lem><rdg wit="#W2" xml:id="rdg.1">Egy kis Szomoru Enek Baráttyának betegségéröl.</rdg></app></head>
<fw corresp="Esterházy Pál" type="lg">85.</fw>
<lg xml:id="lg.1">
<l xml:id="l.1">Ôh! edes Istenem</l>
<l xml:id="l.2">Néked mitt miueltem</l>
<l rend="level_2" xml:id="l.3"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Hogy igy megh rontál engem.</lem><rdg wit="#W2" xml:id="rdg.2">megh uertél</rdg></app></l>
<l xml:id="l.4">De ha én uétettem</l>
<l xml:id="l.5"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">Mért nem uértél engem</lem><rdg wit="#W2" xml:id="rdg.3">rontál</rdg></app></l>
<l rend="level_2" xml:id="l.6">Más eset betegségben.</l>
<l xml:id="l.7">De te itéleted</l>
<l xml:id="l.8">Bölcz elmélkedésed</l>
<l rend="level_2" xml:id="l.9">Maragyon diczöségben.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">86.</fw>
<lg xml:id="lg.2">
<l xml:id="l.10">Ha én uétkeimet,</l>
<l xml:id="l.11">Czelekedetimet</l>
<l rend="level_2" xml:id="l.12">Ösmérem büneimet</l>
<l xml:id="l.13">Ostorozz engemet</l>
<l xml:id="l.14">Mért rosz erkölczemet</l>
<l rend="level_2" xml:id="l.15">Artatlanon bünteted.</l>
<l xml:id="l.16">Kérlek ne czeleked,</l>
<l xml:id="l.17">Bünösre ted kezed</l>
<l rend="level_2" xml:id="l.18">Mert az uétet tenéked.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">87.</fw>
<lg xml:id="lg.3">
<l xml:id="l.19">Miuel én uétettem</l>
<l xml:id="l.20">Bünt ellened tettem</l>
<l rend="level_2" xml:id="l.21">Ne báncz mást én Istenem</l>
<l xml:id="l.22">Mert én czelekettem</l>
<l xml:id="l.23">Érte el szenuedem</l>
<l rend="level_2" xml:id="l.24">Büntes én Vram engem.</l>
<l xml:id="l.25">En uagyok az bünös</l>
<l xml:id="l.26">Ki miattis büdös</l>
<l rend="level_2" xml:id="l.27">Lelkem gonosz testemben.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">88.</fw>
<lg xml:id="lg.4">
<l xml:id="l.28">Sok io uitézeket</l>
<l xml:id="l.29">Erös embereket</l>
<l rend="level_2" xml:id="l.30">Verél egynek uétkeiért.</l>
<l xml:id="l.31">Hatalmas Persákat</l>
<l xml:id="l.32">Vitéz Medusokat</l>
<l rend="level_2" xml:id="l.33">Nagy testu Indusokat</l>
<l xml:id="l.34">Mert téged utáltak</l>
<l xml:id="l.35">S-ottan nem szolgáltak</l>
<l rend="level_2" xml:id="l.36">Világi mulandoiért.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">89.</fw>
<lg xml:id="lg.5">
<l xml:id="l.37">Izraëlt Dauidért</l>
<l xml:id="l.38">Samsont részegségért</l>
<l rend="level_2" xml:id="l.39">Sodomát buiaságért,</l>
<l xml:id="l.40">Romát Pogányságért</l>
<l xml:id="l.41">Canant Pharaoért</l>
<l rend="level_2" xml:id="l.42">Vilagotis bünökért</l>
<l xml:id="l.43">Salamont Aszonyért</l>
<l xml:id="l.44">Mástis más uétkéért</l>
<l rend="level_2" xml:id="l.45">Vgy mint bünös feiemért.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">90.</fw>
<lg xml:id="lg.6">
<l xml:id="l.46">Kész uagyok Istenem</l>
<l xml:id="l.47">Én eleget tennem</l>
<l rend="level_2" xml:id="l.48">Más ne szenuegyen értem</l>
<l xml:id="l.49">Sött ha néked teczem,</l>
<l xml:id="l.50">Kész uagyok nem élnem</l>
<l rend="level_2" xml:id="l.51">Erte halált szenuednem.</l>
<l xml:id="l.52">Büntess inkáb engem</l>
<l xml:id="l.53"><app xml:id="app.4"><lem wit="#KK" xml:id="lem.4">Tudod én uétettem</lem><rdg wit="#W2" xml:id="rdg.4">uétkeztem</rdg></app></l>
<l rend="level_2" xml:id="l.54">Magamban megh ösmérem.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">91.</fw>
<lg xml:id="lg.7">
<l xml:id="l.55">De te irgalmadban</l>
<l xml:id="l.56">És nagy io uoltodban</l>
<l rend="level_2" xml:id="l.57">Soha nem kételkettem</l>
<l xml:id="l.58">Bizom hogy uégtére</l>
<l xml:id="l.59">En bum nagy örömre</l>
<l rend="level_2" xml:id="l.60">Fordul, s-lészesz mellettem,</l>
<l xml:id="l.61">Mert ki benned bizik</l>
<l xml:id="l.62">Megh nem fogyatkozik</l>
<l rend="level_2" xml:id="l.63">Mindenkoron éneklem.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">92.</fw>
<lg xml:id="lg.8">
<l xml:id="l.64">Reméllem barátom</l>
<l xml:id="l.65">Én szép ágyas Társom</l>
<l rend="level_2" xml:id="l.66">Leszen io egésségben</l>
<l xml:id="l.67">Agya az nagy Isten</l>
<l xml:id="l.68"><app xml:id="app.5"><lem wit="#KK" xml:id="lem.5">Kiben uagyon minden</lem><rdg wit="#W2" xml:id="rdg.5">Kinél</rdg></app></l>
<l rend="level_2" xml:id="l.69"><app xml:id="app.6"><lem wit="#KK" xml:id="lem.6">Lehessünk eg<corr>ye</corr>sségben</lem><rdg wit="#W1" xml:id="rdg.6">egésségben<note type="critic" xml:id="note.1">Téves szóismétlés.</note></rdg><rdg wit="#W2" xml:id="rdg.7">egyességben</rdg></app></l>
<l xml:id="l.70">Szent neuét áldhassuk</l>
<l xml:id="l.71">Holtunk után lássuk</l>
<l rend="level_2" xml:id="l.72">Örökös békességben.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">93.</fw>
<lg xml:id="lg.9">
<l xml:id="l.73">Ô mely nehéz látnom</l>
<l xml:id="l.74">Egésségét uárnom</l>
<l rend="level_2" xml:id="l.75">Szerelmes Barátomnak</l>
<l xml:id="l.76">Mert czak aligh uárnám</l>
<l xml:id="l.77">Hogy immár láthatnám</l>
<l rend="level_2" xml:id="l.78"><app xml:id="app.7"><lem wit="#KK" xml:id="lem.7">Könyebségét Iauamnak,</lem><rdg wit="#W2" xml:id="rdg.8">Mátkámnak,</rdg></app></l>
<l xml:id="l.79">El hittem Istenem</l>
<l xml:id="l.80">Ki uagy én reményem</l>
<l rend="level_2" xml:id="l.81">Iott acz uigasztalomnak.</l>
</lg>
<fw corresp="Esterházy Pál" type="lg">94.</fw>
<lg xml:id="lg.10">
<l xml:id="l.82"><app xml:id="app.8"><lem wit="#KK" xml:id="lem.8">Szomoruságh után</lem><rdg wit="#W2" xml:id="rdg.9">[Hiányzik.]</rdg></app></l>
<l xml:id="l.83"><app xml:id="app.9"><lem wit="#KK" xml:id="lem.9">Vagy betegségh után</lem><rdg wit="#W2" xml:id="rdg.10">[Hiányzik.]</rdg></app></l>
<l rend="level_2" xml:id="l.84"><app xml:id="app.10"><lem wit="#KK" xml:id="lem.10">Acz hiszem egésségét</lem><rdg wit="#W2" xml:id="rdg.11">[Hiányzik.]</rdg></app></l>
<l xml:id="l.85"><app xml:id="app.11"><lem wit="#KK" xml:id="lem.11">Az mint éhségh után</lem><rdg wit="#W2" xml:id="rdg.12">[Hiányzik.]</rdg></app></l>
<l xml:id="l.86"><app xml:id="app.12"><lem wit="#KK" xml:id="lem.12">Szoktál, s-pestis után</lem><rdg wit="#W2" xml:id="rdg.13">[Hiányzik.]</rdg></app></l>
<l rend="level_2" xml:id="l.87"><app xml:id="app.13"><lem wit="#KK" xml:id="lem.13">Adni io békességet.</lem><rdg wit="#W2" xml:id="rdg.14">[Hiányzik.]</rdg></app></l>
<l xml:id="l.88"><app xml:id="app.14"><lem wit="#KK" xml:id="lem.14">Nagy haboruk után</lem><rdg wit="#W2" xml:id="rdg.15">[Hiányzik.]</rdg></app></l>
<l xml:id="l.89"><app xml:id="app.15"><lem wit="#KK" xml:id="lem.15">S-ueszedelmek után</lem><rdg wit="#W2" xml:id="rdg.16">[Hiányzik.]</rdg></app></l>
<l rend="level_2" xml:id="l.90"><app xml:id="app.16"><lem wit="#KK" xml:id="lem.16">Nyuitani égyességet.</lem><rdg wit="#W2" xml:id="rdg.17">[Hiányzik.]</rdg></app></l>
</lg>
<fw corresp="Esterházy Pál" type="lg">95.</fw>
<lg xml:id="lg.11">
<l xml:id="l.91">Szerzé ez éneket</l>
<l xml:id="l.92">Szomoru uerseket</l>
<l rend="level_2" xml:id="l.93">Busultában egy bünös,</l>
<l xml:id="l.94">Mert uan reménsége</l>
<l xml:id="l.95">Ninczenis kétsége</l>
<l rend="level_2" xml:id="l.96"><app xml:id="app.17"><lem wit="#KK" xml:id="lem.17">Noha sziuében büdös,</lem><rdg wit="#W2" xml:id="rdg.18">[Előbb:] lelkében</rdg></app></l>
<l xml:id="l.97">Hogy megh uáltoztattya</l>
<l xml:id="l.98">Isten, s-megh iobbittya</l>
<l rend="level_2" xml:id="l.99">Lelkeben ki most rühös.</l>
</lg>
</div>
</body>
