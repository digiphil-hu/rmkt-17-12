<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 3.</fw>
<head type="title">MAAS EENEK</head>
<head type="notation">Ad Notam. Wssechmohauczy Vecznẏ boze etc</head>
<lg xml:id="lg.1">
<l xml:id="l.1"><hi rend="bold">C</hi>zendes Lelekkel dichiriuk</l>
<l xml:id="l.2">Miniaian az Attiát</l>
<l xml:id="l.3">Fiút szent Lelekkel egiűt</l>
<l xml:id="l.4">Zent haromsȧgh allȧttiȧt<note type="critic" xml:id="note.1">allȧttiȧt = valóságát, lényegét</note></l>
<l xml:id="l.5">Mert eö Feőlsege kegielmes</l>
<l xml:id="l.6">Es igen irgalmȧs</l>
<l xml:id="l.7">Mẏ reank nagi gondot vissel,</l>
<l xml:id="l.8">Oltalmaz kezewel</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.9"><hi rend="bold">O</hi> meli nielw azt mondhattna kÿ</l>
<l xml:id="l.10">Az te ió woltodot</l>
<l xml:id="l.11">Kit welűnk chelekessel</l>
<l xml:id="l.12">Teried<note type="critic" xml:id="note.2">= terjeszd</note> ránk aldassod</l>
<l xml:id="l.13">Vyczd<note type="critic" xml:id="note.3">olv. újítsd</note> minden koron eoket</l>
<l xml:id="l.14">Hogi szent Folsegedet</l>
<l xml:id="l.15">S. keressem, S-nem hadts benunket</l>
<l xml:id="l.16">Tewelliedet iuhodot</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.17"><hi rend="bold">B</hi>izonnial mondhattom enis</l>
<l xml:id="l.18">Hogi ez vton engem</l>
<l xml:id="l.19">Eoriztel es oltalmaztal</l>
<l xml:id="l.20">Chudalatos kepen</l>
<l xml:id="l.21">Wesedelmes Hellieken</l>
<l xml:id="l.22">Jssoniu Szeel wésben</l>
<l xml:id="l.23">Az te Akaratod szerint</l>
<l xml:id="l.24">Hordoztal igiemben.</l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.25"><hi rend="bold">O</hi> vram meli nagi gondot</l>
<l xml:id="l.26">Viszelteel én ream</l>
<l xml:id="l.27">Sárniaidȯt eiel nappal</l>
<l xml:id="l.28">Fedeztet eėn ream.</l>
<l xml:id="l.29">Ȯrdognek alnoksagatul</l>
<l xml:id="l.30">Es chialardsagatull</l>
<l xml:id="l.31">Oltalmaztal es Eoriztél</l>
<l xml:id="l.32">Hamis Tudomanitól</l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.33"><hi rend="bold">R</hi>egenten te meg igirted</l>
<l xml:id="l.34">Hogi el nem hádts minket</l>
<l xml:id="l.35">Ragalmazó nielwektőlis</l>
<l xml:id="l.36">Oltalmazod benűnket</l>
<l xml:id="l.37">O Iezus mi vduozitonk</l>
<l xml:id="l.38">Vtunkban vezerleőnk,</l>
<l xml:id="l.39">Ielen wagi szėnt kegielmeddel</l>
<l xml:id="l.40">Es nagi dichőseggel.</l>
</lg>
<lg xml:id="lg.6">
<l xml:id="l.41"><hi rend="bold">A</hi>zėrt kerlek maradgi velűnk</l>
<l xml:id="l.42">Mostis kegielmeddel.</l>
<l xml:id="l.43">Teriesd ream aldasodot</l>
<l xml:id="l.44">Nagi vdwosegemmel.</l>
<l xml:id="l.45">Legien dichiret te neked</l>
<l xml:id="l.46"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Ki iar S.keres weled</lem><rdg wit="#W1" xml:id="rdg.1"><del>S-</del> Ki iar</rdg></app></l>
<l xml:id="l.47">Neked áianlom lelkemet</l>
<l xml:id="l.48">Add meniben helliemet.</l>
</lg>
<lg xml:id="lg.7">
<l xml:id="l.49"><hi rend="bold">N</hi>e Vtali meg Vram engem</l>
<l xml:id="l.50">Szegeni Teremtėsed</l>
<l xml:id="l.51">Bochasd meg sok bűnőmet</l>
<l xml:id="l.52">S.Tisticz meg Velőmet</l>
<l xml:id="l.53">Mert én te benned ohaitok</l>
<l xml:id="l.54">Mindėn iótis Varok.</l>
<l xml:id="l.55">Hogi ennek vtannais</l>
<l xml:id="l.56">S.Tarcz meg te szolgadot.</l>
</lg>
<lg xml:id="lg.8">
<l xml:id="l.57"><hi rend="bold">N</hi>emis Tudok ollias embert</l>
<l xml:id="l.58">Vilag arniekaban</l>
<l xml:id="l.59">Hogi te el hadtad volna.</l>
<l xml:id="l.60">Ki bizöt az vrban.</l>
<l xml:id="l.61"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Esedezem een hitemmel</lem><rdg wit="#W1" xml:id="rdg.2">E<del rend="overwritten">z</del><add type="overwrite">s</add>edezem</rdg></app></l>
<l xml:id="l.62">Jó remenszegemmel</l>
<l xml:id="l.63">Meg mentes minden bw̋nőmtűll</l>
<l xml:id="l.64">Eórdőgnek Tőriteől</l>
</lg>
<lg xml:id="lg.9">
<l xml:id="l.65"><hi rend="bold">A</hi>zért en Vram Istenem.</l>
<l xml:id="l.66">Chelleked ėn velem</l>
<l xml:id="l.67">Az te igireted szerint</l>
<l xml:id="l.68">Ad szent lelket beleem</l>
<l xml:id="l.69">Hogi ez niomorult vilaghbol</l>
<l xml:id="l.70">Kőltőzem boldogul</l>
<l xml:id="l.71">Az te szent hailekodban</l>
<l xml:id="l.72">Mehessek be Szentűll.</l>
</lg>
</div>
