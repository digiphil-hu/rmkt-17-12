<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 105.</fw>
<head type="title">MAS ENEK</head>
<head type="subtitle">Deus propitius esto mihi peccatory</head>
<lg xml:id="lg.1">
<l xml:id="l.1">Az el mult esztendeök, megh nem tereö üdeök</l>
<l rend="level_5" xml:id="l.2">Fordulanak eszemben,</l>
<l rend="level_2" xml:id="l.3">Latvan büneimett, kikkel Jstenemett</l>
<l rend="level_5" xml:id="l.4">Bantottam eletemben,</l>
<l rend="level_2" xml:id="l.5">Teölleök megh remüllek, Uramhoz fordulek</l>
<l rend="level_5" xml:id="l.6">.S. jgy keönyeörgek szivemben.</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.7">Jsten ki kezetül .s. gondviselesetül</l>
<l rend="level_5" xml:id="l.8">Minden fügh .s. taplaltatik,</l>
<l rend="level_2" xml:id="l.9">Kerek feöld, magas egh, tengeri szelessegh</l>
<l rend="level_5" xml:id="l.10">Mozdul es forgattatik,</l>
<l rend="level_2" xml:id="l.11">Minden halal .s. elett, szerencze .s. teörtenett</l>
<l rend="level_5" xml:id="l.12">Teölle jgazgattatik.</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.13">Kegyelmes termeszett, ki mordon nem nezhett</l>
<l rend="level_5" xml:id="l.14">Az teöredelmes szüre,</l>
<l rend="level_2" xml:id="l.15">Ohaitasom hald meg, esetemett szánd megh,</l>
<l rend="level_5" xml:id="l.16">Ne ted keresem ferre,<note type="critic" xml:id="note.1">félre (Ugyanígy a 23. sorban is.)</note></l>
<l rend="level_2" xml:id="l.17">Mutasd jrgalmadatt, .s. bocziasd harmatodatt</l>
<l rend="level_5" xml:id="l.18">Ream, megh aszott füre.</l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.19">Bün fergetegeben, mintt hajos szel viszben</l>
<l rend="level_5" xml:id="l.20">Remültt lelkem hanyatik,</l>
<l rend="level_2" xml:id="l.21">Nagy veszelire szorultt, maid el vesz nyomorultt,</l>
<l rend="level_5" xml:id="l.22">Ha-nem gyamolittatik,</l>
<l rend="level_2" xml:id="l.23"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Ha te nem segited, szegeny<corr>t</corr> ferre veted,</lem><rdg wit="#W1" xml:id="rdg.1">szegeny</rdg></app></l>
<l rend="level_5" xml:id="l.24">Egyebhez nem bizhatik.</l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.25">Cziak te vagy remennye, keödben merültt fennye</l>
<l rend="level_5" xml:id="l.26">Altalad derülhett fel,</l>
<l rend="level_2" xml:id="l.27">El üzven homalliatt, reghi ragyaghvanniatt</l>
<l rend="level_5" xml:id="l.28">Kedvel virraszthattya fel,</l>
<l rend="level_2" xml:id="l.29">Szive czükkenttsege .s. holtt elevenseghe</l>
<l rend="level_5" xml:id="l.30">Altalad eledhett fel.</l>
</lg>
<lg xml:id="lg.6">
<l xml:id="l.31">Erdemlek büntetest .s. kemeny szamki vetestt</l>
<l rend="level_5" xml:id="l.32">Jgaz jtelletedbül,</l>
<l rend="level_2" xml:id="l.33">Mertt ellened vettem, .s. tilos uttra lepttem,</l>
<l rend="level_5" xml:id="l.34">Teörvenyes eösvenyedbül,</l>
<l rend="level_2" xml:id="l.35">De már vissza terttem, .s. boczianatott kerttem,</l>
<l rend="level_5" xml:id="l.36">Szany kegyelmessegedbül.</l>
</lg>
<lg xml:id="lg.7">
<l xml:id="l.37">Ha füled megh hajla, miheltt egy szott halla</l>
<l rend="level_5" xml:id="l.38">Kereszt fan az latortul,</l>
<l rend="level_2" xml:id="l.39">Lattvan teöredelmett, büne engedelmett</l>
<l rend="level_5" xml:id="l.40">Nyere tüled azontul,</l>
<l rend="level_2" xml:id="l.41">Halgas megh engemis, .s. keönyhitczed lelkemis</l>
<l rend="level_5" xml:id="l.42">Az erdemlett ostortul.</l>
</lg>
<lg xml:id="lg.8">
<l xml:id="l.43">Mondgyad, már megh szanttam, mertt eösmerttem .s. lattam</l>
<l rend="level_5" xml:id="l.44">Teöredelmett szivednek,</l>
<l rend="level_2" xml:id="l.45">Raitad keönyörülttem, el mostam .s. teörülttem</l>
<l rend="level_5" xml:id="l.46">Undoksagatt büneödnek,</l>
<l rend="level_2" xml:id="l.47">Lelked már megh szepültt, ruhaja el keszültt</l>
<l rend="level_5" xml:id="l.48">Menyei eörömednek.</l>
</lg>
<lg xml:id="lg.9">
<l xml:id="l.49">Kiertt enis aldastt nyujtok .s. halaadastt</l>
<l rend="level_5" xml:id="l.50">Neked, en Jstenemnek,</l>
<l rend="level_2" xml:id="l.51">Mondvan: legyen aldott, ki kegyelmett adott</l>
<l rend="level_5" xml:id="l.52">Szam ki vetett fejemnek,</l>
<l rend="level_2" xml:id="l.53">Hogy teöbbe ne vetczen, veled edgyett erttczen,</l>
<l rend="level_5" xml:id="l.54">Adgy oly ereött lelkemnek.</l>
</lg>
<lg xml:id="lg.10">
<l xml:id="l.55">Ezer hatt szaz utan hattvan kilencz folytan</l>
<l rend="level_5" xml:id="l.56"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Aratasi üdeökor,</lem><rdg wit="#W1" xml:id="rdg.2">[Előbb:] üdeöben</rdg></app></l>
<l rend="level_2" xml:id="l.57">Madarak zengesse .s. az vizek czeörgesse</l>
<l rend="level_5" xml:id="l.58">Fel serkenttven hainalkor,</l>
<l rend="level_2" xml:id="l.59">Az Vaágh vize parttyan egy fel neött keö sziklan</l>
<l rend="level_5" xml:id="l.60">Jgy imatkozam egykor.</l>
</lg>
</div>
</body>
