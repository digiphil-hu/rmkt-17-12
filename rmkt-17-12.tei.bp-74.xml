<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 74.</fw>
<head type="title">HOGY AZ ISTEN EGYEDÜL MAGA VERI AZ HADAKAT ÉS NEM EMBERI ERÖ
                    ÁLTAL</head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1">Seregek hadnagya,</l>
<l xml:id="l.2">S’ vitézek strásája,</l>
<l xml:id="l.3">Ki lakol az egekben,</l>
<l rend="level_2" xml:id="l.4">Onnét intesz, rendelsz</l>
<l xml:id="l.5">Es karodon viselsz,</l>
<l xml:id="l.6">Mert Ur vagy magas menyben:</l>
<l rend="level_2" xml:id="l.7">Aldod bátor szivel,</l>
<l xml:id="l.8">Harczhoz erös kézzel,</l>
<l xml:id="l.9">Ki harczol te nevedben.</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10">Mert egyedül Isten,</l>
<l xml:id="l.11">Ki vitézzé tészen:</l>
<l xml:id="l.12">Vehetsz eröt kezébül!</l>
<l rend="level_2" xml:id="l.13">Nem jün ö fegyverrel,</l>
<l xml:id="l.14">De csak tekintettel</l>
<l xml:id="l.15">Parancsol az egekbül,</l>
<l rend="level_2" xml:id="l.16">Nézi a’ sziveket,</l>
<l xml:id="l.17">Es nem az eröket,</l>
<l xml:id="l.18"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">Nem vér hadat kézijbul.</lem>
<rdg wit="#Wβ" xml:id="rdg.1">tegezbül</rdg>
</app></l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Méltó hát kegyelmét</lem>
<rdg wit="#W1" xml:id="rdg.2">kegyelmet</rdg>
<rdg wit="#W2 #W3 #W4" xml:id="rdg.3">kegielmét</rdg>
</app></l>
<l xml:id="l.20">Kérned segedelmét</l>
<l xml:id="l.21">Illy hatalmas vezérnek:</l>
<l rend="level_2" xml:id="l.22">Kitül áldást vehettsz,</l>
<l xml:id="l.23">Es romlást-is nyerhetsz,</l>
<l xml:id="l.24">Ha nem tettzel kedvének,</l>
<l rend="level_2" xml:id="l.25">Magasztal kit akar:</l>
<l xml:id="l.26"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3"><corr>Mást meg</corr> porba takar,</lem>
<rdg wit="#Wα" xml:id="rdg.4">Es mást</rdg>
<rdg wit="#W2" xml:id="rdg.5">Mast még</rdg>
</app></l>
<l xml:id="l.27">Nagy ereje kezének.</l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.28">Ellenség gyors lovát</l>
<l xml:id="l.29">Látván, s’ éles kardgyát</l>
<l xml:id="l.30"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4"><corr>Ne rettegjed</corr> szivedben,</lem>
<rdg wit="#Wα" xml:id="rdg.6">Ne rémüly-el</rdg>
<rdg wit="#W2" xml:id="rdg.7">Ne retegyed</rdg>
</app></l>
<l rend="level_2" xml:id="l.31">Fene párducz börit,</l>
<l xml:id="l.32">Tigris, s’ farkas szörit</l>
<l xml:id="l.33">Bátran nézzed mezöben,</l>
<l rend="level_2" xml:id="l.34">Alla kiáltása,</l>
<l xml:id="l.35">Dob, s’ trombita szava</l>
<l xml:id="l.36">Ne hasson füleidben.</l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.37">Algyu ropogása,</l>
<l xml:id="l.38">Mint ég csattogása</l>
<l xml:id="l.39">Rettenthetne szivedben,</l>
<l rend="level_2" xml:id="l.40">Sok sürü kopja,<note type="critic" xml:id="note.1">olv. kópia</note></l>
<l xml:id="l.41"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5">Ki-terült zászloja</lem>
<rdg wit="#W2" xml:id="rdg.8">Ki teriet</rdg>
</app></l>
<l xml:id="l.42">Háborithat elmédben,</l>
<l rend="level_2" xml:id="l.43">A’ sok festet pais,</l>
<l xml:id="l.44"><app xml:id="app.6">
<lem wit="#KK" xml:id="lem.6">Nyil hegyes vasa-is</lem>
<rdg wit="#W2" xml:id="rdg.9">vasis</rdg>
</app></l>
<l xml:id="l.45">Mit nem tüntet szemedben?</l>
</lg>
<lg xml:id="lg.6">
<l rend="level_2" xml:id="l.46">Dávid parittyával,<note type="critic" xml:id="note.2">Dávidnak Góliát felett
                            aratott győzelméről lásd <bibl>I. Sám. (I. Kir.) 12.</bibl> fejezetében.</note></l>
<l xml:id="l.47">Gedeon lámpással<note type="critic" xml:id="note.3">Gedeon győzelméről a mádianiták felett
                            vö. <bibl>Bír. 16, 16–21.</bibl></note></l>
<l xml:id="l.48">Ellenségit meg-gyözte,</l>
<l rend="level_2" xml:id="l.49">Az erös Sámson-is,<note type="critic" xml:id="note.4">Sámson győzelméről lásd
                            <bibl>Bír. 16, 15.</bibl></note></l>
<l xml:id="l.50">Csak szamár állal-is</l>
<l xml:id="l.51">Philisteust meg-verte,</l>
<l rend="level_2" xml:id="l.52"><app xml:id="app.7">
<lem wit="#KK" xml:id="lem.7">Sátorában Jahel</lem>
<rdg wit="#W2" xml:id="rdg.10">Satorban</rdg>
</app></l>
<l xml:id="l.53">Siserát vas szeggel</l>
<l xml:id="l.54">Az földre le-szegeszte.<note type="critic" xml:id="note.5">52–54 Jáhelről és Siseráról vö.
                            <bibl>Bír. 5, 17–22.</bibl></note></l>
</lg>
<lg xml:id="lg.7">
<l rend="level_2" xml:id="l.55">Mert az Ur volt vélek,</l>
<l xml:id="l.56">S’ bátorodott szivek;</l>
<l xml:id="l.57">Nem biztanak fegyverben,</l>
<l rend="level_2" xml:id="l.58">Mert hol Isten harczol,</l>
<l xml:id="l.59">Ott az pogány oszol,</l>
<l xml:id="l.60">Futnak s’ bujnak rejtekben,</l>
<l rend="level_2" xml:id="l.61">Vesznek azért gyakran,</l>
<l xml:id="l.62">Az kik biznak bátran</l>
<l xml:id="l.63">Magányos erejekben.</l>
</lg>
<lg xml:id="lg.8">
<l rend="level_2" xml:id="l.64"><app xml:id="app.8">
<lem wit="#KK" xml:id="lem.8"><corr>Most azért</corr> paisodat</lem>
<rdg wit="#Wα" xml:id="rdg.11">Mostan</rdg>
<rdg wit="#W2" xml:id="rdg.12">Most azért</rdg>
</app></l>
<l xml:id="l.65"><app xml:id="app.9">
<lem wit="#KK" xml:id="lem.9">Tisztitsd, s’ panczélodat</lem>
<rdg wit="#Wα" xml:id="rdg.13">s’ panczélodat,</rdg>
<rdg wit="#W2" xml:id="rdg.14">Téztécs pancsirodat</rdg>
</app></l>
<l xml:id="l.66"><app xml:id="app.10">
<lem wit="#KK" xml:id="lem.10"><corr>Keresd fel az ágy alól,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.15">Sisakod ved-le szegröl</rdg>
<rdg wit="#W2" xml:id="rdg.16">Keresd fel az agi alul</rdg>
</app></l>
<l rend="level_2" xml:id="l.67">Elesitsd kardodat,</l>
<l xml:id="l.68">S’ hizlallyad lovadat,</l>
<l xml:id="l.69">Fogd-ki az eke mellöl,</l>
<l rend="level_2" xml:id="l.70">Ne bizd magad másra,</l>
<l xml:id="l.71">Hogy ne jüj romlásra,</l>
<l xml:id="l.72">Hanem magad meny elöl.</l>
</lg>
<lg xml:id="lg.9">
<l rend="level_2" xml:id="l.73">Buzdullyon fel véred,</l>
<l xml:id="l.74">Terjezd régi hired,</l>
<l xml:id="l.75"><app xml:id="app.11">
<lem wit="#KK" xml:id="lem.11"><corr>Meg ne rettenj pogánytul,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.17">Ne retteny pogány hirtül</rdg>
<rdg wit="#W2" xml:id="rdg.18">Meg ne retteny Poganitul</rdg>
</app></l>
<l rend="level_2" xml:id="l.76">Te éles törödet,</l>
<l xml:id="l.77">S’ kemény fegyveredet</l>
<l xml:id="l.78">Hizlallyad Török vértül:</l>
<l rend="level_2" xml:id="l.79">Aldozzad rút vérét,</l>
<l xml:id="l.80">Nyisd-fel dögös erét,</l>
<l xml:id="l.81"><app xml:id="app.12">
<lem wit="#KK" xml:id="lem.12"><corr>Hogy légy áldott az Urtul.</corr></lem>
<rdg wit="#Wα" xml:id="rdg.19">Kérj segétséget égbül</rdg>
<rdg wit="#W2" xml:id="rdg.20">Hogy légy aldot az Urtul</rdg>
</app></l>
</lg>
<lg xml:id="lg.10">
<l rend="level_2" xml:id="l.82">Hazánk rontására,</l>
<l xml:id="l.83">S’ népünk rablására</l>
<l xml:id="l.84">Hogy az pogány készülne,</l>
<l rend="level_2" xml:id="l.85">Régi vitézeknek,</l>
<l xml:id="l.86">Scytiai vérnek</l>
<l xml:id="l.87">Irtam meg ne rettenne,</l>
<l rend="level_2" xml:id="l.88">Hanem régi Márshoz,</l>
<l xml:id="l.89">S’ hadakozo társhoz</l>
<l xml:id="l.90">Társul mellé sietne.<note type="critic" xml:id="note.6">82–90 A sorok
                        <persName>Zrínyi<idno type="ITIdata">Q247373</idno></persName> törökellenes agitációjára emlékeztetnek.
                        A hadakozó Mars vonatkozhatik <persName>Zrínyi Miklósra</persName>. Ha a
                            88. sor nem pusztán mitológiai sallang, ez a vers
                                    <persName>Beniczky<idno corresp="Beniczky Péter" type="ITIdata">Q41111</idno></persName> utolsó
                            írásai közül való.</note></l>
</lg>
</div>
</body>
</text>
