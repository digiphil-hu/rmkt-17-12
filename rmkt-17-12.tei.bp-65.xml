<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 65.</fw>
<head type="title"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">MÁS AZON TÖREDEL<corr>EMMEL</corr> VALO KÖNYÖRGÉS</lem>
<rdg wit="#W1" xml:id="rdg.1">töredelmességgel</rdg>
<rdg wit="#W2 #W3 #W4" xml:id="rdg.2">töredelemmel</rdg>
</app></head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1">Vedd eszedben szivem,</l>
<l xml:id="l.2">Ismérd kicsinységem</l>
<l xml:id="l.3">S’ meg gondollyad mi voltod,</l>
<l rend="level_2" xml:id="l.4"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Eltem gyenge üveg,</lem>
<rdg wit="#W3" xml:id="rdg.3">úszeg,</rdg>
<rdg wit="#W4" xml:id="rdg.4">üszeg,</rdg>
</app></l>
<l xml:id="l.5"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">S’ viz buborék süveg,</lem>
<rdg wit="#W3" xml:id="rdg.5">s’ üveg,</rdg>
</app></l>
<l xml:id="l.6">Mulik oránként napod,</l>
<l rend="level_2" xml:id="l.7">Elmém bujdos, lézzeng,</l>
<l xml:id="l.8"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4">Eltem <corr>kornyad</corr> s’ fötreng,<note type="critic" xml:id="note.1">kornyad s’ fötreng – a. m. betegen kókadozik és görcsben
                                    rángatódzik.</note></lem>
<rdg wit="#W1" xml:id="rdg.6">hervad</rdg>
<rdg wit="#W2 #W4" xml:id="rdg.7">kornyad</rdg>
<rdg wit="#W3" xml:id="rdg.8">marad</rdg>
</app></l>
<l xml:id="l.9">Hogy közel szám adásod.</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10">Könyvem mint viz árrad,</l>
<l xml:id="l.11">S’ minden tagom lankad,</l>
<l xml:id="l.12">Kétséggel foly reményem,</l>
<l rend="level_2" xml:id="l.13">Hogy éltem fesletség,</l>
<l xml:id="l.14">Idvességem kétség</l>
<l xml:id="l.15"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5">S’ csügg czérna szálon lelkem,</lem>
<rdg wit="#W2" xml:id="rdg.9">[A <hi rend="italic">lelkem</hi> hiányzik.]</rdg>
</app></l>
<l rend="level_2" xml:id="l.16">Mint merjem kezdeni,</l>
<l xml:id="l.17"><app xml:id="app.6">
<lem wit="#KK" xml:id="lem.6">S’ kegyelmedet kérni</lem>
<rdg wit="#W2" xml:id="rdg.10">s kelly elmedet</rdg>
</app></l>
<l xml:id="l.18">Bátran tölled Istenem?</l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19">Mert ha meg-gondolom,</l>
<l xml:id="l.20">Vagyok agyag halom,</l>
<l xml:id="l.21">S’ föld szennyebül valo por,</l>
<l rend="level_2" xml:id="l.22">Öt érzékenségem</l>
<l xml:id="l.23">Vesztette épségem,</l>
<l xml:id="l.24">Rontott ördögi tábor,</l>
<l rend="level_2" xml:id="l.25">Még-is sok haragra,</l>
<l xml:id="l.26">Ki vagy egek Ura,</l>
<l xml:id="l.27">Inditottalak sokszor.</l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.28">Holott az Angyalok,</l>
<l xml:id="l.29">S’ Mennyei szent Karok</l>
<l xml:id="l.30">Tisztelnek rettegéssel,</l>
<l rend="level_2" xml:id="l.31">Koronázot szüzek,</l>
<l xml:id="l.32">S’ boldogult seregek</l>
<l xml:id="l.33">Néznek nagy rémüléssel,</l>
<l rend="level_2" xml:id="l.34">Tenger háborodik,</l>
<l xml:id="l.35">Föld, s’ ég ingadozik</l>
<l xml:id="l.36"><app xml:id="app.7">
<lem wit="#KK" xml:id="lem.7">Elötted szörnyüséggel.</lem>
<rdg wit="#W2" xml:id="rdg.11">remuléssel</rdg>
</app></l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.37">Télben posvány szunyog,</l>
<l xml:id="l.38">S’ dongo légy sem bolyog,</l>
<l xml:id="l.39">El-bujnak reves fában,</l>
<l rend="level_2" xml:id="l.40">Csak a’ természettül,</l>
<l xml:id="l.41">S’ mulando idötül</l>
<l xml:id="l.42">Félnek ártatlanságban,</l>
<l rend="level_2" xml:id="l.43">Hát én mint rejtezzem,</l>
<l xml:id="l.44">S’ hogy bünöm fedezzem,</l>
<l xml:id="l.45">Ki vagyok nagy átokban?</l>
</lg>
<lg xml:id="lg.6">
<l rend="level_2" xml:id="l.46">Mert én mind ezeknél</l>
<l xml:id="l.47"><app xml:id="app.8">
<lem wit="#KK" xml:id="lem.8">Ocsmány<corr>abb légykénél</corr></lem>
<rdg wit="#Wα" xml:id="rdg.12">Ocsmányb a’ legyeknél</rdg>
<rdg wit="#W2" xml:id="rdg.13">Ocsmanyab Legykinel</rdg>
</app></l>
<l xml:id="l.48"><app xml:id="app.9">
<lem wit="#KK" xml:id="lem.9">Vagyok, gyarloságombul:</lem>
<rdg wit="#W2" xml:id="rdg.14">gyarlosagomban</rdg>
</app></l>
<l rend="level_2" xml:id="l.49">Epségböl vétkezett,<note type="critic" xml:id="note.2">olv.
                        vetkőzött</note></l>
<l xml:id="l.50">Sok bünnel fertözött</l>
<l xml:id="l.51">Vagyok indulatimbul,</l>
<l rend="level_2" xml:id="l.52">Ki nem merlek nézni,</l>
<l xml:id="l.53">Hová tudgyak bujni,</l>
<l xml:id="l.54">Ha üldösz haragodbul?</l>
</lg>
<lg xml:id="lg.7">
<l rend="level_2" xml:id="l.55">Régen Chóré, s’ Dátán,<note type="critic" xml:id="note.3">Chóré (Kóré) és
                            Dátán fellázadt Mózes és Áron ellen. Bűnhődésüket lásd <bibl>IV. Móz.
                                16, 1–33.</bibl></note></l>
<l xml:id="l.56"><app xml:id="app.10">
<lem wit="#KK" xml:id="lem.10">Ha kárhozott méltán,</lem>
<rdg wit="#Wβ" xml:id="rdg.15">Ha el-süllyett</rdg>
</app></l>
<l xml:id="l.57">Feddödvén csak Mosesre,</l>
<l rend="level_2" xml:id="l.58"><app xml:id="app.11">
<lem wit="#KK" xml:id="lem.11">Jaj nékem, kit szükség</lem>
<rdg wit="#W2" xml:id="rdg.16">kén sukségh</rdg>
</app></l>
<l xml:id="l.59"><app xml:id="app.12">
<lem wit="#KK" xml:id="lem.12">Szorongat sok inség,</lem>
<rdg wit="#W2" xml:id="rdg.17">Czak sorongat inség</rdg>
<rdg wit="#Wβ" xml:id="rdg.18">Szorongat s’ sok</rdg>
</app></l>
<l xml:id="l.60">Mint állyak itiletre?</l>
<l rend="level_2" xml:id="l.61">Mert én teremtömet,</l>
<l xml:id="l.62">Bántván Istenemet,</l>
<l xml:id="l.63">Mélto vagyok a’ tüzre!</l>
</lg>
<lg xml:id="lg.8">
<l rend="level_2" xml:id="l.64">Csak e’ reménségem:</l>
<l xml:id="l.65">Meg-esküdtél nékem,</l>
<l xml:id="l.66">Hogy nem örülsz vesztemen,</l>
<l rend="level_2" xml:id="l.67">Csak hogy szeresselek,</l>
<l xml:id="l.68">Es téged féllyelek,</l>
<l xml:id="l.69">Részes lészek véredben,</l>
<l rend="level_2" xml:id="l.70">Ha te nem biztatnál,</l>
<l xml:id="l.71">S’ illy szokkal nem szolnál,</l>
<l xml:id="l.72">Bizony esném kétségben.</l>
</lg>
<lg xml:id="lg.9">
<l rend="level_2" xml:id="l.73">Ne veszszek bünömben,</l>
<l xml:id="l.74">Im Uram elödben</l>
<l xml:id="l.75">Terjesztem vétkeimet,</l>
<l rend="level_2" xml:id="l.76">Itt sujtold és égesd,</l>
<l xml:id="l.77"><app xml:id="app.13">
<lem wit="#KK" xml:id="lem.13">S’ álnokságom üldözd</lem>
<rdg wit="#Wβ" xml:id="rdg.19">perseld</rdg>
</app></l>
<l xml:id="l.78">S’ ostorozzad testemet,</l>
<l rend="level_2" xml:id="l.79">Csak hogy holtom után</l>
<l xml:id="l.80">Nézhesselek méltán,</l>
<l xml:id="l.81">S’ fogadd hozzád lelkemet.</l>
</lg>
</div>
</body>
</text>
