<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 70.</fw>
<head type="title">AZ MENNYEI ÖRÖK BOLDOGSÁGNAK KÉVÁNÁSA</head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1">Örüly s’ vigadgy lelkem,</l>
<l xml:id="l.2">Jutott kévánt hirem,</l>
<l xml:id="l.3">Megyünk az Ur házában,</l>
<l rend="level_2" xml:id="l.4">Holott az Angyalok,</l>
<l xml:id="l.5">S’ mennyei Szent Karok</l>
<l xml:id="l.6">Bé vesznek társaságban,</l>
<l rend="level_2" xml:id="l.7">Mert nincs maradásod</l>
<l xml:id="l.8">S’ bizonyos szállásod</l>
<l xml:id="l.9">Ez nyomorult világban.</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10">Ott lészen szeretet,</l>
<l xml:id="l.11">Isteni dicséret,</l>
<l xml:id="l.12">Szentekkel nyájjaságod,</l>
<l rend="level_2" xml:id="l.13">Öröm, és dicsösség,</l>
<l xml:id="l.14">S’ állando békesség,</l>
<l xml:id="l.15">Ott várja nyugodalmod,</l>
<l rend="level_2" xml:id="l.16">A’ JESUS báránnyal,</l>
<l xml:id="l.17">Isteni látással</l>
<l xml:id="l.18">Bé telik kévánságod.</l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">Szent János <corr>messziről</corr><note type="critic" xml:id="note.1">János a Jelenések könyvében ír látomásairól.</note></lem>
<rdg wit="#Wα" xml:id="rdg.1">csak képbe</rdg>
<rdg wit="#W2" xml:id="rdg.2">meszszérul</rdg>
</app></l>
<l xml:id="l.20"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Nézte <corr>csak távolról</corr></lem>
<rdg wit="#W1 #W4" xml:id="rdg.3">s’ jelenésbe</rdg>
<rdg wit="#W3" xml:id="rdg.4">s-jelenségbe</rdg>
<rdg wit="#W2" xml:id="rdg.5">csak tavolrul</rdg>
</app></l>
<l xml:id="l.21">Menyországnak szépségét;</l>
<l rend="level_2" xml:id="l.22">El-olvadott szive,</l>
<l xml:id="l.23">S’ háborodott kedve,</l>
<l xml:id="l.24">Hogy látta ékességét,</l>
<l rend="level_2" xml:id="l.25">Elme fel nem éri,</l>
<l xml:id="l.26">Nyelv sem beszélheti</l>
<l xml:id="l.27">Ragyogo dicsösségét.</l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.28">Mint szarvas melegben</l>
<l xml:id="l.29">Siet folyo vizben,</l>
<l xml:id="l.30">Hogy oltsa szomjuságát,</l>
<l rend="level_2" xml:id="l.31">Kévánkozik lelkem</l>
<l xml:id="l.32">Hozzád ugy Istenem,</l>
<l xml:id="l.33">Enyhitsed fáratságát!</l>
<l rend="level_2" xml:id="l.34">Lézengö lelkemnek,</l>
<l xml:id="l.35">Szárnya szegett légynek</l>
<l xml:id="l.36">Mutasd-meg boldogságát.</l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.37"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">Miért hoszszabbodik,</lem>
<rdg wit="#W2" xml:id="rdg.6">Oh meirt</rdg>
</app></l>
<l xml:id="l.38">S’ életem vonódik</l>
<l xml:id="l.39"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4">Ez <corr>büz s dögös</corr> tömlöczben?</lem>
<rdg wit="#W1" xml:id="rdg.7">Ez dögös, büdös</rdg>
<rdg wit="#W2 #W3 #W4" xml:id="rdg.8">Ez büz s dögös</rdg>
</app></l>
<l rend="level_2" xml:id="l.40">Mert meg-unta lelkem</l>
<l xml:id="l.41">Bujdosását, s éltem</l>
<l xml:id="l.42">Ez csalárd, sötét völgyben,</l>
<l rend="level_2" xml:id="l.43">Ejjel s’ nappal csak sir,</l>
<l xml:id="l.44"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5">Ohayt, <corr>zokogva kér</corr>,</lem>
<rdg wit="#Wα" xml:id="rdg.9">mig arra bir</rdg>
<rdg wit="#W2" xml:id="rdg.10">zokodva kir</rdg>
</app></l>
<l xml:id="l.45"><app xml:id="app.6">
<lem wit="#KK" xml:id="lem.6">Vedd-bé a’ dicsösségben.</lem>
<rdg wit="#W1" xml:id="rdg.11">Vidd</rdg>
<rdg wit="#W2 #W3 #W4" xml:id="rdg.12">Vedd</rdg>
</app></l>
</lg>
<lg xml:id="lg.6">
<l rend="level_2" xml:id="l.46">Mert jobb ottan egy nap,</l>
<l xml:id="l.47">Hol irigység nem csap,</l>
<l xml:id="l.48">Mint itt ezer esztendö:</l>
<l rend="level_2" xml:id="l.49">Mert itt sok villongás,</l>
<l xml:id="l.50">Talál bú, s’ változás,</l>
<l xml:id="l.51">Látod minden veszendö,</l>
<l rend="level_2" xml:id="l.52">Hatalmas hatalom</l>
<l xml:id="l.53"><app xml:id="app.7">
<lem wit="#KK" xml:id="lem.7">Legyen <corr>nagy, mint</corr> halom,</lem>
<rdg wit="#Wα" xml:id="rdg.13">mint nagy</rdg>
<rdg wit="#W2" xml:id="rdg.14">nagy mint</rdg>
</app></l>
<l xml:id="l.54"><app xml:id="app.8">
<lem wit="#KK" xml:id="lem.8">De el-veszti <corr>jövendő</corr>.</lem>
<rdg wit="#Wα" xml:id="rdg.15">az idö</rdg>
<rdg wit="#W2" xml:id="rdg.16">iuvendö</rdg>
</app></l>
</lg>
<lg xml:id="lg.7">
<l rend="level_2" xml:id="l.55">Mondgyam Szent Dáviddal:</l>
<l xml:id="l.56">Uram vittél által</l>
<l xml:id="l.57">Engem vizen, és tüzön!</l>
<l rend="level_2" xml:id="l.58">Akkor áldgyon lelkem,</l>
<l xml:id="l.59">Es dicsirjen nyelvem,</l>
<l xml:id="l.60">Tégedet, szemtül szemben,</l>
<l rend="level_2" xml:id="l.61">Hogy szép forrás füre,</l>
<l xml:id="l.62">Az örök életre</l>
<l xml:id="l.63"><app xml:id="app.9">
<lem wit="#KK" xml:id="lem.9"><corr>Választottad én lelkem</corr>.</lem>
<rdg wit="#Wα" xml:id="rdg.17">Vivén vetted kezedben</rdg>
<rdg wit="#W2" xml:id="rdg.18">Valastodtad én lelkem</rdg>
</app></l>
</lg>
<lg xml:id="lg.8">
<l rend="level_2" xml:id="l.64">Örüly te-is testem,</l>
<l xml:id="l.65">Noha bünben estem,</l>
<l xml:id="l.66"><app xml:id="app.10">
<lem wit="#KK" xml:id="lem.10"><corr>El</corr> nem vesz<corr>el</corr> az földben,</lem>
<rdg wit="#Wα" xml:id="rdg.19">De el nem veszsz</rdg>
<rdg wit="#W2" xml:id="rdg.20">El nem veszel</rdg>
</app></l>
<l rend="level_2" xml:id="l.67">Mint a’ szép buza mag,</l>
<l xml:id="l.68">Hogy földben el nem agg,</l>
<l xml:id="l.69">Ki-ujjul ki-keletben,</l>
<l rend="level_2" xml:id="l.70">Igy te-is hamubol</l>
<l xml:id="l.71">Fel-támadsz az porbul,</l>
<l xml:id="l.72">Vigadsz örök életben.</l>
</lg>
<lg xml:id="lg.9">
<l rend="level_2" xml:id="l.73">Im azért kezedben</l>
<l xml:id="l.74">Ajánlom mindenben</l>
<l xml:id="l.75">Néked Uram magamot,</l>
<l rend="level_2" xml:id="l.76">Ha tetszik kedvednek,</l>
<l xml:id="l.77">Mutasd-meg lelkemnek</l>
<l xml:id="l.78"><app xml:id="app.11">
<lem wit="#KK" xml:id="lem.11"><corr>S add meg boldogságát</corr>,</lem>
<rdg wit="#Wα" xml:id="rdg.21">Szined s’ adgy boldogságot</rdg>
<rdg wit="#W2" xml:id="rdg.22">S add meg boldogsagat</rdg>
</app></l>
<l rend="level_2" xml:id="l.79"><app xml:id="app.12">
<lem wit="#KK" xml:id="lem.12"><corr>Ez kis</corr> könyörgésem</lem>
<rdg wit="#Wα" xml:id="rdg.23">Égben</rdg>
<rdg wit="#W2" xml:id="rdg.24">Ez kis</rdg>
</app></l>
<l xml:id="l.80">Had jusson elödben,</l>
<l xml:id="l.81">Ne nézd gyarloságomat.</l>
</lg>
</div>
</body>
</text>
