<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 109.</fw>
<head type="title">ALIUD</head>
<lg xml:id="lg.1">
<l xml:id="l.1"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Kegies Kup<corr>i</corr>donak bizonjos tegzeim,</lem><rdg wit="#W1" xml:id="rdg.1"><del rend="overwritten">K</del><add type="corr">C</add>upodonak</rdg></app></l>
<l xml:id="l.2"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Venus rosa<corr>i</corr>val viragzo <sic>neuejm</sic>,</lem><rdg wit="#W1" xml:id="rdg.2">rosaval; <note type="critic" xml:id="note.1">2–3 A sorok rendje fordított volt, Balassa számozással javította.</note></rdg></app></l>
<l xml:id="l.3"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">Ki miat ujulnak si<corr>ue</corr>mbe sebeim,</lem><rdg wit="#W1" xml:id="rdg.3">uju<del rend="overwritten">d</del><add type="overwrite">l</add>na<del rend="overwritten">n</del><add type="overwrite">k</add>;<note type="critic" xml:id="note.2">Az eredeti szó olvasata bizonytalan: <hi rend="italic">ujudonan</hi>?</note> siusembe; <note type="critic" xml:id="note.3">2–3 A sorok
                        rendje fordított volt, Balassa számozással javította.</note></rdg></app></l>
<l xml:id="l.4">Seretlek de tijs legietek hiveim,</l>
<l xml:id="l.5">Minden viragnal seb eleven kerteim.</l>
</lg>
</div>
</body>
