<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 53.</fw>
<head type="title"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">AZ EN SZUVEM GIONIORKODTETŐ SZERELMESSEM EKES SZEMELIENEK KEDUES
                    JRASSARA VALO VALAS TETELE.</lem><rdg wit="#W1" xml:id="rdg.1">Sz Szemelienek; <del>V</del><add type="corr">T</add>etele</rdg></app></head>
<lg xml:id="lg.1">
<l xml:id="l.1">Ercznel, kö sziklanál</l>
<l xml:id="l.2">Kemenibnek valhatnál,<note type="critic" xml:id="note.1"><persName>Radvánszkynak<idno type="ITIdata">Q149913</idno></persName>
<hi rend="italic">Keményebbnek</hi> olvasata rossz.</note></l>
<l xml:id="l.3">Ha neked nem felelnek,</l>
<l xml:id="l.4">Es minden Irt betẅt,</l>
<l xml:id="l.5">Ki elmedbul merűlt,</l>
<l xml:id="l.6">Ha io Sziuel nem Vennek,</l>
<l xml:id="l.7">Sȯt ha Sas lehetnek,</l>
<l xml:id="l.8">S. moddal Indulhatnek,</l>
<l xml:id="l.9">Mingiart hozad rőpűlnek.</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.10">Wettem leweledet,</l>
<l xml:id="l.11">Abban Szerelmedet,</l>
<l xml:id="l.12">Kit nekem aianl keduet,<note type="critic" xml:id="note.2">kedved</note></l>
<l xml:id="l.13">Adodís ertenem,</l>
<l xml:id="l.14"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Tole<corr>d</corr> el Jottelem,</lem><rdg wit="#W1" xml:id="rdg.2">Tölem <note type="critic" xml:id="note.3">Értelmileg jav.</note></rdg></app></l>
<l xml:id="l.15">Mind uiult megh<note type="critic" xml:id="note.4">uiult megh - <persName>Radvánszky<idno type="ITIdata">Q149913</idno></persName><hi rend="italic"> nyult
                                meg</hi> olvasata téves</note> keszerwed,</l>
<l xml:id="l.16">Keėrs, hogi hozad teriek,</l>
<l xml:id="l.17">De mẏgh az less, kerlek,</l>
<l xml:id="l.18">Es<note type="critic" xml:id="note.5">olv. ez</note> kis valassomat Ved.</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.19">Gonoz Szerenchienek</l>
<l xml:id="l.20"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">Bu<corr>ká</corr>ssat embernek</lem>
<rdg wit="#W1" xml:id="rdg.3"><sic>Bochiassat</sic></rdg>
</app></l>
<l xml:id="l.21">Nem mindenkor tarthatiuk;</l>
<l xml:id="l.22">Ha főldre essessét</l>
<l xml:id="l.23">Es tagia toresséét</l>
<l xml:id="l.24">Abban mi nem lathattiuk,</l>
<l xml:id="l.25">De hogi az niawallias,</l>
<l xml:id="l.26">Kit el hagi kedues tars,</l>
<l xml:id="l.27">Igen bizonithattiuk.</l>
</lg>
</div>
</body>
</text>
