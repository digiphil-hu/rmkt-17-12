<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 31.</fw>
<head type="motto"><l xml:id="l.1">Vtere quesitis opibus fuge nomen auari</l>
<l xml:id="l.2">Quid tibi diuitiae prosunt si pauper abundas.</l></head>
<lg xml:id="lg.1">
<l xml:id="l.3">Elÿ marhadbul szepen masznak hasznara.</l>
<l xml:id="l.4">Magadnak hogi eszék lelked Jawara</l>
<l xml:id="l.5">Ne legien Vagiászod nagi vzorara.</l>
<l xml:id="l.6"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Tested ne veteszék errete nagj bura</lem><rdg wit="#W1" xml:id="rdg.1">errete <del>pogolra</del> <add type="insert">nagj</add></rdg></app></l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.7"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Mẏ haszon az Szok giuteőt gazdagszagnak.</lem>
<rdg wit="#W1" xml:id="rdg.2">haszon <del>az</del>
<add place="above" type="insert">az</add></rdg>
</app></l>
<l xml:id="l.8">Ha masznȧk iawaid nem hasznalhatnak.</l>
<l xml:id="l.9">S-magadnak bechw̋ letire nem szolgalnak</l>
<l xml:id="l.10">Lelkednek weszedelmire teobet alanak.</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.11">Cresus kiralinak ő kazdagsagha</l>
<l xml:id="l.12">Ez vilagi elettben nem volt hȧsznara,</l>
<l xml:id="l.13">Dė szőtt newekedek nekie karara</l>
<l xml:id="l.14">Wegre szorulwán maas konihaiara</l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.15">Darius Czaszarnak nagi Birodalmȧ<note type="critic" xml:id="note.1">A sor arra céloz, hogy
                            Croesus a perzsa király fogságába került.</note></l>
<l xml:id="l.16">Kincziben, S. Nepiben eö hiszen vala</l>
<l xml:id="l.17">Mindėn nap nagi frissen eldegel vala</l>
<l xml:id="l.18">Hintobȧn lott vegrė szolgaitol halala</l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.19">Vzorás kazdagnak nagi vig lakasza.</l>
<l xml:id="l.20"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">Segheni lazarnak nem hasznalhata</lem>
<rdg wit="#W1" xml:id="rdg.3">lazarnak<note type="critic" xml:id="note.2">A <hi rend="italic">z</hi> és az <hi rend="italic">s</hi> egymásra
                                írva, nem állapítható meg, melyik volt az elsődleges.</note></rdg>
</app></l>
<l xml:id="l.21">Mert az lölkit Eördőg hoza kapczolta,</l>
<l xml:id="l.22">Vegre az Testitis vtana Vonta.<note type="critic" xml:id="note.3">17–20 A dúsgazdagnak és a
                            szegény Lázárnak példáját lásd Luk. 16,19–25.</note></l>
</lg>
</div>
</body>
