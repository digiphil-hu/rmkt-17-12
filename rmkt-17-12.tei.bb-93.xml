<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 93.</fw>
<lg xml:id="lg.1">
<l xml:id="l.1"><hi rend="bold">B</hi>ujdosuán tétoua rebdesek,</l>
<l rend="level_2" xml:id="l.2"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Öremet sohonnan nem veszek,</lem><rdg wit="#W1" xml:id="rdg.1"><del>Örömöt</del><add type="corr">Öremet</add>; <del>kerek</del><add type="corr">veszek</add></rdg></app></l>
<l rend="level_2" xml:id="l.3">Migh sok ellenségjmröl</l>
<l rend="level_2" xml:id="l.4">S el puztitott fezkemröl</l>
<l rend="level_5" xml:id="l.5">Nem tezek.</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.6"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2"><hi rend="bold">A</hi>rt mjnden, kj ellenem álhat,</lem>
<rdg wit="#W1" xml:id="rdg.2">
<del>Azt</del>
<add type="corr">Art</add>
</rdg>
</app></l>
<l rend="level_2" xml:id="l.7"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">S kj cselekedettel nem árthat,</lem><rdg wit="#W1" xml:id="rdg.3"><del>ellenem</del> nem <del rend="overwritten">alhath</del> <add type="overwrite">árthat</add></rdg></app></l>
<l rend="level_2" xml:id="l.8">Ejt mégis sok mérges szot,</l>
<l rend="level_2" xml:id="l.9"><app xml:id="app.4"><lem wit="#KK" xml:id="lem.4">Az kjért teölemis jót</lem><rdg wit="#W1" xml:id="rdg.4"><del>értemis szot</del> teölemis jót</rdg></app></l>
<l rend="level_5" xml:id="l.10">Nem várhat.</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.11"><hi rend="bold">L</hi>átom már, hogj sok reménségem</l>
<l rend="level_2" xml:id="l.12">Nem lész ohajtott keönjebségem,</l>
<l rend="level_2" xml:id="l.13">Szjuem bánatra jutott,</l>
<l rend="level_2" xml:id="l.14">Stölem eppen el futott,</l>
<l rend="level_5" xml:id="l.15">Szépsigem.</l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.16"><hi rend="bold">A</hi>z minth hogj Tantalus uizében,</l>
<l rend="level_2" xml:id="l.17">Vgj úzok en reménségemben,</l>
<l rend="level_2" xml:id="l.18">De hasznoth nem láthatok,</l>
<l rend="level_2" xml:id="l.19">Mert semmjt nem kaphatok</l>
<l rend="level_5" xml:id="l.20"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5">Ezekben.</lem>
<rdg wit="#W1" xml:id="rdg.5"><add type="insert">Ezekben</add><note type="critic" xml:id="note.1">Ezt a
                                    szót, melyet a másoló tévedésből kihagyott,
                                        <persName>Balassa</persName> írta be.</note></rdg>
</app></l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.21"><hi rend="bold">S</hi>zéréncse néha táuul njjlik,</l>
<l rend="level_2" xml:id="l.22">Csillagja szemem elött fenlik,</l>
<l rend="level_2" xml:id="l.23">De mjngjárást mostoha,</l>
<l rend="level_2" xml:id="l.24"><app xml:id="app.6"><lem wit="#KK" xml:id="lem.6">Annjra, hogj azt soha</lem><rdg wit="#W1" xml:id="rdg.6"><del>Vgj</del> <del>a</del><add type="corr">A</add>nnjra</rdg></app></l>
<l rend="level_5" xml:id="l.25">Sem uélik.</l>
</lg>
<lg xml:id="lg.6"><l xml:id="l.26">
<app xml:id="app.7"><lem wit="#KK" xml:id="lem.7"><hi rend="bold">S</hi>oljom ........................................</lem><rdg wit="#W1" xml:id="rdg.7">Soljom <gap extent="unknown" reason="damaged" unit="line"/><note type="critic" xml:id="note.2">Őrszóként; a szöveg folytatása hiányzik.</note></rdg></app>
</l></lg>
</div>
