<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 18.</fw>
<head type="title">INUIDIA</head>
<lg xml:id="lg.1">
<l xml:id="l.1"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">Irigiseghis fogta kezeben lanczaiat,</lem>
<rdg wit="#W1" xml:id="rdg.1">
<note type="critic" xml:id="note.1">[A sor fölött:] <del>Irigiseeg emb</del> [A sor
                                    alatt:] <del>Nem nezwén</del></note>
</rdg>
</app></l>
<l xml:id="l.2"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Mikoron másnak latia io alapatiat,</lem><rdg wit="#W1" xml:id="rdg.2"><del><gap extent="1" reason="illegible" unit="word"/></del><add type="corr">másnak</add></rdg></app></l>
<l xml:id="l.3">Tely nagi haragal,</l>
<l xml:id="l.4">Akarwan alt verni kedwes io baratiat,</l>
<l xml:id="l.5">Latwan nevelni feliebb allapatiat,<note type="critic" xml:id="note.2">[A sor alatt:]
                                <del>Sekebol le wetni</del> [Ez alatt külön sorban:] <del>Mint az
                                kuwas</del></note></l>
<l xml:id="l.6">Vesteni akaria kedves attafiat.</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.7">Irigsegh emberben felete nagi vetek,</l>
<l xml:id="l.8">Mikoron sziwiben Irigisegh vér fezketh,</l>
<l xml:id="l.9">Fonastia, apastia az niaualias testet,</l>
<l xml:id="l.10"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">Jo szerencheienek kiwania el vestet,<note type="critic" xml:id="note.3">8–10 Vö. a <ref target="rmkt-17-12.tei.mg-22">22/I. sz.
                                        ének</ref> 22–24. soraival.</note></lem><rdg wit="#W1" xml:id="rdg.3"><note type="critic" xml:id="note.4">[A sor alatt:] <del>Mint az kis</del> ebek</note></rdg></app></l>
<l xml:id="l.11"><app xml:id="app.4"><lem wit="#KK" xml:id="lem.4">Irigili masoknak elö menetelet.</lem><rdg wit="#W1" xml:id="rdg.4"><del><gap extent="unknown" reason="illegible" unit="char"/></del><add type="corr">masoknak</add> <note type="critic" xml:id="note.5">[A sor alatt:] Mint az eb</note></rdg></app></l>
<l xml:id="l.12"><app xml:id="app.5"><lem wit="#KK" xml:id="lem.5">Mint az eb, nezdegel, tarsara morgodik,</lem><rdg wit="#W1" xml:id="rdg.5"> [Előbb így:] Mint
                        az eb morgodik masra<note type="critic" xml:id="note.6">Csak ennyi.</note></rdg></app></l>
<l xml:id="l.13"><app xml:id="app.6"><lem wit="#KK" xml:id="lem.6">Maga nem ehetik, rea irigjkedik.</lem><rdg wit="#W1" xml:id="rdg.6"><note type="critic" xml:id="note.7">12–13 E két sor a 2. szakasz mellett, a jobb oldali hasábon.</note><note type="critic" xml:id="note.8">[A sor fölött:] <del>Irigli masoknak elö menetelet</del></note></rdg></app></l>
</lg>
</div>
</body>
</text>
