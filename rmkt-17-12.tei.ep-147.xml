<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 147.</fw>
<lg xml:id="lg.1">
<l xml:id="l.1">Ugy vagyon az hire</l>
<l rend="level_2" xml:id="l.2">Biszonyosan Bécsben</l>
<l rend="level_4" xml:id="l.3">Iegiesz tarsot maganak</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.4"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">Szandé<corr>k</corr>ia hallagion</lem>
<rdg wit="#W1" xml:id="rdg.1">Szandéia</rdg>
</app></l>
<l rend="level_2" xml:id="l.5">Egy kevesse mulion,</l>
<l rend="level_4" xml:id="l.6">Mortiot rendelt az Isten</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.7">Az ki lesz hasznára</l>
<l rend="level_2" xml:id="l.8">Szivinek nyuktára</l>
<l rend="level_4" xml:id="l.9">Lölki üdvosségére,</l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.10">Hamar azt kivánná,</l>
<l rend="level_2" xml:id="l.11">Örömet is tudna,</l>
<l rend="level_4" xml:id="l.12">Hol is mikor udvarolhat</l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.13">Ez uttán egy hittel</l>
<l rend="level_2" xml:id="l.14">Örömest egy hittel</l>
<l rend="level_4" xml:id="l.15">Gyuröyvel iedcseny</l>
</lg>
<lg xml:id="lg.6">
<l xml:id="l.16">Katécsát maganak</l>
<l rend="level_2" xml:id="l.17">Magat Katecsának</l>
<l rend="level_4" xml:id="l.18">Holtég oda engedny</l>
</lg>
<lg xml:id="lg.7">
<l xml:id="l.19">Szép lako heley</l>
<l rend="level_2" xml:id="l.20">S alkalmtoságy</l>
<l rend="level_4" xml:id="l.21">Mindenüt készen vannak</l>
</lg>
<lg xml:id="lg.8">
<l xml:id="l.22">Országoghban hire</l>
<l rend="level_2" xml:id="l.23">Ambár nincsen tiszte</l>
<l rend="level_4" xml:id="l.24">Volna modgia aban is</l>
</lg>
<lg xml:id="lg.9">
<l xml:id="l.25">Marsnak attya fia</l>
<l rend="level_2" xml:id="l.26">Sémmi adoságha</l>
<l rend="level_4" xml:id="l.27">Ertékeis nem szegény</l>
</lg>
<lg xml:id="lg.10">
<l xml:id="l.28">Kivánnia válászát</l>
<l rend="level_2" xml:id="l.29">Istennek aldasat</l>
<l rend="level_4" xml:id="l.30">Az marss hamar el vária</l>
</lg>
</div>
</body>
