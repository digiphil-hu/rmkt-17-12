<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 106.</fw>
<lg xml:id="lg.1">
<l xml:id="l.1">Mit tréfalsz Cupido, mint sajat matkadal,</l>
<l rend="level_2" xml:id="l.2"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">K<corr>i</corr>t megh kötölesztil hamis csalardságal,</lem><rdg wit="#W1" xml:id="rdg.1">Két</rdg></app></l>
<l rend="level_2" xml:id="l.3">Ved el levelemet, kit nagy siralommal</l>
<l rend="level_2" xml:id="l.4"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Ertám<note type="critic" xml:id="note.1">a. m. írtam</note> megh epedet köny hulatassommal.</lem><rdg wit="#W1" xml:id="rdg.2">hula<add type="insert">tas</add>sommal</rdg></app></l>
</lg>
<lg xml:id="lg.2"><l xml:id="l.5">Oh gyálázatomra szöletett Cupido,</l>
<l rend="level_2" xml:id="l.6">Hiremben s- nevemben megh mardozo kigyo,</l>
<l rend="level_2" xml:id="l.7">Vád oroszlyanok hoz s. tigris hoz hasomlo,</l>
<l rend="level_2" xml:id="l.8">Mit trifálsz hiteddel, hitetlen árulo?</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.9"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">Talam unicornis volt te niked atya<corr>d</corr>,</lem>
<rdg wit="#W1" xml:id="rdg.3">Atyát</rdg>
</app></l>
<l rend="level_2" xml:id="l.10">Pustában nevelt föl, mint Romulust, anyad?</l>
<l rend="level_2" xml:id="l.11">Ragadozo fárkás volt szoptáto dajkad,</l>
<l rend="level_2" xml:id="l.12">En akáratomát hogy uenni nem tudad?</l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.13">Emlékezil hámis sok eskövisedre,</l>
<l rend="level_2" xml:id="l.14">Nékem megh jelentet mérges beszidedre,</l>
<l rend="level_2" xml:id="l.15"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4">Mellyekkel te, hamis csáráldságnák lelke,</lem>
<rdg wit="#W1" xml:id="rdg.4">csáráldság<add type="insert">n</add>ák</rdg>
</app></l>
<l rend="level_2" xml:id="l.16">Mint halát horogra, csálál szerelemre.</l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.17"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5">Poharodnák szélét édes mizzel kented,</lem>
<rdg wit="#W1" xml:id="rdg.5">Poha<del>d</del><add type="corr">r</add>odnák</rdg>
</app></l>
<l rend="level_2" xml:id="l.18">Hogy annák jo ézét velem el hitessed,</l>
<l rend="level_2" xml:id="l.19"><app xml:id="app.6"><lem wit="#KK" xml:id="lem.6">Belöl megh epesztö mireggel tülte<corr>te</corr>d,</lem><rdg wit="#W1" xml:id="rdg.6">tülted</rdg></app></l>
<l rend="level_2" xml:id="l.20"><app xml:id="app.7">
<lem wit="#KK" xml:id="lem.7">Méznek szén<corr>e</corr> alát reám
                                    köszönte<corr>t</corr>ed.</lem>
<rdg wit="#W1" xml:id="rdg.7">széned; köszönteded. [Előbb:] köszönted.</rdg>
</app></l>
</lg>
<lg xml:id="lg.6">
<l xml:id="l.21"><app xml:id="app.8"><lem wit="#KK" xml:id="lem.8">A mint az mádárász madára<corr>t</corr> szép szovál,<note type="critic" xml:id="note.2">sípszóval</note></lem><rdg wit="#W1" xml:id="rdg.8">madárad</rdg></app></l>
<l rend="level_2" xml:id="l.22">Az miheket pedigh méznek joságával,<note type="critic" xml:id="note.3">jó szagával</note></l>
<l rend="level_2" xml:id="l.23">Teis, csálárd lelek, sok hamisságoddal</l>
<l rend="level_2" xml:id="l.24"><app xml:id="app.9"><lem wit="#KK" xml:id="lem.9">Csalál s- fogál <corr>engem</corr> sok szép édes szodal.</lem><rdg wit="#W1" xml:id="rdg.9">fogál sok<note type="critic" xml:id="note.4">A szótagszám miatt jav.</note></rdg></app></l>
</lg>
<lg xml:id="lg.7">
<l xml:id="l.25">Szemmem, az én nyelvem ellened támodgyik,</l>
<l rend="level_2" xml:id="l.26">Hárágom tüzitül szévedis székrázik,</l>
<l rend="level_2" xml:id="l.27"><app xml:id="app.10"><lem wit="#KK" xml:id="lem.10">Mint ülő<note type="critic" xml:id="note.5">ölyv</note> gálámbal ve<corr>l</corr>e<corr>m</corr> veszekedik,</lem><rdg wit="#W1" xml:id="rdg.10"><unclear>veiek</unclear></rdg></app></l>
<l rend="level_2" xml:id="l.28">Farkas bárátságom hozzad megh ne szönik.<note type="critic" xml:id="note.6">25–28 A sorok végén az állítmányok íző nyelvjárásban felszólító módban állanak: támadgyék, szikrázzék, veszekedjék,
                        szűnjék.</note></l>
</lg>
<lg xml:id="lg.8">
<l xml:id="l.29">Könyeb egy kánallál az tengert ki mirni,</l>
<l rend="level_2" xml:id="l.30">Hogy sem hárágomnák ellened el mulni,</l>
<l rend="level_2" xml:id="l.31">Koporsom szélénis kisz vágyok pörülni,</l>
<l rend="level_2" xml:id="l.32">Hate nem altálad<note type="critic" xml:id="note.7">olv. általád, azaz átallottad</note> ellensigem lenni.</l>
</lg>
<lg xml:id="lg.9">
<l xml:id="l.33">Megh ölél hiremben, mint Kajn az Abelt,</l>
<l rend="level_2" xml:id="l.34">Kajnnál bujdossál, soha nem tálal<note type="critic" xml:id="note.8">a. m. találj</note> helt,</l>
<l rend="level_2" xml:id="l.35">Neis kaphas sohult testednek eledelt,</l>
<l rend="level_2" xml:id="l.36">Akkor emlékezil nem hadni el az jelt.</l>
</lg>
<lg xml:id="lg.10">
<l xml:id="l.37">Minden izem, csontom ellened tamadgyon,</l>
<l rend="level_2" xml:id="l.38">Csak egy csöpp verem-is ellened hárcsollyon,</l>
<l rend="level_2" xml:id="l.39"><app xml:id="app.11"><lem wit="#KK" xml:id="lem.11"><corr>Hamis hitőszigett<note type="critic" xml:id="note.9">hiteszegett</note> arulonak mondjon,</corr></lem><rdg wit="#W1" xml:id="rdg.11">arulonak mondjon Hamis hitössiged<note type="critic" xml:id="note.10">A sorvégek összecsengése miatt jav.</note></rdg></app></l>
<l rend="level_2" xml:id="l.40">Az elött ki aldot, az utan atkozon.</l>
</lg>
</div>
</body>
</text>
