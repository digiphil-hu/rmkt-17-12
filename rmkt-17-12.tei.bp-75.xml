<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 75.</fw>
<head type="title">HOGY AZ SZABADSÁGNAK MÉLTOSÁGA MINDENEKNÉL KÉVANATOS</head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1">Mi lehet kedvessebb,</l>
<l xml:id="l.2">S’ gyönyörüségessebb,</l>
<l xml:id="l.3">Mint a’ kévánt szabadság?</l>
<l rend="level_2" xml:id="l.4">Könnyen Uralkodo</l>
<l xml:id="l.5">Noha hivalkodo</l>
<l xml:id="l.6">Akaratos méltoság,</l>
<l rend="level_2" xml:id="l.7">Maga kedvét járja,</l>
<l xml:id="l.8">Rabságot utállya,</l>
<l xml:id="l.9">Nem baráttya a’ birság.</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">Mert nap fénye alatt</lem>
<rdg wit="#W1" xml:id="rdg.1">nap fény</rdg>
<rdg wit="#W2" xml:id="rdg.2">nap fenye</rdg>
<rdg wit="#Wβ" xml:id="rdg.3">a’ nap fény</rdg>
</app></l>
<l xml:id="l.11">Minden féle állat</l>
<l xml:id="l.12"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Vágy, siet szabadságra,</lem>
<rdg wit="#W1 #W2" xml:id="rdg.4">Vagy,</rdg>
<rdg wit="#Wβ" xml:id="rdg.5">Vágy,</rdg>
</app></l>
<l rend="level_2" xml:id="l.13">Tengeren evezve,</l>
<l xml:id="l.14">S’ föld szinén kerengve</l>
<l xml:id="l.15"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">Repül ez nyajasságra,</lem>
<rdg wit="#W2" xml:id="rdg.6">az</rdg>
</app></l>
<l rend="level_2" xml:id="l.16">Ki ha ezt nyerheti,</l>
<l xml:id="l.17">Magával hiteti,</l>
<l xml:id="l.18">Hogy jutott boldogságra.</l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19">Mert az kötelesség</l>
<l xml:id="l.20">Nem leg kisseb inség,</l>
<l xml:id="l.21">Ki van más birtokában,</l>
<l rend="level_2" xml:id="l.22"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4">Sok álom szakasztást,</lem>
<rdg wit="#W2" xml:id="rdg.7">szakastas</rdg>
</app></l>
<l xml:id="l.23">Törödést s’ udvarlást</l>
<l xml:id="l.24">Türve nyög az magában,</l>
<l rend="level_2" xml:id="l.25">Az ki más asztalán</l>
<l xml:id="l.26">S’ nem maga tanyérán</l>
<l xml:id="l.27"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5">Akar enni az konczban.</lem>
<rdg wit="#W2" xml:id="rdg.8">konczot</rdg>
</app></l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.28">Nem mondom Királyság,</l>
<l xml:id="l.29">De egy kis Uraság,</l>
<l xml:id="l.30">Ki lakhatik házánál,</l>
<l rend="level_2" xml:id="l.31">Bár füstös legyen-is,</l>
<l xml:id="l.32">Es sással födöt-is,</l>
<l xml:id="l.33">Job más Palotájánál,</l>
<l rend="level_2" xml:id="l.34">Nyugszik hol akarja,</l>
<l xml:id="l.35">Sétál hol kévánnya,</l>
<l xml:id="l.36">Nem ül más ajtajánál.</l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.37">Az mikor akarod,</l>
<l xml:id="l.38"><app xml:id="app.6">
<lem wit="#KK" xml:id="lem.6">Teritett asztalod,</lem>
<rdg wit="#W2 #W3" xml:id="rdg.9">Terited</rdg>
</app></l>
<l xml:id="l.39">Nem vársz abbul senkitül,</l>
<l rend="level_2" xml:id="l.40">Ha vagyon mit enned,</l>
<l xml:id="l.41">Nem panaszos étked:</l>
<l xml:id="l.42">Nem hajtnak ki asztaltul,</l>
<l rend="level_2" xml:id="l.43">Nem üznek dologra,</l>
<l xml:id="l.44">S’ nem jön ablakodra</l>
<l xml:id="l.45">Birság pecsét birótul.</l>
</lg>
<lg xml:id="lg.6">
<l rend="level_2" xml:id="l.46">Noha kalmár ebe</l>
<l xml:id="l.47">Mind nyárba, és télbe</l>
<l xml:id="l.48">Rágodik siros konczon,</l>
<l rend="level_2" xml:id="l.49">Borsos étket eszik,</l>
<l xml:id="l.50">Sátor alatt nyugszik</l>
<l xml:id="l.51">S’ nyujtozik az lasnakon,<note type="critic" xml:id="note.1">rongyon, takarón</note></l>
<l rend="level_2" xml:id="l.52"><app xml:id="app.7">
<lem wit="#KK" xml:id="lem.7">De még-is néz mordon</lem>
<rdg wit="#W2" xml:id="rdg.10">nem <sic>mordom</sic></rdg>
</app></l>
<l xml:id="l.53">Hogy nem jár szabadon,</l>
<l xml:id="l.54">Es hogy van kötve lánczon.</l>
</lg>
<lg xml:id="lg.7">
<l rend="level_2" xml:id="l.55">Az Farkas az erdöt</l>
<l xml:id="l.56">Járja, s’ üvölt üdöt,</l>
<l xml:id="l.57">Fárad sokat éhezve,</l>
<l rend="level_2" xml:id="l.58">Tür az koplalással,</l>
<l xml:id="l.59">Csak hogy az vas lánczal</l>
<l xml:id="l.60">Ne legyen nyakon kötve,</l>
<l rend="level_2" xml:id="l.61">Szabadságnak örül,</l>
<l xml:id="l.62">Pálcza ütést kerül,</l>
<l xml:id="l.63">Fél ne legyen rekesztve.</l>
</lg>
<lg xml:id="lg.8">
<l rend="level_2" xml:id="l.64">Sebes Rárot foghattsz,</l>
<l xml:id="l.65">Ölyvet meg-tanithatsz</l>
<l xml:id="l.66">Fürjet s’ foglyot hogy fogjon,</l>
<l rend="level_2" xml:id="l.67">Nagy sok koplalással,</l>
<l xml:id="l.68">S’ álom szakasztással</l>
<l xml:id="l.69">Szoktatod meg-maradgyon,</l>
<l rend="level_2" xml:id="l.70">Még-is sokszor el-hágy,</l>
<l xml:id="l.71">Es szabadságra vágy,</l>
<l xml:id="l.72">Nézi mint el szaladgyon.</l>
</lg>
<lg xml:id="lg.9">
<l rend="level_2" xml:id="l.73">Majmot mulatságért,</l>
<l xml:id="l.74">S’ medvét nevetségért</l>
<l xml:id="l.75"><app xml:id="app.8">
<lem wit="#KK" xml:id="lem.8">Jol tartnak bé-rekesztve,</lem>
<rdg wit="#W2" xml:id="rdg.11">tartyak</rdg>
</app></l>
<l rend="level_2" xml:id="l.76">Nyakán gallér villog,</l>
<l xml:id="l.77">S’ hátán palást forog,</l>
<l xml:id="l.78">Neki sokat kedvezve,</l>
<l rend="level_2" xml:id="l.79"><app xml:id="app.9">
<lem wit="#KK" xml:id="lem.9">De az min<corr>d</corr> kelletlen,</lem>
<rdg wit="#W1 #W2 #W4" xml:id="rdg.12">mint</rdg>
<rdg wit="#W3" xml:id="rdg.13">mind</rdg>
</app></l>
<l xml:id="l.80">Etele izetlen,</l>
<l xml:id="l.81">Jár szabadsággal kedve.</l>
</lg>
<lg xml:id="lg.10">
<l rend="level_2" xml:id="l.82">Kalitkában madár</l>
<l xml:id="l.83">Lakjék kedvére bár,</l>
<l xml:id="l.84">Zöld árnyékkal bé-fedve,</l>
<l rend="level_2" xml:id="l.85"><app xml:id="app.10">
<lem wit="#KK" xml:id="lem.10">Hól nem éri essö,</lem>
<rdg wit="#W2" xml:id="rdg.14">Hogy</rdg>
</app></l>
<l xml:id="l.86">Csak hogy gyenge veszszö</l>
<l xml:id="l.87">Tartoztattya rekesztve,</l>
<l rend="level_2" xml:id="l.88">Még-is ohajt azon,</l>
<l xml:id="l.89">Hogy nincsen szabadon,</l>
<l xml:id="l.90">Búsúl ártatlan szive.</l>
</lg>
<lg xml:id="lg.11">
<l rend="level_2" xml:id="l.91">Hogy ha szabadságban</l>
<l xml:id="l.92">Nem laktál sorsában:</l>
<l xml:id="l.93">Ezt nem tudod fontolni,</l>
<l rend="level_2" xml:id="l.94">Melly drága kéncs legyen</l>
<l xml:id="l.95">S’ menyi sokat érjen,</l>
<l xml:id="l.96">Ahoz nem tudsz szóllani,</l>
<l rend="level_2" xml:id="l.97">En-is ármálissát,<note type="critic" xml:id="note.2">ármális – címeres
                            nemességet adományozó levél</note></l>
<l xml:id="l.98"><app xml:id="app.11">
<lem wit="#KK" xml:id="lem.11">S’ arannya<corr>l irt</corr> jussát</lem>
<rdg wit="#W1" xml:id="rdg.15">arannyajért</rdg>
<rdg wit="#W2 #W3 #W4" xml:id="rdg.16">arannyal irt</rdg>
</app></l>
<l xml:id="l.99">Nem érkezem fejteni.</l>
</lg>
</div>
</body>
</text>
