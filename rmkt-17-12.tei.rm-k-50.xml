<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 50.</fw>
<lg xml:id="lg.1">
<l xml:id="l.1"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1"><corr>Látod ez gyöngy szemet</corr> .....................................<note type="critic" xml:id="note.1">A kézirat csonka, az első sort
                                            <persName>Radvánszky<idno type="ITIdata">Q149913</idno></persName> alapján adjuk.</note></lem><rdg wit="#W1" xml:id="rdg.1"><gap extent="1" reason="damaged" unit="line"/></rdg></app></l>
<l xml:id="l.2"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Fogiatkozassaual szine wag ...............................
                    </lem><rdg wit="#W1" xml:id="rdg.2">wag <gap extent="unknown" reason="damaged" unit="word"/></rdg></app></l><l xml:id="l.3"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">Jgi wagion en kezem te hozad
                                ............................</lem>
<rdg wit="#W1" xml:id="rdg.3"><del rend="overwritten">hozam</del>
<add type="overwrite">kezem</add> te hozad <gap extent="unknown" reason="damaged" unit="word"/></rdg>
</app></l>
<l xml:id="l.4"><app xml:id="app.4"><lem wit="#KK" xml:id="lem.4">Es Szerelmed miat wagion megh herwa..............</lem><rdg wit="#W1" xml:id="rdg.4">herwa<gap extent="unknown" reason="damaged" unit="word"/></rdg></app></l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.5">Chiak az te io kedued áád neha szint neky,</l>
<l xml:id="l.6">Mint eztis az Zomancz szinewel szepiti,</l>
<l xml:id="l.7">Es mikint az Arani ezt<note type="critic" xml:id="note.2">ti. az aranyba foglalt
                            gyöngyöt</note> ki nem eithetti,</l>
<l xml:id="l.8">Kepedet Siuemis vgi nem feleithetti.</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.9"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5">Forgassa ez gionginek szem jegiez egiebet,</lem>
<rdg wit="#W1" xml:id="rdg.5">e<del rend="overwritten">b</del><add type="overwrite">g</add>iebet</rdg>
</app></l>
<l xml:id="l.10">Chiak hogi elmem forgat Szẅntelen Tegedet,</l>
<l xml:id="l.11">Ne vond meg haat twlem tejs keduedet,</l>
<l xml:id="l.12">Had foglialiam belem egeslen Szerelmedet.<note type="critic" xml:id="note.3">11–12 A
                            szótaghiba kijavítása önkényes lenne (vö. <bibl><hi rend="smallcaps">Bóta</hi>: i. m. 8</bibl>).</note></l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.13">Kőuesd ez araninak engedeȯ lagi voltat,</l>
<l xml:id="l.14"><app xml:id="app.6">
<lem wit="#KK" xml:id="lem.6">Töres nelkul adgia keze<corr>d</corr>nek haioltat,</lem>
<rdg wit="#W1" xml:id="rdg.6">kezeidnek</rdg>
</app></l>
<l xml:id="l.15">Eletednek hozam niuicz teis lagi foltat,</l>
<l xml:id="l.16">Igi Enihiched<note type="critic" xml:id="note.4">olv. enyhítsed</note> bennem twzemnek nagi
                        Voltát.</l>
</lg>
</div>
</body>
</text>
