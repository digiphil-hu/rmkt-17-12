<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 57.</fw>
<l xml:id="l.1"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">...................................</lem><rdg wit="#W1" xml:id="rdg.1"><gap extent="unknown" reason="damaged" unit="line"/></rdg></app></l>
<lg xml:id="lg.1">
<l xml:id="l.2"><app xml:id="app.2"><lem wit="#KK" xml:id="lem.2">Be b<corr>or</corr>ult folhozȯt<note type="critic" xml:id="note.1">olv. fölhőzött</note> banat hozó
                                egem,</lem><rdg wit="#W1" xml:id="rdg.2">b<gap extent="1" reason="damaged" unit="char"/>ult</rdg></app></l>
<l xml:id="l.3"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3"><corr>Gia</corr>kor fazlalassal mit borzasztal
                                engem,<note>1-2 A kézirat szakadt. A második sorban
                                    <persName>Radvánszky<idno type="ITIdata">Q149913</idno></persName>
<hi rend="italic">Máskor</hi>-t írt</note></lem>
<rdg wit="#W1" xml:id="rdg.3"><gap extent="3" reason="damaged" unit="char"/>kor</rdg>
</app></l>
<l xml:id="l.4">Szomoritȯt<note type="critic" xml:id="note.2">olv. szomorítod. (<persName>Radvánszky<idno type="ITIdata">Q149913</idno></persName> tévesen <hi rend="italic">szomorított</hi>-at olvasott.)</note> keduem,</l>
<l xml:id="l.5">Venusnak Tẅziwel nem hacz melegednem.</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.6"><app xml:id="app.4"><lem wit="#KK" xml:id="lem.4">Irigilede<note type="critic" xml:id="note.3">olv. irigyled-e?</note> annak Vaar<corr>t</corr>
                                bodogulassáát,</lem><rdg wit="#W1" xml:id="rdg.4">Vaar</rdg></app></l>
<l xml:id="l.7">Sziuemnek neweli ki vigaztalassaát?</l>
<l xml:id="l.8">Nezd hẇ aianlassáát,</l>
<l xml:id="l.9">Vidulẏ megh, deruli fel, ne herwazd orczaiat!</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.10">Ad latnom derultem kiwantam szemeliet,</l>
<l xml:id="l.11">Es ne epest bennem sziwem remenssegéét,</l>
<l xml:id="l.12">Had foghassam kezéet,</l>
<l xml:id="l.13">Ne zard be vthamoth, S neki ne segd keduít!</l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.14">Latod az ö dolgat; vgi Vagion, mint nekem,</l>
<l xml:id="l.15">Egi máás nelkul vesseli<note type="critic" xml:id="note.4">olv. veszély</note> Iarnunk az Tengeren,</l>
<l xml:id="l.16">Habokal Hani engem,</l>
<l xml:id="l.17">Segitsen ö nekem s en neki eweznem.</l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.18">Fenies Vilagodal vidicz megh benunket,</l>
<l xml:id="l.19">Lathatod egimazhoz megh indult keduunket,</l>
<l xml:id="l.20">Neweld ȯrömunket,</l>
<l xml:id="l.21">Zaportul megis oód viragzȯo kertunket!</l>
</lg>
<lg xml:id="lg.6">
<l xml:id="l.22">Jlletu̇ nk tegedis belole Io Szaggal,</l>
<l xml:id="l.23">Az mi Szerelmunket ne Terheld haragal,</l>
<l xml:id="l.24">Te birs minden maggal,</l>
<l xml:id="l.25">Kemeliwe<note type="critic" xml:id="note.5">kímélve</note> bani Velem, mint szerelmes rabbal!</l>
</lg>
<lg xml:id="lg.7">
<l xml:id="l.26">Tejs, Szemeliemben oruendö szerelmem,</l>
<l xml:id="l.27">Szerelmedben ne hagi vresultnek lennem,</l>
<l xml:id="l.28">Megh niugodgial bennem,</l>
<l xml:id="l.29">Restseghben nem talals, ha szolgaltacz velem.</l>
</lg>
<lg xml:id="lg.8">
<l xml:id="l.30">Sok fele szerenchied ne lehessen, chiak egi,</l>
<l xml:id="l.31">Buwal banatalis soha ne Ismerkegi,</l>
<l xml:id="l.32">Eppen allion a hegi,</l>
<l xml:id="l.33">Melliet szám izihez terem Szep piros Megi!</l>
</lg>
</div>
</body>
