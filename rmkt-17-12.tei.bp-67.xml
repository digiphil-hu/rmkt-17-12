<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 67.</fw>
<head type="title">AZ EL-HAGYOTT ÁLLAPATBAN MAGA VIGASZTALÁSA</head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1">Mit háborgatz lelkem,</l>
<l xml:id="l.2"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">S’ mit támadsz ellenem,</lem>
<rdg wit="#W2" xml:id="rdg.1">s meirt</rdg>
</app></l>
<l xml:id="l.3">Rontod szivem kétséggel?</l>
<l rend="level_2" xml:id="l.4">Nem rövidült keze,</l>
<l xml:id="l.5">Teremtöd ereje,</l>
<l xml:id="l.6">Jün majdan segétséggel,</l>
<l rend="level_2" xml:id="l.7">Bé-tölti szükséged,</l>
<l xml:id="l.8">S’ rontya ellenséged,</l>
<l xml:id="l.9">Meg-isméred ezennel.</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10">Türd csak csendességgel,</l>
<l xml:id="l.11">S’ fogadgyad örömmel</l>
<l xml:id="l.12">Bus lelkem bánatidot,</l>
<l rend="level_2" xml:id="l.13">Mert nem történetbül,</l>
<l xml:id="l.14">Hanem érdemedböl</l>
<l xml:id="l.15">Erzed most fájdalmidat,</l>
<l rend="level_2" xml:id="l.16">Mint arany az tüzben,</l>
<l xml:id="l.17">Tisztuly büntetésben,</l>
<l xml:id="l.18">Hogy vehesd jutalmidat.</l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19">Zugolodo ne légy,</l>
<l xml:id="l.20">Keményb ostort ne végy,</l>
<l xml:id="l.21">Mert Uraddal van dolgod,</l>
<l rend="level_2" xml:id="l.22">Ki nézi sziveket,</l>
<l xml:id="l.23">Visgállya veséket,</l>
<l xml:id="l.24">S’ ugy adatik csak sóldod,<note type="critic" xml:id="note.1">olv. zsoldod, a. m.
                            fizetséged</note></l>
<l rend="level_2" xml:id="l.25">Az mint találtatik,</l>
<l xml:id="l.26">Fontban ugy méretik</l>
<l xml:id="l.27">Te alázatosságod.</l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.28">Söt áldgyad oránként,</l>
<l xml:id="l.29"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Hogy gyarloságodként</lem>
<rdg wit="#W2" xml:id="rdg.2">giarlosagomkint</rdg>
</app></l>
<l xml:id="l.30">Proba alá-is vetett,</l>
<l rend="level_2" xml:id="l.31">Hogy tüzes menykövel,</l>
<l xml:id="l.32">S’ pokolbéli tüzzel</l>
<l xml:id="l.33">Haragjában nem vesztett,</l>
<l rend="level_2" xml:id="l.34">Mert kicsiny hévséggel,</l>
<l xml:id="l.35">S’ kisseb szeretettel</l>
<l xml:id="l.36"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">Rettegted teremtödet.</lem>
<rdg wit="#W2" xml:id="rdg.3">röttegied</rdg>
</app></l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.37">Mennyit hivot sokszor,</l>
<l xml:id="l.38">Látván vagy hamu, s’ por,</l>
<l xml:id="l.39">Mutatván kegyességét,</l>
<l rend="level_2" xml:id="l.40">Akaratos élted</l>
<l xml:id="l.41">S’ kényén<note type="critic" xml:id="note.2">maga akaratán, tetszésén</note> járo lépted,</l>
<l xml:id="l.42">Nem ismérvén kegyelmét,</l>
<l rend="level_2" xml:id="l.43">Pokolbéli hályog</l>
<l xml:id="l.44">S’ ördögi rút tályog,</l>
<l xml:id="l.45">Rontván szived félelmét.</l>
</lg>
<lg xml:id="lg.6">
<l rend="level_2" xml:id="l.46">Noha rút irigység,</l>
<l xml:id="l.47">Es utált kényesség</l>
<l xml:id="l.48">Rajtad el-hatalmazott,</l>
<l rend="level_2" xml:id="l.49">Jora valo restség,</l>
<l xml:id="l.50">S’ gonoszra fesletség</l>
<l xml:id="l.51">Akarattyára hajtott,</l>
<l rend="level_2" xml:id="l.52">Tétovázo kétség,</l>
<l xml:id="l.53">Szemtelen gyülölség</l>
<l xml:id="l.54">Ertelmedben vakitott.</l>
</lg>
<lg xml:id="lg.7">
<l rend="level_2" xml:id="l.55">Né essél kétségben,</l>
<l xml:id="l.56">Légy jo reménségben,</l>
<l xml:id="l.57">Fel-kél kedvedre napod,</l>
<l rend="level_2" xml:id="l.58">Noha csapkod ostor,</l>
<l xml:id="l.59">Mint a’ tövis bokor,</l>
<l xml:id="l.60">Mutatván gyarloságod,</l>
<l rend="level_2" xml:id="l.61">Csak ismérd-meg Urad,</l>
<l xml:id="l.62">Es alázd-meg magad,</l>
<l xml:id="l.63">Jora fordul bánatod.</l>
</lg>
<lg xml:id="lg.8">
<l rend="level_2" xml:id="l.64">Várom, és ohajtom</l>
<l xml:id="l.65">S’ epedve kiáltom</l>
<l xml:id="l.66"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4">Azért Uram <corr>malasztod</corr>,</lem>
<rdg wit="#W1" xml:id="rdg.4">Sz: Lelked</rdg>
<rdg wit="#W2 #W3 #W4" xml:id="rdg.5">malastod</rdg>
</app></l>
<l rend="level_2" xml:id="l.67">Mint a’ sovány földet,</l>
<l xml:id="l.68">Engem aszszu füvet</l>
<l xml:id="l.69">Hogy éleszszen harmatod,</l>
<l rend="level_2" xml:id="l.70">Csak lelkemre tekénts,</l>
<l xml:id="l.71"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5">S’ büneimbül tisztits,</lem>
<rdg wit="#Wβ" xml:id="rdg.6">szent Isóppal meg hints</rdg>
</app></l>
<l xml:id="l.72">Bár ne adgy Uraságot.</l>
</lg>
<lg xml:id="lg.9">
<l rend="level_2" xml:id="l.73">Szánnyad ocsmány férged,</l>
<l xml:id="l.74">Az ki szivbül téged</l>
<l xml:id="l.75"><app xml:id="app.6">
<lem wit="#KK" xml:id="lem.6">Mostan kérlelni akar,</lem>
<rdg wit="#Wβ" xml:id="rdg.7">kérelni</rdg>
</app></l>
<l rend="level_2" xml:id="l.76">Látod nagy óhajtva,</l>
<l xml:id="l.77"><app xml:id="app.7">
<lem wit="#KK" xml:id="lem.7">Es szive szakadva</lem>
<rdg wit="#W2" xml:id="rdg.8">szakastva</rdg>
</app></l>
<l xml:id="l.78">Ajtodon zörget, s’ vakar,</l>
<l rend="level_2" xml:id="l.79"><app xml:id="app.8">
<lem wit="#KK" xml:id="lem.8">Rá bizott girábul<note type="critic" xml:id="note.3">A szolgákra bízott
                                    gírákról lásd Luk. 19, 13–26.</note></lem>
<rdg wit="#W2" xml:id="rdg.9">gyrágbul</rdg>
</app></l>
<l xml:id="l.80">S’ néki adott jokbul</l>
<l xml:id="l.81">Talám még hasznot takar.</l>
</lg>
</div>
</body>
</text>
