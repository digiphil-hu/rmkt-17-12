<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 153.</fw>
<lg xml:id="lg.1">
<l xml:id="l.1">Hogy sugár szarnyával sass repülne délre,</l>
<l xml:id="l.2">Éeles szemmel nézvén az tiszta nap fenyre,</l>
<l xml:id="l.3">Nagy ecclipsist vete féél hold erejére,</l>
<l xml:id="l.4">Setétség tamada Duna két felére.</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.5">Mars-is Bellonával egekbül érkezvén,</l>
<l xml:id="l.6">Földet, vizet festnek vérrel, fegyverkezvén,</l>
<l xml:id="l.7">En-is Hvszth várának kösziklás tetején</l>
<l xml:id="l.8">Jrám ez verseket, fejem szédelegvén.</l>
</lg>
</div>
</body>
</text>
