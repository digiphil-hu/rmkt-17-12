<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 72.</fw>
<head type="title">HOGY EZ VILÁG JAVÁIBAN SEMMI NINCS ÁLLANDO</head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">Szin festékkel má<corr>zolt</corr>,</lem>
<rdg wit="#W1" xml:id="rdg.1">mázlort</rdg>
<rdg wit="#W2 #W3 #W4" xml:id="rdg.2">mazolt</rdg>
</app></l>
<l xml:id="l.2">S’ tündér ülön koholt</l>
<l xml:id="l.3"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Csalárd világi hivság,</lem>
<rdg wit="#W2" xml:id="rdg.3">vilag</rdg>
</app></l>
<l rend="level_2" xml:id="l.4">Mit vélsz aranyidrol,</l>
<l xml:id="l.5"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">S’ drága <corr>köveidről?</corr></lem>
<rdg wit="#Wα" xml:id="rdg.4">gyémántidrol</rdg>
<rdg wit="#W2" xml:id="rdg.5">köveidrül</rdg>
</app></l>
<l xml:id="l.6">Itiledé boldogság?</l>
<l rend="level_2" xml:id="l.7">Im egy néhány szoval,</l>
<l xml:id="l.8">Csak kicsiny munkával</l>
<l xml:id="l.9">Bizonyitom hogy hivság.</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10">Az orák el-folynak,</l>
<l xml:id="l.11">Üdök-is el-járnak,</l>
<l xml:id="l.12">Nem mulatnak uttyokban,</l>
<l rend="level_2" xml:id="l.13">Hol hideg, s’ hol meleg,</l>
<l xml:id="l.14">Szép üdö, s’ fergeteg,</l>
<l xml:id="l.15">Jönek s’ mennek egy nyomban,</l>
<l rend="level_2" xml:id="l.16">De kis vélekedés,</l>
<l xml:id="l.17">Serény elmélkedés,</l>
<l xml:id="l.18"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4">Nem vehetni egy szoban.</lem>
<rdg wit="#W2" xml:id="rdg.6">veheti</rdg>
</app></l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19">Jó s’ gonosz szerencse,</l>
<l xml:id="l.20">Mint forgo velencze<note type="critic" xml:id="note.1">zászló, mely a szélfúvás irányát
                            jelezte</note></l>
<l xml:id="l.21">Emel s’ taszit az porban,</l>
<l rend="level_2" xml:id="l.22">Császárt-is koldussá,</l>
<l xml:id="l.23">Tész Urat kapássá,</l>
<l xml:id="l.24">Öltözteti bocskorban,</l>
<l rend="level_2" xml:id="l.25">Királyi korona,</l>
<l xml:id="l.26">Ország birodalma,</l>
<l xml:id="l.27">Száll olykor nád hajlékban.</l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.28">Angyali nagy szépség,</l>
<l xml:id="l.29">Kit egy kis betegség</l>
<l xml:id="l.30">El-hervaszt s’ porrá tészen,</l>
<l rend="level_2" xml:id="l.31">Erö s’ nagy vastagság,</l>
<l xml:id="l.32">Vitézi bátorság,</l>
<l xml:id="l.33">El-hágy, és másé lészen,</l>
<l rend="level_2" xml:id="l.34">Öröm és boszszuság,</l>
<l xml:id="l.35">Vas, s’ békó, szabadság</l>
<l xml:id="l.36">Mindenkoron vár készen.</l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.37">Nagy tölgy fák ki dülnek,</l>
<l xml:id="l.38">Tornyok repedeznek,</l>
<l xml:id="l.39">Hóld, s’ nap fénye-is el-vész,</l>
<l rend="level_2" xml:id="l.40">Márvány köben metzet</l>
<l xml:id="l.41">Irás kopik, s’ veszhet,</l>
<l xml:id="l.42">Kit faragott ember kéz,</l>
<l rend="level_2" xml:id="l.43">Erös gyémánt törik,</l>
<l xml:id="l.44"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5">Aczél, vasis vásik,</lem>
<rdg wit="#Wβ" xml:id="rdg.7">vas, réz</rdg>
</app></l>
<l xml:id="l.45">Es sokára porrá lesz.</l>
</lg>
<lg xml:id="lg.6">
<l rend="level_2" xml:id="l.46">Szép köves arany láncz,</l>
<l xml:id="l.47">Kit gyönyörködve látsz,</l>
<l xml:id="l.48">Üdöktül homált vehet,</l>
<l rend="level_2" xml:id="l.49"><app xml:id="app.6">
<lem wit="#KK" xml:id="lem.6">Drága <corr>szép</corr> öltözet,</lem>
<rdg wit="#Wα" xml:id="rdg.8">fris</rdg>
<rdg wit="#W2" xml:id="rdg.9">sép</rdg>
</app></l>
<l xml:id="l.50">Kit sok munka szerzet,</l>
<l xml:id="l.51">Moly s’ penisz miat veszhet,</l>
<l rend="level_2" xml:id="l.52">Vérrel gyüjtött sok kincs,</l>
<l xml:id="l.53">Kinek száma-is nincs,</l>
<l xml:id="l.54">Tüz, s’ lang miat szenvedhet.</l>
</lg>
<lg xml:id="lg.7">
<l rend="level_2" xml:id="l.55">Még az föld is el ag,</l>
<l xml:id="l.56">Hibáz vetemény mag,</l>
<l xml:id="l.57">Egek-is fogyatkoznak,</l>
<l rend="level_2" xml:id="l.58">Küszikla hamuvá,</l>
<l xml:id="l.59"><app xml:id="app.7">
<lem wit="#KK" xml:id="lem.7">Az hamu m<corr>e</corr>g hová</lem>
<rdg wit="#W1 #W4" xml:id="rdg.10">még</rdg>
<rdg wit="#W2 #W3" xml:id="rdg.11">meg</rdg>
</app></l>
<l xml:id="l.60">Az üdövel változnak,</l>
<l rend="level_2" xml:id="l.61">Az Tenger-is dagad,</l>
<l xml:id="l.62">Viszont megint apad,</l>
<l xml:id="l.63">Nincs határa az habnak.</l>
</lg>
<lg xml:id="lg.8">
<l rend="level_2" xml:id="l.64">Világot kerülö,</l>
<l xml:id="l.65">S’ Eg allat repülö</l>
<l xml:id="l.66">Sas melly hamar enyészik,</l>
<l rend="level_2" xml:id="l.67">Szerelmesed ki vólt,</l>
<l xml:id="l.68">Vagy utál, vagy meg-hólt,</l>
<l xml:id="l.69">Rolad el-feletkezik,</l>
<l rend="level_2" xml:id="l.70">Az pénteki öröm</l>
<l xml:id="l.71"><app xml:id="app.8">
<lem wit="#KK" xml:id="lem.8">Vasárnapi <corr>ü</corr>röm,</lem>
<rdg wit="#W1 #W2" xml:id="rdg.12">öröm</rdg>
<rdg wit="#Wβ" xml:id="rdg.13">üröm</rdg>
</app></l>
<l xml:id="l.72"><app xml:id="app.9">
<lem wit="#KK" xml:id="lem.9">Siralomra változik.</lem>
<rdg wit="#W2" xml:id="rdg.14">valtoznak</rdg>
</app></l>
</lg>
<lg xml:id="lg.9">
<l rend="level_2" xml:id="l.73">Az nagy Pyrámisok,</l>
<l xml:id="l.74">Es Labyrinthusok</l>
<l xml:id="l.75">Vóltak világ csudái,</l>
<l rend="level_2" xml:id="l.76">De hova löttek már?</l>
<l xml:id="l.77">Helyeit nézzed bár,</l>
<l xml:id="l.78">Nem látczanak falai,</l>
<l rend="level_2" xml:id="l.79">Üdö el-vesztette,</l>
<l xml:id="l.80">S’ földig porrá tette;</l>
<l xml:id="l.81">Mostan csak szó példái.</l>
</lg>
<lg xml:id="lg.10">
<l rend="level_2" xml:id="l.82"><app xml:id="app.10">
<lem wit="#KK" xml:id="lem.10">Jaj s’ miként végezzem,</lem>
<rdg wit="#Wβ" xml:id="rdg.15">végezem</rdg>
</app></l>
<l xml:id="l.83">Erre nem érkezem,</l>
<l xml:id="l.84">Mert nyelvem meg némittya!</l>
<l rend="level_2" xml:id="l.85">Kedvem háborodik,</l>
<l xml:id="l.86">S’ lelkem szomorodik,</l>
<l xml:id="l.87">S’ elmémet-is tompittya;</l>
<l rend="level_2" xml:id="l.88">Hogy minden csak el-vész,</l>
<l xml:id="l.89">Valamit a’ szem néz</l>
<l xml:id="l.90">S’ ez éltemet fogyattya.</l>
</lg>
<lg xml:id="lg.11">
<l rend="level_2" xml:id="l.91">Látom hogy változás,</l>
<l xml:id="l.92">Minden szempillantás:</l>
<l xml:id="l.93"><app xml:id="app.11">
<lem wit="#KK" xml:id="lem.11">Nem áll semmi egy nyomban,</lem>
<rdg wit="#W1" xml:id="rdg.16">nyomba</rdg>
<rdg wit="#W2 #W3 #W4" xml:id="rdg.17">nyomban</rdg>
</app></l>
<l rend="level_2" xml:id="l.94">Az mit jelenteni,</l>
<l xml:id="l.95">Akarnék mondani,</l>
<l xml:id="l.96">Keresd-fel rythmusimban,</l>
<l rend="level_2" xml:id="l.97">Hogy nincs állandoság,</l>
<l xml:id="l.98">Sokáig valóság:</l>
<l xml:id="l.99">Semmi-is ez világon.</l>
</lg>
</div>
</body>
