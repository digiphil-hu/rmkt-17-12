<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 146.</fw>
<head type="title">EGY GONDOLOM TÁNCZ ENEK EGY SZÉP ROSA VIRÁGRUL</head>
<lg xml:id="lg.1">
<l xml:id="l.1">Buidosásban lévén elmélkedésemben,</l>
<l xml:id="l.2">Midön volnék egykor belsö gyötrelemben</l>
<l rend="level_2" xml:id="l.3">Nÿlat löve kis Cupido</l>
<l rend="level_2" xml:id="l.4">Nÿlat löve kis Cupido</l>
<l rend="level_4" xml:id="l.5">Keserves szivemben.</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.6">Kiért el lankadván le kölleték feknem</l>
<l xml:id="l.7">Fárodságom miátt mély álomban esnem</l>
<l rend="level_2" xml:id="l.8">De az tüzes sebek miátt</l>
<l rend="level_2" xml:id="l.9">De az tüzes sebek miátt</l>
<l rend="level_4" xml:id="l.10">Nem nyughaték lelkem.</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.11">Mert elöttem Rosa ö magát mutattya</l>
<l xml:id="l.12">Kinek meszireölis teried szép illattya</l>
<l rend="level_2" xml:id="l.13">Mint kevánnám hogy haiolna</l>
<l rend="level_2" xml:id="l.14">Mint kevánnám hogy haiolna</l>
<l rend="level_4" xml:id="l.15">Hozzám akarattya.</l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.16">Kinek mint egy Rubint aiaka ugy fénlik</l>
<l xml:id="l.17">Vagy mint Cárbunculus szépen veresellik</l>
<l rend="level_2" xml:id="l.18">Két ragyago szemeczkéie</l>
<l rend="level_2" xml:id="l.19">Két ragyago szemeczkéie</l>
<l rend="level_4" xml:id="l.20">Mint tüz ugy villámlik.</l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.21">Feiér liliumhoz hasonlo ö torka</l>
<l xml:id="l.22">Mint fényes nap villott tündöklö homloka</l>
<l rend="level_2" xml:id="l.23">Minden kerti virágoknál</l>
<l rend="level_2" xml:id="l.24">Minden kerti virágoknál</l>
<l rend="level_4" xml:id="l.25">Ékesb ábrázattya.</l>
</lg>
<lg xml:id="lg.6">
<l xml:id="l.26">Ezért az kevánságh szivemet kergeti</l>
<l xml:id="l.27">Sok gondolatimat minden felé veti</l>
<l rend="level_2" xml:id="l.28">De fáidalmas gyötrelmemnek</l>
<l rend="level_2" xml:id="l.29">De fáidalmas gyötrelmemnek</l>
<l rend="level_4" xml:id="l.30">Végét nem érheti.</l>
</lg>
<lg xml:id="lg.7">
<l xml:id="l.31">Mert nagy sebet csinált Cupido szivemben</l>
<l xml:id="l.32">Kivel kinoztatik kegyetlenül lelkem</l>
<l rend="level_2" xml:id="l.33">Midön látom hogy szép Rosám</l>
<l rend="level_2" xml:id="l.34">Midön látom hogy szép Rosám</l>
<l rend="level_4" xml:id="l.35"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">Idegen <corr>en</corr>töllem.</lem>
<rdg wit="#W1" xml:id="rdg.1">Idegen töllem.<note type="critic" xml:id="note.1">A szótagszámhibát
                                    hozzávetőleg jav.</note></rdg>
</app></l>
</lg>
<lg xml:id="lg.8">
<l xml:id="l.36">Aly megh kis Cupido fordéczd kézÿadat</l>
<l xml:id="l.37">Ne uÿétcsad továb keserves kinomat</l>
<l rend="level_2" xml:id="l.38">Haicsad hozzám szép nÿladdal</l>
<l rend="level_2" xml:id="l.39">Haicsad hozzám szép nyladdal</l>
<l rend="level_4" xml:id="l.40">Kedves Virágodat.</l>
</lg>
<lg xml:id="lg.9">
<l xml:id="l.41">Egy magános helyben szomoru elmémben</l>
<l xml:id="l.42">Versemet igy végzém lévén reménséghben</l>
<l rend="level_2" xml:id="l.43">Hogy megh busult feiem lészen</l>
<l rend="level_2" xml:id="l.44">Hogy megh busult feiem lészen</l>
<l rend="level_4" xml:id="l.45">Szép Rosám kedvében.</l>
</lg>
</div>
