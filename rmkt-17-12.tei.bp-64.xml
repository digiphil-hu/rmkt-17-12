<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 64.</fw>
<head type="title">POENITENTIÁRA INDULT SZIVNEK KÖNYÖRGÉSE</head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1">Hatalmas Istenség,</l>
<l xml:id="l.2">S’ méltoságos Felség,</l>
<l xml:id="l.3">Ki lakol az egekben,</l>
<l rend="level_2" xml:id="l.4">Rád néz könyves szemem,</l>
<l xml:id="l.5">Szorongat inségem,</l>
<l xml:id="l.6">S’ jutottam rettegésben,</l>
<l rend="level_2" xml:id="l.7">Mert szivem el-fajult</l>
<l xml:id="l.8"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">S’ rút vétkekben <corr>merült</corr>,</lem>
<rdg wit="#Wα" xml:id="rdg.1">borult</rdg>
<rdg wit="#W2" xml:id="rdg.2">merült</rdg>
</app></l>
<l xml:id="l.9">Ne hadgy esnem kétségben.</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10">Nem tudom, mit tégyek</l>
<l xml:id="l.11"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">S’ hová bujjak mennyek,</lem>
<rdg wit="#W2" xml:id="rdg.3">buyial</rdg>
</app></l>
<l xml:id="l.12">El-ér mindenütt karod,</l>
<l rend="level_2" xml:id="l.13">Ektelen életért,</l>
<l xml:id="l.14">Sok boszszu üzésért</l>
<l xml:id="l.15">Fel-talál te haragod,</l>
<l rend="level_2" xml:id="l.16">Ha ászszu koroján</l>
<l xml:id="l.17">S’ el-hervadt virágján</l>
<l xml:id="l.18">Nem könyörül jo voltod.</l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19">Igaz hogy vétettem,</l>
<l xml:id="l.20">Sok bünt füztem s’ nyeltem,</l>
<l xml:id="l.21">Jártam ellened Uram,</l>
<l rend="level_2" xml:id="l.22">Mert gyarloságomtul,</l>
<l xml:id="l.23">Sátán hálojátul</l>
<l xml:id="l.24"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">En magamat nem ottam,</lem>
<rdg wit="#W2" xml:id="rdg.4">Magamot nem hattam</rdg>
</app></l>
<l rend="level_2" xml:id="l.25">De Istenségedet,</l>
<l xml:id="l.26">S’ Hármas személyedet</l>
<l xml:id="l.27">Ugyan szivböl imádtam.</l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.28">Az Acháb bálványát,<note type="critic" xml:id="note.1">Áchábról vö. <bibl>I.
                            (III.) Kir. 17, 30–33.</bibl></note></l>
<l xml:id="l.29">S’ Jeroboam borját<note type="critic" xml:id="note.2">Jeroboámról lásd <bibl>I. (III.) Kir. 12,
                            28.</bibl></note></l>
<l xml:id="l.30">Segitségül nem hittam,</l>
<l rend="level_2" xml:id="l.31">Fa, kü, ércz, Istennek,</l>
<l xml:id="l.32">Az Dágon ördögnek<note type="critic" xml:id="note.3">Dágon – a filiszteusok istene volt; vö.
                            <bibl>Bír. 16, 23.</bibl>; <bibl>I. Sám (I. Kir.) 5. fej.</bibl></note></l>
<l xml:id="l.33"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4">Soha én nem áldoztam,</lem>
<rdg wit="#W2" xml:id="rdg.5">Soha nemis</rdg>
</app></l>
<l rend="level_2" xml:id="l.34">Erötlenségembül,</l>
<l xml:id="l.35">Nem vakmeröségbül</l>
<l xml:id="l.36">Bün almában haraptam.</l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.37">Tiszta itéleted,</l>
<l xml:id="l.38">S’ igaz büntetésed</l>
<l xml:id="l.39">Vethet Uram pokolra,</l>
<l rend="level_2" xml:id="l.40">Atyáim rutsága,</l>
<l xml:id="l.41">S’ magam gonossága</l>
<l xml:id="l.42">Méltán ejt kárhozatra,</l>
<l rend="level_2" xml:id="l.43">De aval el nem vész</l>
<l xml:id="l.44">Irgalmad, hogy ha néz</l>
<l xml:id="l.45">Szél kergette polyvádra.</l>
</lg>
<lg xml:id="lg.6">
<l rend="level_2" xml:id="l.46">Adámot, és Evát</l>
<l xml:id="l.47">Hogy ették az almát,</l>
<l xml:id="l.48">El nem vesztéd azonnal;</l>
<l rend="level_2" xml:id="l.49">Kaint vér ontásért,</l>
<l xml:id="l.50">S’ elsö gyilkosságért</l>
<l xml:id="l.51">Meg-feddéd csak haraggal,</l>
<l rend="level_2" xml:id="l.52"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5">Saulust-is uttyában,<note type="critic" xml:id="note.4">Saul esetét lásd
                                    az <bibl>Ap. csel. 9, 1–8.</bibl></note></lem>
<rdg wit="#W2" xml:id="rdg.6">Sault is</rdg>
</app></l>
<l xml:id="l.53">S’ forro haragjában</l>
<l xml:id="l.54"><app xml:id="app.6">
<lem wit="#KK" xml:id="lem.6">Büntetéd csak vaksággal.</lem>
<rdg wit="#W2" xml:id="rdg.7">Böntettet az</rdg>
</app></l>
</lg>
<lg xml:id="lg.7">
<l rend="level_2" xml:id="l.55">Könyörüly rajtam-is,</l>
<l xml:id="l.56">Mullyon haragod-is,</l>
<l xml:id="l.57">Had dicsérjen életem,</l>
<l rend="level_2" xml:id="l.58"><app xml:id="app.7">
<lem wit="#KK" xml:id="lem.7">Ne nyujcsd-ki karodat</lem>
<rdg wit="#W2" xml:id="rdg.8">Ne niuiczd karodat</rdg>
</app></l>
<l xml:id="l.59">S’ ted-le ostorodat,</l>
<l xml:id="l.60">Ne büntessed érdemem,</l>
<l rend="level_2" xml:id="l.61">Az mig éltem csekély,</l>
<l xml:id="l.62">Ne talállyon veszély,</l>
<l xml:id="l.63">Ne kárhozzék-el lelkem.</l>
</lg>
<lg xml:id="lg.8">
<l rend="level_2" xml:id="l.64">Lám keresztfán csüggö,</l>
<l xml:id="l.65">S’ veled edgyütt függö</l>
<l xml:id="l.66">Tolvaj esék kedvedben,</l>
<l rend="level_2" xml:id="l.67">Egy fohászkodásért,</l>
<l xml:id="l.68">S’ végsö könyörgésért</l>
<l xml:id="l.69">Fogadád kegyelmedben,</l>
<l rend="level_2" xml:id="l.70">Ki tölled-is nem félt,</l>
<l xml:id="l.71">S’ világ-is meg-itélt,</l>
<l xml:id="l.72">Hozád isméretedben.<note type="critic" xml:id="note.5">64–72 A Krisztussal együtt keresztre
                            feszített jobb oldali latorról lásd <bibl>Luk. 23, 40–43.</bibl></note></l>
</lg>
<lg xml:id="lg.9">
<l rend="level_2" xml:id="l.73">Uram születésed,</l>
<l xml:id="l.74">S’ munkás epéséged<note type="critic" xml:id="note.6">keserűséged, bánatod</note></l>
<l xml:id="l.75">De vallyon s’ kinek használ?</l>
<l rend="level_2" xml:id="l.76">Véres veritéked,</l>
<l xml:id="l.77"><app xml:id="app.8">
<lem wit="#KK" xml:id="lem.8"><corr>S végre öldözésed</corr><note type="critic" xml:id="note.7">megöletésed</note></lem>
<rdg wit="#Wα" xml:id="rdg.9">S’ ennyi szenvedésed</rdg>
<rdg wit="#W2" xml:id="rdg.10">S vigre eöldezised</rdg>
</app></l>
<l xml:id="l.78">Reménséggel kit táplál?</l>
<l rend="level_2" xml:id="l.79">Poklokra szállásod,</l>
<l xml:id="l.80">Es fel-támadásod</l>
<l xml:id="l.81">Bünöst keres, és talál.</l>
</lg>
<lg xml:id="lg.10">
<l rend="level_2" xml:id="l.82">Oh áldott JESUSOM!</l>
<l xml:id="l.83">Edes áldozatom!</l>
<l xml:id="l.84">Ne hadgy bünömben vesznem,</l>
<l rend="level_2" xml:id="l.85">Hitet, szeretetet,</l>
<l xml:id="l.86">S’ erös reménséget</l>
<l xml:id="l.87">Teremcs ujjonnan bennem,</l>
<l rend="level_2" xml:id="l.88">Sok kénszenvedésed,</l>
<l xml:id="l.89">S’ Atyádnál érdemed</l>
<l xml:id="l.90">Használlyon kérlek nékem.</l>
</lg>
</div>
</body>
</text>
