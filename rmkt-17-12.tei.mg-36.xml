<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 36.</fw>
<head type="title">AZ IO ASZONI ALATROL</head>
<lg xml:id="lg.1">
<l xml:id="l.1">Aszoni embernek Semermeteseghe</l>
<l xml:id="l.2">Jó erkölcz az az eȯ Seepseghe</l>
<l xml:id="l.3">Vrahoz walo engedelmeseghe.</l>
<l xml:id="l.4">Fegihetetlėn<note type="critic" xml:id="note.1"> = feddhetetlen</note> az eö Jambor elete</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.5">Aszoni alat magȧt kedwese tessi</l>
<l xml:id="l.6"><app xml:id="app.1"><lem wit="#KK" xml:id="lem.1">Seretetel magahoz seligiti</lem><rdg wit="#W1" xml:id="rdg.1">Seretetel <del>Vrat</del></rdg></app></l>
<l xml:id="l.7">Engedelmesegel hoza edesiti</l>
<l xml:id="l.8">Beocztelensegtȯl ö vrat félti</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.9"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Él. vrawal sepėn nagi boldogul</lem>
<rdg wit="#W1" xml:id="rdg.2">Él <del>ferfiual</del>
<add place="above" type="insert">vrawal</add></rdg>
</app></l>
<l xml:id="l.10">Eletit v́iseli Tistan es Sentűl</l>
<l xml:id="l.11">Minden kor hazban cheled kozöt v̋ l</l>
<l xml:id="l.12"><app xml:id="app.3"><lem wit="#KK" xml:id="lem.3">Rokaián vluén kezzbėn orsoia perdűl<note type="critic" xml:id="note.2">11–12 Vö. a parázna életről szóló elmélkedés utolsó versbetétjével (Vlliȯn otthon az Rokanal … Kezebėn orszoia
                        perdulion).</note></lem><rdg wit="#W1" xml:id="rdg.3">kez<del rend="overwritten">e</del><add type="overwrite">z</add>bėn</rdg></app></l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.13">Vra agiát sepen fel ekesiti</l>
<l xml:id="l.14">Jamborsagnak selimewel sépiti</l>
<l xml:id="l.15">Sentsegnek barsoniaval őltozteti</l>
<l xml:id="l.16">Semermetesegnek paplonaval fedezi</l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.17">Ȧz ollian aszoni az eő vrát</l>
<l xml:id="l.18">Giőniorw̋ segel hozabitia oraiát</l>
<l xml:id="l.19">Tauoztatia töle minden ö buiát</l>
<l xml:id="l.20"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4">Feleiteti vele merges haragiát</lem>
<rdg wit="#W1" xml:id="rdg.4"><del>V</del>merges</rdg>
</app></l>
</lg>
<lg xml:id="lg.6">
<l xml:id="l.21">Mint az olai faknak teriet agai</l>
<l xml:id="l.22">Giermekit Jsteni felelemben neveli</l>
<l xml:id="l.23">Oktatia S. Tanitia oket ekesgeti</l>
<l xml:id="l.24">Jo erkolczre Soktatwȧn Seliditi</l>
</lg>
</div>
</body>
</text>
