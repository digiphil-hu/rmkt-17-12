<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 84.</fw>
<head type="title"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">AZ ESZTENDÖNEK NÉGY RÉSZEINEK MIVOLTÁRUL</lem>
<rdg wit="#Wβ" xml:id="rdg.1">AZ ESZTENDÖ NÉGY RÉSZINEK</rdg>
</app></head>
<lg xml:id="lg.1">
<l rend="level_2" xml:id="l.1">Most már minden ujjul,</l>
<l xml:id="l.2">Vigad, örül, s’ vidul,</l>
<l xml:id="l.3"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Hogy tavaszi üdö ér,</lem>
<rdg wit="#W3" xml:id="rdg.2">üdöt</rdg>
</app></l>
<l rend="level_2" xml:id="l.4"><app xml:id="app.3">
<lem wit="#KK" xml:id="lem.3">El-ment <corr>hó, víz, mocsok,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.3">El-ment az hó, dér s tél,</rdg>
<rdg wit="#W2" xml:id="rdg.4">El ment ho viz mocszok,</rdg>
</app></l>
<l xml:id="l.5"><app xml:id="app.4">
<lem wit="#KK" xml:id="lem.4"><corr>S fülemile csacsog,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.5">Zöld pásit vetés kél,</rdg>
<rdg wit="#W2" xml:id="rdg.6">S fulemile csacsog,</rdg>
</app></l>
<l xml:id="l.6"><app xml:id="app.5">
<lem wit="#KK" xml:id="lem.5"><corr>Echót pökdös denevér,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.7">Vig minden halom, hegy, s’ tér,</rdg>
<rdg wit="#W2" xml:id="rdg.8">Ecchot pokdos denevér</rdg>
</app></l>
<l rend="level_2" xml:id="l.7">Az kert virágokkal,</l>
<l xml:id="l.8">S’ mezö harmatokkal</l>
<l xml:id="l.9">Minden bánatot el-vér.</l>
</lg>
<lg xml:id="lg.2">
<l rend="level_2" xml:id="l.10">Nyár párló idökkel,</l>
<l xml:id="l.11">S’ csattogó esökkel</l>
<l xml:id="l.12">Gyakran kedvet változtat;</l>
<l rend="level_2" xml:id="l.13">Bolha s’ légy csipéssel,</l>
<l xml:id="l.14"><app xml:id="app.6">
<lem wit="#KK" xml:id="lem.6">Szunyog <corr>bömböléssel</corr><note type="critic" xml:id="note.1">A
                                    szúnyoghoz túlságosan erős a bömbölés szó.</note></lem>
<rdg wit="#Wα" xml:id="rdg.9">or zengéssel</rdg>
<rdg wit="#W2" xml:id="rdg.10">bümbeléssel</rdg>
</app></l>
<l xml:id="l.15">Nyugodalmat nem adhat,</l>
<l rend="level_2" xml:id="l.16">Epesztö aratás,</l>
<l xml:id="l.17">Izzaszto kaszállás</l>
<l xml:id="l.18">Csak árnyékot kivántat.</l>
</lg>
<lg xml:id="lg.3">
<l rend="level_2" xml:id="l.19">Ösz szölö gerezdel,</l>
<l xml:id="l.20">Szép sürü kepékkel<note type="critic" xml:id="note.2">búzakeresztekkel, csomókkal</note></l>
<l xml:id="l.21">Az embert vidámittya,</l>
<l rend="level_2" xml:id="l.22">Kövér vad, s’ madárral,</l>
<l xml:id="l.23">Meg-tölt pincze borral</l>
<l xml:id="l.24"><app xml:id="app.7">
<lem wit="#KK" xml:id="lem.7"><corr>Lelket, szivet hizlalja,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.11">Lankadt eröt ujjittya</rdg>
<rdg wit="#W2" xml:id="rdg.12">Lölket szévet hizlallja</rdg>
</app></l>
<l rend="level_2" xml:id="l.25">Fáratsága hasznát</l>
<l xml:id="l.26">Most veszi s’ jutalmát,</l>
<l xml:id="l.27">Midön asztagit láttya.</l>
</lg>
<lg xml:id="lg.4">
<l rend="level_2" xml:id="l.28">Tél embert szomorit,</l>
<l xml:id="l.29">Gyakran tüzhöz szorit,</l>
<l xml:id="l.30"><app xml:id="app.8">
<lem wit="#KK" xml:id="lem.8"><corr>S fáztaltatja az testét,</corr></lem>
<rdg wit="#Wα" xml:id="rdg.13">Hogy melegittse testét</rdg>
<rdg wit="#W2" xml:id="rdg.14">S fastaltattya az testet</rdg>
</app></l>
<l rend="level_2" xml:id="l.31">Sürün nyomja ágyát,</l>
<l xml:id="l.32">S’ hüvelyezi álmát,<note type="critic" xml:id="note.3">A sor értelme: álmát fejti,
                            magyarázza.</note></l>
<l xml:id="l.33">Hánnya s’ veti elméjét,</l>
<l rend="level_2" xml:id="l.34">Ha mit gyüjtött nyárba,</l>
<l xml:id="l.35">Most aprittya tálba,</l>
<l xml:id="l.36">Hogy tengesse életét.</l>
</lg>
<lg xml:id="lg.5">
<l rend="level_2" xml:id="l.37">Négy fertály esztendö,</l>
<l xml:id="l.38"><app xml:id="app.9">
<lem wit="#KK" xml:id="lem.9">Jó, és gonosz üdö</lem>
<rdg wit="#W1" xml:id="rdg.15">s’</rdg>
<rdg wit="#W2 #W3 #W4" xml:id="rdg.16">és</rdg>
</app></l>
<l xml:id="l.39">Mutattya voltaképpen;</l>
<l rend="level_2" xml:id="l.40">Miképpen kell élned,</l>
<l xml:id="l.41">Es mikor mit tenned,</l>
<l xml:id="l.42">Elödben adgya szépen:</l>
<l rend="level_2" xml:id="l.43">Kopaszt borotválni,</l>
<l xml:id="l.44">S’ haját el-tarolni,<note type="critic" xml:id="note.4">lenyírni</note></l>
<l xml:id="l.45">Allyon üstöke éppenn.</l>
</lg>
</div>
</body>
