<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 2.</fw>
<head type="title">JGHEN SZÉP ENEKEK CHÉ NIELWBOL MAGIARRA FORDITOT</head>
<head type="subtitle">ELSŐ ÉNEK</head>
<head type="notation">Ad Notam Bud Boze muog sam Saudcze etc</head>
<lg xml:id="lg.1">
<l xml:id="l.1"><hi rend="bold">A</hi>z isten magosaghbool</l>
<l xml:id="l.2">Neez reank diczőségbeől</l>
<l xml:id="l.3">Fordicza el haragiaat</l>
<l xml:id="l.4">Mi feslet bw̋neinkteől</l>
<l xml:id="l.5">Haicz fwleidet</l>
<l xml:id="l.6">Eebrėzd lelkemet</l>
<l xml:id="l.7">Dichirhessėm Tegedet.</l>
<l xml:id="l.8">Jezu̇s Christus mi kegyelmes Vrunk</l>
<l xml:id="l.9">Ėsedezél értűnk.</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.10"><hi rend="bold">N</hi>e hagẏ hogi teőb bünt tegiünk.</l>
<l xml:id="l.11">Mẏgh ez Vilȧgon eelűnk</l>
<l xml:id="l.12">Agi mi nekunk mit kerűnk</l>
<l xml:id="l.13">Mert te wagi az mi Vrunk</l>
<l xml:id="l.14">Jóo remenszeget.</l>
<l xml:id="l.15">Tista Vӳ sziwet.</l>
<l xml:id="l.16">Jgaz S.wasztag ió hitet<note type="critic" xml:id="note.1">Vö. a <ref target="rmkt-17-12.tei.mg-7">7. sz. vers</ref> 9.
                                sorával (Vasztag hittel).</note></l>
<l xml:id="l.17">Jgazgazd S wezerellied eltemet</l>
<l xml:id="l.18">Vekoni elmemet,</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.19"><hi rend="bold">N</hi>eweld raitam aldasod</l>
<l xml:id="l.20">Fordiczd ream orczadot</l>
<l xml:id="l.21">S.Vigaztȧld szolgálódot</l>
<l xml:id="l.22">Maradgion aldomasod</l>
<l xml:id="l.23">Hogi Jstenemet</l>
<l xml:id="l.24">Vrr feőlsegedet</l>
<l xml:id="l.25">Dichiriem Vegik teged<note type="critic" xml:id="note.2">Vö. az <ref target="rmkt-17-12.tei.mg-1">1. sz. ének</ref> 28.
                                sorával (Teged dicziriem mind vegik).</note></l>
<l xml:id="l.26">Mert te wagi nekem feȯ Vigaztalom</l>
<l xml:id="l.27">Kegies Taplaloom:</l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.28"><hi rend="bold">A</hi>z te hatalmasagod</l>
<l xml:id="l.29">Niuiczd hozam te Szent karod</l>
<l xml:id="l.30">Hogi hozad ragaskodgiam</l>
<l xml:id="l.31">Keserwemben folliamiam.</l>
<l xml:id="l.32">Ments szolgalodot</l>
<l xml:id="l.33">Arwa voltomot</l>
<l xml:id="l.34">Busult Allapatomot</l>
<l xml:id="l.35"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1">Vram én Istenem ki wagi Menieghbėn</lem>
<rdg wit="#W1" xml:id="rdg.1">Vram én Istenem ki wagi<note type="critic" xml:id="note.3"><hi rend="italic">Menieghbėn</hi> a kéziratban a következő sorba
                                    került.</note></rdg>
</app></l>
<l xml:id="l.36"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Vegi kegielmedben,</lem>
<rdg wit="#W1" xml:id="rdg.2">Menieghbėn Vegi kegielmedben,</rdg>
</app></l>
</lg>
<lg xml:id="lg.5">
<l xml:id="l.37"><hi rend="bold">C</hi>zintalansagnak féske</l>
<l xml:id="l.38">Eördőgnek az eö keble</l>
<l xml:id="l.39">Vilagnak keweliseghe</l>
<l xml:id="l.40">Raitam ne legien hellie</l>
<l xml:id="l.41">Nem Reteghettek</l>
<l xml:id="l.42">Mẏg alok S-éllek</l>
<l xml:id="l.43">Hatalmoktol nem félek</l>
<l xml:id="l.44">Istenemnek hatalmaban en bizom</l>
<l xml:id="l.45">Less meg maradassom.</l>
</lg>
<lg xml:id="lg.6">
<l xml:id="l.46"><hi rend="bold">O</hi> vram S.ėn Wezerem</l>
<l xml:id="l.47">Ohait tegedet Lelkem.</l>
<l xml:id="l.48">Szwntelėn fohaskodik</l>
<l xml:id="l.49">S-Te hȯzad ragaskodik.</l>
<l xml:id="l.50">Eelezd lelkemet</l>
<l xml:id="l.51">Megh hw̋lt sziwemet</l>
<l xml:id="l.52">Eerczem te szent igedet</l>
<l xml:id="l.53">Hogi szent newedet en Tistelliem</l>
<l xml:id="l.54">Es diczirhessem,</l>
</lg>
<lg xml:id="lg.7">
<l xml:id="l.55"><hi rend="bold">B</hi>oczasd meg bwneimet</l>
<l xml:id="l.56">Vndok rut weetkeimet</l>
<l xml:id="l.57">Kit naponkint vetkeztem</l>
<l xml:id="l.58">Semeid előtt eelwėėn.</l>
<l xml:id="l.59">Alazatossan</l>
<l xml:id="l.60">Buzgosagossan</l>
<l xml:id="l.61">Köniőrgök terdem haitwan</l>
<l xml:id="l.62">Tegedet én istenemet Jmadom</l>
<l xml:id="l.63">Ki wagi vduoziteom</l>
</lg>
<lg xml:id="lg.8">
<l xml:id="l.64"><hi rend="bold">O</hi> Eördőg S.Te weėn kigio</l>
<l xml:id="l.65">Karhozatrȧ vetendeö</l>
<l xml:id="l.66">Kẏ eleinket chaltál</l>
<l xml:id="l.67">S.Hamis practikaiddal</l>
<l xml:id="l.68">Tolėd nem félwéén</l>
<l xml:id="l.69">Mert hiwán melleem</l>
<l xml:id="l.70">Kerest fȧn fwggöt ertem</l>
<l xml:id="l.71">Iezus Christu̇s ki tegedet meg rontod<note type="critic" xml:id="note.4">olv.
                        rontott</note></l>
<l xml:id="l.72">S.Menibeȯl Tasitod<note type="critic" xml:id="note.5">olv. taszított</note></l>
</lg>
<lg xml:id="lg.9">
<l xml:id="l.73"><hi rend="bold">R</hi>emeniszegemet vettem</l>
<l xml:id="l.74">Te benned een İstenem</l>
<l xml:id="l.75">Mig it romlot v̈ilagon</l>
<l xml:id="l.76">Arniekaban elhetweén</l>
<l xml:id="l.77">Hogi chendesseghben.</l>
<l xml:id="l.78">Tista elettben</l>
<l xml:id="l.79">Mehessek te elődben</l>
<l xml:id="l.80">Adgi igaz hitet kerest viselésben</l>
<l xml:id="l.81">Hozad menesbėn.</l>
</lg>
</div>
</body>
