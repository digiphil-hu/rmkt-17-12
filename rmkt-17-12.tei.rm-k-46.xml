<text>
<body>
<div type="poem" xml:id="d.1" xml:lang="hu">
<fw type="originalNum">[RMKT XVII/12:] 46.</fw>
<lg xml:id="lg.1">
<l xml:id="l.1"><app xml:id="app.1">
<lem wit="#KK" xml:id="lem.1"><corr>Birja bár akárki nagy jószágú Lévát</corr>,</lem>
<rdg wit="#W1" xml:id="rdg.1">
<gap extent="1" reason="damaged" unit="line"/>
<note type="critic" xml:id="note.1"><persName>Radvánszky<idno type="ITIdata">Q149913</idno></persName> közlése alapján adjuk, mivel
                                    kötéskor ezt a sort levágták.</note>
</rdg>
</app></l>
<l xml:id="l.2">Bechw̋ liek Szok pinzre erdelibenis Dewáát,</l>
<l xml:id="l.3">Tsak en olelhessem kariaimmal Ewáát,</l>
<l xml:id="l.4">Kit lelkem S keet szemem nagi kincze giȧnant láát.</l>
</lg>
<lg xml:id="lg.2">
<l xml:id="l.5">Az eö feiér mellie merö alabasztrom,</l>
<l xml:id="l.6">Szerelme elmemben olẏ forgo, mind malom,</l>
<l xml:id="l.7">Eőrleszenek kiniat mert elmemben Vallom,</l>
<l xml:id="l.8">Meltaán azert neki magamot aianlom.</l>
</lg>
<lg xml:id="lg.3">
<l xml:id="l.9"><app xml:id="app.2">
<lem wit="#KK" xml:id="lem.2">Ellien, de ne vgi, hogi <corr>chiak</corr> verjen S
                                kinozon,</lem>
<rdg wit="#W1" xml:id="rdg.2"><add type="i">ne</add> vgi hogi <del>chiak</del> verjen
                                    <add type="i">S</add></rdg>
</app></l>
<l xml:id="l.10">De hogi szok kinomnak köniebszeget hozzon,</l>
<l xml:id="l.11">Kőtőzőt voltombul máár kẏs<note type="critic" xml:id="note.2">olv. ki is</note> oldozon,</l>
<l xml:id="l.12">Es Szerelme vthán<note type="critic" xml:id="note.3">szerelme útján</note> Tagannis hordozzon.</l>
</lg>
<lg xml:id="lg.4">
<l xml:id="l.13">Adgion Szabadszagot, hogi één Szerethessem,</l>
<l xml:id="l.14">Es szolgalatommal keduit neuelhessem,</l>
<l xml:id="l.15">Engedgie, szep niakat hogi en Eolelhessem,</l>
<l xml:id="l.16">S. Nieltem merge vthȧn mezitis nielhessem.</l>
</lg>
</div>
</body>
